# Copiar como .env para compilar en local.
# URL del WordPress + WooCommerce, sin barra final. Vacía = la tienda muestra cómo configurarla.
PUBLIC_TIENDA_URL=https://tienda.midominio.com
# URL pública del frontend (para enlaces absolutos y SEO).
SITE_URL=https://midominio.com
# Formulario de /contacto: URL que recibe el mensaje por POST con JSON (p. ej. https://formspree.io/f/xxxxxx).
# Vacía = el formulario no envía nada y le pide al cliente escribir por Instagram.
PUBLIC_FORMULARIO_CONTACTO=
