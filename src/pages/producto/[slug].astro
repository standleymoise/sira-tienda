---
// Ficha de producto SIRA: /producto/<slug>/ (el mismo slug que en WooCommerce).
// Figma «Product Details» (147:5594), fondo blanco: galería (foto principal 558×509 + miniaturas
// de 87 px), nombre, precio, descripción, selector de variación, «Agregar al carrito» dorado,
// «Detalles del producto» y «También te puede gustar» con tarjetas reales.
// Es la página que Google indexa: título, descripción, foto, precio y datos estructurados
// (Product + Offer + BreadcrumbList) quedan en el HTML desde la compilación; precio y stock se
// vuelven a leer en vivo al abrirla (también los de cada variación).
// Del Figma se omitió lo que no es real: «3 usuarios lo tienen en el carrito», la franja de
// puntos de lealtad y el ícono de tarjeta.
import { Image } from 'astro:assets';
import PaginaSira from '../../layouts/PaginaSira.astro';
import TarjetaProducto from '../../components/sira/TarjetaProducto.astro';
import { getProductos, storeApiUrl, enIdioma, type Producto } from '../../data/tienda';
import { rutasPara } from '../../data/rutas';
import { locale, type Idioma } from '../../i18n/idiomas';
import { tienda } from '../../../tienda.config';

export async function getStaticPaths() {
  const todos = await getProductos();
  return todos.map((p) => ({ params: { slug: p.slug }, props: { p, todos } }));
}

const { p: original, todos, lang = 'es' } = Astro.props as { p: Producto; todos: Producto[]; lang?: Idioma };
// Nombre y descripción en el idioma de la página (inglés desde los campos ACF si existen).
const p = enIdioma(original, lang);
const rutas = rutasPara(lang);

// Nombres de atributos de WooCommerce (vienen en español) con equivalente en inglés; los demás
// quedan igual hasta que exista la traducción de productos.
const ATRIBUTOS_EN: Record<string, string> = { talla: 'Size', tamano: 'Size', tamaño: 'Size', medida: 'Size', color: 'Color' };
// Texto de stock de WooCommerce («3 disponibles», «Agotado»…) dicho en inglés.
const stockEn = (hay: boolean, texto = '') => {
  const n = texto.match(/\d+/)?.[0];
  if (n) return `${n} in stock`;
  if (/reserva/i.test(texto)) return 'Available on backorder';
  return hay ? 'In stock' : 'Sold out';
};
const t = {
  es: {
    inicio: 'Inicio',
    tienda: 'Tienda',
    fotos: 'Fotos del producto',
    verFoto: (i: number, n: number) => `Ver foto ${i} de ${n}`,
    precio: 'Precio:',
    stock: p.stockTexto,
    agregar: 'Agregar al carrito',
    agotado: 'Agotado',
    detalles: 'Detalles del producto',
    tipo: 'Tipo',
    reversible: 'Prenda reversible',
    codigo: 'Código',
    relacionados: 'También te puede gustar',
  },
  en: {
    inicio: 'Home',
    tienda: 'Shop',
    fotos: 'Product photos',
    verFoto: (i: number, n: number) => `View photo ${i} of ${n}`,
    precio: 'Price:',
    stock: stockEn(p.enStock, p.stockTexto),
    agregar: 'Add to cart',
    agotado: 'Sold out',
    detalles: 'Product details',
    tipo: 'Type',
    reversible: 'Reversible garment',
    codigo: 'SKU',
    relacionados: 'You may also like',
  },
}[lang];
// Textos del script del navegador ({x} = nombre de la opción que falta elegir).
const tScript = {
  es: {
    lang,
    disponible: 'Disponible',
    agotado: 'Agotado',
    agregar: 'Agregar al carrito',
    sinCombinacion: 'Esta combinación no está disponible',
    sufijoAgotado: '(agotado)',
    elija: 'Elija {x} antes de agregar.',
    agregando: 'Agregando…',
    agregado: 'Agregado al carrito. ',
    verCarrito: 'Ver carrito →',
    noSePudo: 'No se pudo agregar: ',
  },
  en: {
    lang,
    disponible: 'In stock',
    agotado: 'Sold out',
    agregar: 'Add to cart',
    sinCombinacion: 'This combination is unavailable',
    sufijoAgotado: '(sold out)',
    elija: 'Please select {x} first.',
    agregando: 'Adding…',
    agregado: 'Added to cart. ',
    verCarrito: 'View cart →',
    noSePudo: 'Could not add to cart: ',
  },
}[lang];
const sitio = Astro.site ?? Astro.url;
const abs = (ruta: string) => new URL(ruta, sitio).href;
const paginaUrl = abs(rutas.producto(p.slug));

// Descripción para Google: el resumen, o el inicio de la descripción (≈155 caracteres).
const textoBase = p.resumen || p.descripcion.join(' ') || tienda.marca.descripcion;
const descripcion = textoBase.length > 155 ? `${textoBase.slice(0, 152).replace(/\s+\S*$/, '')}…` : textoBase;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemPage',
    url: paginaUrl,
    name: `${p.nombre} | ${tienda.marca.nombre}`,
    inLanguage: locale[lang],
    mainEntity: { '@id': `${paginaUrl}#producto` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${paginaUrl}#producto`,
    name: p.nombre,
    description: textoBase,
    sku: p.sku || undefined,
    image: p.imagenes.map((i) => i.src),
    url: paginaUrl,
    brand: { '@type': 'Brand', name: tienda.marca.nombre },
    category: p.categorias[0],
    offers: {
      '@type': 'Offer',
      url: paginaUrl,
      price: p.precioNumero,
      priceCurrency: p.moneda,
      availability: p.enStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      itemCondition: 'https://schema.org/NewCondition',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.inicio, item: abs(rutas.inicio) },
      { '@type': 'ListItem', position: 2, name: t.tienda, item: abs(rutas.productos) },
      { '@type': 'ListItem', position: 3, name: p.nombre, item: paginaUrl },
    ],
  },
];

const imagenes = p.imagenes;
const principal = imagenes[0];
// Texto junto al precio: el resumen; si no hay, el primer párrafo de la descripción.
const intro = p.resumen || p.descripcion[0] || '';
// «Detalles del producto»: la descripción larga (sin repetir el párrafo de arriba) y los atributos.
const detalles = p.descripcion.filter((d) => d !== intro);
const variable = p.tipo === 'variable' && p.opciones.length > 0 && p.variaciones.length > 0;
const bonito = (s: string) =>
  (lang === 'en' && ATRIBUTOS_EN[s.toLowerCase()]) || s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();
const tamFoto = '(max-width: 860px) calc(100vw - 40px), (max-width: 1200px) 46vw, 558px';

// «También te puede gustar»: otros productos con foto, primero los que comparten categoría.
const comunes = (o: Producto) => o.categoriasSlug.filter((c) => p.categoriasSlug.includes(c)).length;
const relacionados = todos
  .filter((o) => o.id !== p.id && o.imagenes.length > 0)
  .sort((a, b) => comunes(b) - comunes(a))
  .slice(0, 4);
---
<PaginaSira
  lang={lang}
  title={`${p.nombre} | ${tienda.marca.nombre}`}
  description={descripcion}
  imagen={principal?.src}
  tipo="product"
  jsonLd={jsonLd}
  activo="tienda"
  fondo="blanco"
>
  <div
    class="ficha"
    data-ficha
    data-api={storeApiUrl}
    data-id={p.id}
    data-carrito={rutas.carrito}
    data-textos={JSON.stringify(tScript)}
    data-originales={JSON.stringify(imagenes.map((i) => i.src))}
    data-variaciones={variable ? JSON.stringify(p.variaciones) : undefined}
  >
    <div class="cuerpo">
      <div class="galeria">
        <div class="foto-principal">
          {principal ? (
            <Image
              data-foto-principal
              src={principal.src}
              alt={principal.alt}
              inferSize
              format="webp"
              widths={[558, 800, 1116]}
              sizes={tamFoto}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <span class="sin-foto serif">{p.nombre}</span>
          )}
        </div>
        {imagenes.length > 1 && (
          <div class="miniaturas" role="group" aria-label={t.fotos}>
            {imagenes.map((img, i) => (
              <button
                type="button"
                class:list={['miniatura', { activa: i === 0 }]}
                data-miniatura={i}
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-label={t.verFoto(i + 1, imagenes.length)}
              >
                <Image src={img.src} alt="" inferSize format="webp" widths={[87, 174]} sizes="87px" loading="lazy" />
              </button>
            ))}
          </div>
        )}
        {imagenes.length > 1 && (
          <template data-fotos>
            {imagenes.map((img) => (
              <Image src={img.src} alt={img.alt} inferSize format="webp" widths={[558, 800, 1116]} sizes={tamFoto} />
            ))}
          </template>
        )}
      </div>

      <div class="datos">
        <h1 class="nombre serif">{p.nombre}</h1>
        <p class="precio">
          <span class="precio-etiqueta">{t.precio}</span>
          <span class="precio-valor" data-precio>{p.precio}</span>
          {p.precioAntes && <s class="antes" data-antes>{p.precioAntes}</s>}
        </p>
        <p class:list={['stock', { agotado: !p.enStock }]} data-stock>{t.stock}</p>
        {intro && <p class="intro">{intro}</p>}

        {variable && (
          <div class="opciones">
            {p.opciones.map((o) => (
              <fieldset class="opcion" data-opcion={o.nombre} data-etiqueta={bonito(o.nombre)}>
                <legend>
                  {bonito(o.nombre)}<span class="elegido" data-elegido></span>
                </legend>
                <div class="pildoras">
                  {o.valores.map((v) => (
                    <label class="pildora" data-valor={v.slug}>
                      <input type="radio" name={`opcion-${o.nombre}`} value={v.slug} />
                      <span>{v.nombre}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
          </div>
        )}

        <button class="agregar" type="button" data-agregar disabled={!p.enStock}>
          {p.enStock ? t.agregar : t.agotado}
        </button>
        <p class="aviso" data-aviso role="status" aria-live="polite"></p>
      </div>
    </div>

    {(detalles.length > 0 || intro || p.opciones.length > 0) && (
      <section class="detalles" aria-labelledby="titulo-detalles">
        <h2 id="titulo-detalles" class="serif">{t.detalles}</h2>
        {detalles.length > 0 ? detalles.map((d) => <p>{d}</p>) : intro && <p>{intro}</p>}
        {(p.opciones.length > 0 || p.reversible || p.sku) && (
          <dl class="atributos">
            {p.opciones.map((o) => (
              <div>
                <dt>{bonito(o.nombre)}</dt>
                <dd>{o.valores.map((v) => v.nombre).join(' · ')}</dd>
              </div>
            ))}
            {p.reversible && (
              <div>
                <dt>{t.tipo}</dt>
                <dd>{t.reversible}</dd>
              </div>
            )}
            {p.sku && (
              <div>
                <dt>{t.codigo}</dt>
                <dd>{p.sku}</dd>
              </div>
            )}
          </dl>
        )}
      </section>
    )}

    {relacionados.length > 0 && (
      <section class="relacionados" aria-labelledby="titulo-relacionados">
        <h2 id="titulo-relacionados" class="serif">{t.relacionados}</h2>
        <div class="rejilla">
          {relacionados.map((r) => <TarjetaProducto producto={r} variante="lista" lang={lang} />)}
        </div>
      </section>
    )}
  </div>
</PaginaSira>

<script>
  import { crearCliente, formato, type Carrito, type ProductoApi } from '../../scripts/tienda-api';

  type ApiPrecio = ProductoApi & {
    prices: ProductoApi['prices'] & {
      regular_price: string;
      price_range?: { min_amount: string; max_amount: string } | null;
    };
  };
  type Variacion = { id: number; atributos: Record<string, string> };

  const ficha = document.querySelector<HTMLElement>('[data-ficha]');
  if (ficha) iniciar(ficha);

  function iniciar(ficha: HTMLElement) {
    const API = ficha.dataset.api!;
    const id = Number(ficha.dataset.id);
    const cliente = crearCliente(API);
    const boton = ficha.querySelector<HTMLButtonElement>('[data-agregar]')!;
    const aviso = ficha.querySelector<HTMLElement>('[data-aviso]')!;
    const precio = ficha.querySelector<HTMLElement>('[data-precio]')!;
    const antes = ficha.querySelector<HTMLElement>('[data-antes]');
    const stock = ficha.querySelector<HTMLElement>('[data-stock]')!;
    const variaciones: Variacion[] = JSON.parse(ficha.dataset.variaciones || '[]');
    const originales: string[] = JSON.parse(ficha.dataset.originales || '[]');
    const variable = variaciones.length > 0;
    const opciones = [...ficha.querySelectorAll<HTMLFieldSetElement>('[data-opcion]')];
    const T: Record<string, string> = JSON.parse(ficha.dataset.textos || '{}');
    // El texto de stock de WooCommerce viene en español: en inglés se escribe el propio.
    const textoStock = (hay: boolean, texto?: string) => {
      if (T.lang !== 'en') return texto || (hay ? T.disponible : T.agotado);
      const n = texto?.match(/\d+/)?.[0];
      if (n) return `${n} in stock`;
      if (texto && /reserva/i.test(texto)) return 'Available on backorder';
      return hay ? T.disponible : T.agotado;
    };

    // ---------- galería: la miniatura cambia la foto principal ----------
    const foto = ficha.querySelector<HTMLImageElement>('[data-foto-principal]');
    const fotos = [...(ficha.querySelector<HTMLTemplateElement>('[data-fotos]')?.content.querySelectorAll('img') ?? [])];
    const miniaturas = [...ficha.querySelectorAll<HTMLButtonElement>('[data-miniatura]')];
    function verFoto(i: number) {
      const f = fotos[i];
      if (!foto || !f) return;
      foto.srcset = f.srcset;
      foto.src = f.src;
      foto.alt = f.alt;
      miniaturas.forEach((m, j) => {
        m.classList.toggle('activa', j === i);
        m.setAttribute('aria-pressed', String(j === i));
      });
    }
    miniaturas.forEach((m, i) => m.addEventListener('click', () => verFoto(i)));

    // ---------- precio y stock en vivo ----------
    let hayStock = !boton.disabled;
    function pintar(p: ApiPrecio, conRango: boolean) {
      const pr = p.prices;
      const r = pr.price_range;
      const rango = conRango && !!r && r.min_amount !== r.max_amount;
      precio.textContent = rango ? `${formato(r!.min_amount, pr)} – ${formato(r!.max_amount, pr)}` : formato(pr.price, pr);
      if (antes) {
        antes.hidden = rango || !(Number(pr.regular_price) > Number(pr.price));
        if (!antes.hidden) antes.textContent = formato(pr.regular_price, pr);
      }
      ponerStock(p.is_purchasable && p.is_in_stock, p.stock_availability?.text);
    }
    function ponerStock(hay: boolean, texto?: string) {
      hayStock = hay;
      stock.textContent = textoStock(hay, texto);
      stock.classList.toggle('agotado', !hay);
      boton.disabled = !hay;
      boton.textContent = hay ? T.agregar : T.agotado;
    }
    let base: ApiPrecio | null = null;
    cliente
      .api<ApiPrecio>(`/products/${id}`)
      .then((p) => {
        base = p;
        if (!elegida()) pintar(p, true);
      })
      .catch(() => {});

    // ---------- variaciones ----------
    // Se leen todas en vivo (son pocas) para tachar las opciones agotadas.
    const vivas = new Map<number, ApiPrecio>();
    const cargaVariaciones = variable
      ? Promise.all(
          variaciones.map((v) =>
            cliente
              .api<ApiPrecio>(`/products/${v.id}`)
              .then((d) => void vivas.set(v.id, d))
              .catch(() => {}),
          ),
        ).then(marcarAgotadas)
      : Promise.resolve();

    const seleccion = () =>
      Object.fromEntries(
        opciones.map((f) => [f.dataset.opcion!, f.querySelector<HTMLInputElement>('input:checked')?.value ?? '']),
      ) as Record<string, string>;
    // Un valor vacío en la variación significa «cualquiera» (así lo guarda WooCommerce).
    const coincide = (v: Variacion, sel: Record<string, string>) =>
      Object.entries(sel).every(([k, val]) => !v.atributos[k] || v.atributos[k] === val);
    function elegida() {
      if (!variable) return null;
      const sel = seleccion();
      if (Object.values(sel).some((v) => !v)) return null;
      return variaciones.find((v) => coincide(v, sel)) ?? null;
    }

    function marcarAgotadas() {
      for (const f of opciones) {
        const nombre = f.dataset.opcion!;
        for (const l of f.querySelectorAll<HTMLElement>('[data-valor]')) {
          const posibles = variaciones.filter((v) => !v.atributos[nombre] || v.atributos[nombre] === l.dataset.valor);
          const agotada =
            posibles.length === 0 ||
            posibles.every((v) => {
              const d = vivas.get(v.id);
              return d ? !(d.is_purchasable && d.is_in_stock) : false;
            });
          l.classList.toggle('agotada', agotada);
          const texto = l.querySelector('span')!.textContent ?? '';
          l.querySelector('input')!.setAttribute('aria-label', agotada ? `${texto} ${T.sufijoAgotado}` : texto);
          l.title = agotada ? T.agotado : '';
        }
      }
    }

    async function alCambiar() {
      for (const f of opciones) {
        const marcado = f.querySelector<HTMLInputElement>('input:checked');
        f.querySelector<HTMLElement>('[data-elegido]')!.textContent = marcado
          ? `: ${marcado.nextElementSibling?.textContent ?? ''}`
          : '';
      }
      aviso.textContent = '';
      const v = elegida();
      if (!v) {
        if (Object.values(seleccion()).every(Boolean)) {
          ponerStock(false);
          stock.textContent = T.sinCombinacion;
        } else if (base) pintar(base, true);
        return;
      }
      await cargaVariaciones;
      const d = vivas.get(v.id) ?? (await cliente.api<ApiPrecio>(`/products/${v.id}`).catch(() => null));
      if (!d || elegida()?.id !== v.id) return; // sin datos, o cambió mientras se leía
      vivas.set(v.id, d);
      pintar(d, false);
      // Si la foto de la variación está en la galería, se muestra.
      const i = originales.indexOf(d.images?.[0]?.src ?? '');
      if (i >= 0) verFoto(i);
    }
    opciones.forEach((f) => f.addEventListener('change', alCambiar));

    // ---------- agregar al carrito ----------
    boton.addEventListener('click', async () => {
      let idAgregar = id;
      if (variable) {
        const v = elegida();
        if (!v) {
          const falta = opciones.find((f) => !f.querySelector('input:checked'));
          aviso.textContent = falta
            ? T.elija.replace('{x}', falta.dataset.etiqueta!.toLowerCase())
            : `${T.sinCombinacion}.`;
          falta?.querySelector<HTMLInputElement>('input')?.focus();
          return;
        }
        idAgregar = v.id;
      }
      boton.disabled = true;
      aviso.textContent = T.agregando;
      try {
        const c = await cliente.api<Carrito>('/cart/add-item', { id: idAgregar, quantity: 1 });
        dispatchEvent(new CustomEvent('sira:carrito', { detail: c.items_count }));
        const enlace = document.createElement('a');
        enlace.href = ficha.dataset.carrito!;
        enlace.textContent = T.verCarrito;
        aviso.replaceChildren(T.agregado, enlace);
      } catch (e) {
        aviso.textContent = `${T.noSePudo}${(e as Error).message}`;
      } finally {
        boton.disabled = !hayStock;
      }
    });
  }
</script>

<style>
  .ficha {
    width: min(100% - 2 * var(--margen), var(--ancho));
    margin-inline: auto;
    padding: clamp(28px, 5.6vw, 81px) 0 clamp(48px, 4vw, 57px);
    color: #181717;
  }
  /* Figma: galería de 558 px desde x=83; datos desde x=709 (485 de ancho) */
  .cuerpo {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 860px) {
    .cuerpo {
      grid-template-columns: minmax(0, 558px) minmax(0, 496px);
      column-gap: clamp(32px, 4.7vw, 68px);
      align-items: start;
    }
  }
  .foto-principal {
    aspect-ratio: 558 / 509;
    border-radius: 9px;
    overflow: hidden;
    background: #ebedef;
    box-shadow: 0 1px 2.7px rgb(0 0 0 / 0.12);
  }
  .foto-principal :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sin-foto {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 24px;
    font-size: 28px;
    text-align: center;
    color: var(--gris);
  }
  .miniaturas {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(12px, 2.2vw, 31px);
    margin-top: 22px;
  }
  .miniatura {
    width: 87px;
    height: 87px;
    padding: 0;
    border: 1px solid #dddddd;
    border-radius: 4px;
    background: #fff;
    overflow: hidden;
    cursor: pointer;
  }
  .miniatura.activa {
    border-color: var(--oro-boton);
    box-shadow: 0 0 0 1px var(--oro-boton);
  }
  .miniatura :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nombre {
    margin: 0;
    font-size: clamp(30px, 2.8vw, 40px);
    line-height: 1.25;
    color: var(--tinta-fuerte);
  }
  @media (min-width: 860px) {
    .nombre {
      line-height: 1.5;
    }
  }
  .precio {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 15px;
    margin: 20px 0 0;
  }
  .precio-etiqueta {
    font-size: 14.28px;
    color: #868686;
  }
  .precio-valor {
    font-size: 17.85px;
    font-weight: 600;
    color: #333333;
  }
  .antes {
    font-size: 14.28px;
    color: #868686;
  }
  .stock {
    margin: 8px 0 0;
    font-size: 13px;
