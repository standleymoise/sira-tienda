---
// /colecciones/<slug>/ (Figma: «ENTRE LÍNEAS» 147:4097): texto editorial de la colección y sus piezas,
// que son las de la categoría de WooCommerce indicada en `colecciones` (src/data/sira.ts).
// Mientras la categoría no exista o esté vacía, se muestra la foto de la colección y un aviso.
// /en/colecciones/<slug>/ reutiliza esta página con lang="en" (y este mismo getStaticPaths).
import PaginaSira from '../../layouts/PaginaSira.astro';
import Listado from '../../components/sira/listado/Listado.astro';
import EstadoVacio from '../../components/sira/listado/EstadoVacio.astro';
import { getProductos } from '../../data/tienda';
import { colecciones, coleccionesPara } from '../../data/sira';
import { rutasPara } from '../../data/rutas';
import type { Idioma } from '../../i18n/idiomas';
import { tienda } from '../../../tienda.config';

export function getStaticPaths() {
  return colecciones.map((c) => ({ params: { slug: c.slug }, props: { coleccion: c } }));
}

const { coleccion, lang = 'es' } = Astro.props as { coleccion: (typeof colecciones)[number]; lang?: Idioma };
// Los textos de la colección en el idioma de la página (el slug es el mismo en los dos idiomas)
const c = coleccionesPara(lang).find((x) => x.slug === coleccion.slug) ?? coleccion;
const rutas = rutasPara(lang);
const t = {
  es: {
    inicio: 'Inicio',
    colecciones: 'Colecciones',
    vacio: 'Las piezas de esta colección se producen en series muy cortas. Vuelva pronto o descubra lo que ya está disponible.',
    verTienda: 'Ver toda la tienda →',
    otras: 'Otras colecciones →',
  },
  en: {
    inicio: 'Home',
    colecciones: 'Collections',
    vacio: 'The pieces in this collection are made in very small runs. Check back soon, or discover what is available now.',
    verTienda: 'Visit the shop →',
    otras: 'Other collections →',
  },
}[lang];
const productos = (await getProductos()).filter((p) => p.categoriasSlug.includes(c.categoria));
const nombre = c.nombre.charAt(0) + c.nombre.slice(1).toLowerCase();
const sitio = Astro.site ?? Astro.url;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.inicio, item: new URL(rutas.inicio, sitio).href },
    { '@type': 'ListItem', position: 2, name: t.colecciones, item: new URL(rutas.colecciones, sitio).href },
    { '@type': 'ListItem', position: 3, name: nombre, item: new URL(rutas.coleccion(c.slug), sitio).href },
  ],
};
---
<PaginaSira
  lang={lang}
  title={`${nombre}: ${c.etiquetaPagina.toLowerCase().replace('sira', 'SIRA')} | ${tienda.marca.nombre}`}
  description={`${c.lema} ${c.texto}`}
  activo="colecciones"
  imagen={c.imagen.src}
  jsonLd={jsonLd}
>
  <Listado
    etiqueta={c.etiquetaPagina}
    titulo={c.nombre}
    texto={c.texto}
    textoGrande
    productos={productos}
    coleccionActual={c.slug}
    lang={lang}
  >
    <EstadoVacio
      slot="vacio"
      lema={c.lema}
      imagen={c.imagen}
      imagenAlt={c.imagenAlt}
      texto={t.vacio}
      enlaces={[
        { texto: t.verTienda, href: rutas.productos },
        { texto: t.otras, href: rutas.colecciones },
      ]}
      lang={lang}
    />
  </Listado>
</PaginaSira>
