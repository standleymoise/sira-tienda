---
// /colecciones/ (Figma: «Body» 147:4557, «Universo SIRA»): las colecciones de `colecciones`
// (src/data/sira.ts) alternando foto grande y texto; la del medio va sobre una banda arena a todo el ancho.
import { Image } from 'astro:assets';
import PaginaSira from '../../layouts/PaginaSira.astro';
import { colecciones } from '../../data/sira';
import { rutas } from '../../data/rutas';
import { tienda } from '../../../tienda.config';

const sitio = Astro.site ?? Astro.url;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(rutas.inicio, sitio).href },
    { '@type': 'ListItem', position: 2, name: 'Colecciones', item: new URL(rutas.colecciones, sitio).href },
  ],
};
---
<PaginaSira
  title={`Colecciones: universo SIRA | ${tienda.marca.nombre}`}
  description={`Colecciones, cápsulas y archivo de ${tienda.marca.nombre}: ${colecciones.map((c) => c.nombre).join(', ')}.`}
  activo="colecciones"
  imagen={colecciones[0]?.imagen.src}
  jsonLd={jsonLd}
>
  <header class="cabecera ancho">
    <p class="etiqueta-espaciada">Colecciones</p>
    <h1 class="titulo serif">Universo SIRA</h1>
  </header>

  {colecciones.map((c, i) => {
    const invertida = i % 2 === 1;
    return (
      <section class:list={['coleccion', { invertida }]} aria-labelledby={`coleccion-${c.slug}`}>
        <div class="ancho rejilla">
          <a class="foto" href={rutas.coleccion(c.slug)} tabindex="-1" aria-hidden="true">
            <Image
              src={c.imagen}
              alt={c.imagenAlt}
              format="webp"
              widths={[480, 711, 1000, 1422]}
              sizes={invertida ? '(max-width: 860px) 92vw, 649px' : '(max-width: 860px) 92vw, 711px'}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          </a>
          <div class="texto">
            <p class="etiqueta-espaciada">{c.etiqueta}</p>
            <h2 id={`coleccion-${c.slug}`} class="nombre serif">{c.nombre}</h2>
            <p class="lema serif">{c.lema}</p>
            <p class="parrafo">{c.texto}</p>
            <p class="accion">
              <a class="enlace-linea" href={rutas.coleccion(c.slug)}>
                Ver piezas →<span class="sr-only"> de {c.nombre}</span>
              </a>
            </p>
          </div>
        </div>
      </section>
    );
  })}
</PaginaSira>

<style>
  .ancho {
    width: min(100% - 2 * var(--margen), 1264px);
    margin-inline: auto;
  }
  .cabecera {
    padding-top: clamp(48px, 6.7vw, 96px);
  }
  .cabecera .etiqueta-espaciada {
    line-height: 16.5px;
    letter-spacing: 2.64px;
  }
  .titulo {
    margin: 12px 0 0;
    font-size: clamp(40px, 4.2vw + 10px, 60px);
    line-height: 1;
    color: var(--tinta-fuerte);
  }

  /* Cada colección: foto 711 + texto 489 (Figma), separación 64 */
  .coleccion {
    margin-top: clamp(64px, 8.9vw, 128px);
  }
  .coleccion:first-of-type {
    margin-top: clamp(40px, 4.4vw, 64px);
  }
  .coleccion:last-of-type {
    padding-bottom: clamp(64px, 6.7vw, 96px);
  }
  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 711fr) minmax(0, 489fr);
    align-items: center;
    gap: clamp(32px, 4.4vw, 64px);
  }
  .foto {
    display: block;
    aspect-ratio: 711 / 888;
    overflow: hidden;
    background: var(--arena);
  }
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .foto:hover :global(img) {
    transform: scale(1.02);
  }

  /* La del medio: texto a la izquierda, foto 649 a la derecha, banda arena a todo el ancho */
  .invertida {
    padding-block: clamp(16px, 2vw, 28px) clamp(32px, 4.4vw, 64px);
    background: var(--arena);
  }
  .invertida .rejilla {
    grid-template-columns: minmax(0, 489fr) minmax(0, 649fr);
    gap: clamp(32px, 6.6vw, 95px);
  }
  .invertida .foto {
    order: 2;
    aspect-ratio: 649 / 811;
  }

  .texto {
    max-width: 489px;
  }
  .texto .etiqueta-espaciada {
    line-height: 16.5px;
    letter-spacing: 2.64px;
  }
  .nombre {
    margin: 20px 0 0;
    font-size: clamp(36px, 3.4vw, 48px);
    line-height: 1;
    color: var(--tinta-fuerte);
  }
  .lema {
    margin: 20px 0 0;
    font-size: 20px;
    font-style: italic;
    line-height: 28px;
    color: var(--gris);
  }
  .parrafo {
    margin: 20px 0 0;
    font-size: 14px;
    line-height: 28px;
    letter-spacing: 0.35px;
    color: var(--gris);
  }
  .accion {
    margin: 37px 0 0;
  }

  @media (max-width: 860px) {
    .rejilla,
    .invertida .rejilla {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .invertida .foto {
      order: 0;
    }
    .invertida {
      padding-block: 32px 48px;
    }
    .accion {
      margin-top: 24px;
    }
  }
</style>
