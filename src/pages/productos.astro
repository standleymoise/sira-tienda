---
// /productos/: todo el catálogo en lista, con enlaces a la página de cada producto.
// Además de servir a quien prefiere una lista, es el camino por el que Google llega a cada producto.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { getProductos } from '../data/tienda';
import { rutas } from '../data/rutas';
import { tienda } from '../../tienda.config';
import { getCollection } from 'astro:content';
import Testimonios from '../components/Testimonios.astro';

const productos = await getProductos();
// Hasta 3 testimonios debajo de la lista (solo si WordPress tiene alguno).
const testimonios = (await getCollection('testimonios')).slice(0, 3);
const sitio = Astro.site ?? Astro.url;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(rutas.inicio, sitio).href },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: new URL(rutas.productos, sitio).href },
  ],
};
---
<Base
  title={`Productos | ${tienda.marca.nombre}`}
  description={`Todos los productos de ${tienda.marca.nombre}, con precio y disponibilidad.`}
  imagen={productos[0]?.imagen?.src}
  jsonLd={jsonLd}
>
  <main class="lista-productos">
    <header class="cabecera">
      <a class="volver" href={rutas.inicio}>‹ Tienda</a>
      <Logo alto={36} />
      <span></span>
    </header>
    <h1>Productos</h1>
    <ul>
      {productos.map((p, i) => (
        <li>
          <a href={rutas.producto(p.slug)}>
            {p.imagen && (
              <Image
                src={p.imagen.src}
                alt={p.imagen.alt}
                inferSize
                format="webp"
                widths={[240, 480]}
                sizes="(max-width: 600px) 45vw, 240px"
                loading={i < 4 ? 'eager' : 'lazy'}
              />
            )}
            <span class="nombre">{p.nombre}</span>
            <span class="precio">{p.precio}</span>
            {!p.enStock && <span class="agotado">Agotado</span>}
          </a>
        </li>
      ))}
    </ul>
    {testimonios.length > 0 && (
      <section class="opiniones" aria-labelledby="opiniones-titulo">
        <h2 id="opiniones-titulo">Lo que dicen nuestros clientes</h2>
        <Testimonios lista={testimonios} />
        <p><a class="ver-todas" href={rutas.opiniones}>Ver todas las opiniones</a></p>
      </section>
    )}
  </main>
</Base>

<style>
  .lista-productos {
    max-width: 1080px;
    margin: 0 auto;
    padding: 12px 16px 48px;
  }
  .cabecera {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 52px;
  }
  .volver {
    color: var(--primario);
    font-weight: 600;
    text-decoration: none;
  }
  h1 {
    font-family: var(--font-alt);
    color: var(--primario);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(45%, 220px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    padding: 10px;
    border-radius: 18px;
    background: #fff;
    text-decoration: none;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.06);
  }
  li a :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 12px;
    background: var(--suave-claro);
  }
  .nombre {
    font-weight: 600;
    color: var(--primario);
  }
  .precio {
    font-weight: 700;
  }
  .agotado {
    font-size: 13px;
    color: var(--acento);
  }
  .opiniones {
    margin-top: 48px;
  }
  .opiniones h2 {
    font-family: var(--font-alt);
    color: var(--primario);
  }
  .ver-todas {
    display: inline-block;
    margin-top: 16px;
    color: var(--primario);
    font-weight: 600;
  }
</style>
