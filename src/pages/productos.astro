---
// /productos/ = «Tienda» (Figma: «Tienda» 147:4282): todo el catálogo con filtros, paginación de 12
// y búsqueda por ?q= (la usa el buscador del encabezado). También es el camino por el que Google
// llega a cada producto. (No existe /tienda: esa ruta queda para WordPress.)
import PaginaSira from '../layouts/PaginaSira.astro';
import Listado from '../components/sira/listado/Listado.astro';
import { getProductos } from '../data/tienda';
import { rutas } from '../data/rutas';
import { tienda } from '../../tienda.config';

const productos = await getProductos();
const sitio = Astro.site ?? Astro.url;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(rutas.inicio, sitio).href },
    { '@type': 'ListItem', position: 2, name: 'Tienda', item: new URL(rutas.productos, sitio).href },
  ],
};
const texto =
  'Cada prenda se produce en series muy cortas o como pieza única, combinando textiles seleccionados y confección consciente.';
---
<PaginaSira
  title={`Tienda: piezas únicas | ${tienda.marca.nombre}`}
  description={`Todas las piezas de ${tienda.marca.nombre}, con precio y disponibilidad. ${texto}`}
  activo="tienda"
  imagen={productos[0]?.imagen?.src}
  jsonLd={jsonLd}
>
  <Listado etiqueta="Tienda" titulo="Piezas únicas" texto={texto} productos={productos} porPagina={12} busqueda />
</PaginaSira>
