---
// /opiniones/: todos los testimonios. Vienen de WordPress (CPT UI «testimonios» + campos de ACF) y se
// actualizan solos: al publicar uno, el plugin tienda-publicar.php pide un build nuevo.
// Es una ruta [opiniones] para poder NO generarla cuando no hay testimonios (así no queda en el
// sitemap una página vacía); el único valor posible es «opiniones».
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Testimonios from '../components/Testimonios.astro';
import { rutas } from '../data/rutas';
import { tienda } from '../../tienda.config';

export async function getStaticPaths() {
  const hay = (await getCollection('testimonios')).length > 0;
  return hay ? [{ params: { opiniones: 'opiniones' } }] : [];
}

const testimonios = await getCollection('testimonios');
const sitio = Astro.site ?? Astro.url;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(rutas.inicio, sitio).href },
    { '@type': 'ListItem', position: 2, name: 'Opiniones', item: new URL(rutas.opiniones, sitio).href },
  ],
};
---
<Base
  title={`Opiniones de clientes | ${tienda.marca.nombre}`}
  description={`Lo que dicen los clientes de ${tienda.marca.nombre}.`}
  jsonLd={jsonLd}
>
  <main class="pagina-opiniones">
    <header class="cabecera">
      <a class="volver" href={rutas.inicio}>‹ Tienda</a>
      <Logo alto={36} />
      <span></span>
    </header>
    <h1>Opiniones de clientes</h1>
    <Testimonios lista={testimonios} titulo="h2" />
    <p class="pie"><a href={rutas.productos}>Ver todos los productos</a></p>
  </main>
</Base>

<style>
  .pagina-opiniones {
    max-width: 1080px;
    margin: 0 auto;
    padding: 12px 16px 48px;
  }
  .cabecera {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 52px;
  }
  .volver,
  .pie a {
    color: var(--primario);
    font-weight: 600;
  }
  .volver {
    text-decoration: none;
  }
  h1 {
    font-family: var(--font-alt);
    color: var(--primario);
  }
  .pie {
    margin-top: 32px;
  }
</style>
