---
// /reversibles/ (Figma: «Reversibles» 147:4679): portada con foto a todo el ancho, «La historia
// reversible» (#historia) con las dos caras, y las chaquetas reversibles reales de WooCommerce (#piezas)
// con filtro Todas · Mujer · Hombre (por data-genero; también por ?genero=, lo usa el menú).
// La misma página sirve /en/reversibles/ con lang="en".
import { Image } from 'astro:assets';
import PaginaSira from '../layouts/PaginaSira.astro';
import TarjetaProducto from '../components/sira/TarjetaProducto.astro';
import EstadoVacio from '../components/sira/listado/EstadoVacio.astro';
import { getProductos } from '../data/tienda';
import { rutasPara } from '../data/rutas';
import type { Idioma } from '../i18n/idiomas';
import { tienda } from '../../tienda.config';
import imgPortada from '../assets/sira/chaqueta-vino-dorado.png';
import imgCaraA from '../assets/sira/chaqueta-hombre-grafito.png';
import imgCaraB from '../assets/sira/reversible-cara-b.png';

const { lang = 'es' } = Astro.props as { lang?: Idioma };
const rutas = rutasPara(lang);
const t = {
  es: {
    meta: `Reversibles: dos caras, una misma esencia | ${tienda.marca.nombre}`,
    historia:
      'En SIRA la reversibilidad no es un recurso técnico: es una declaración de intención. Cada chaqueta nace de dos textiles cuidadosamente emparejados —nuevos y recuperados— para que ambas caras tengan presencia propia, multiplicando las posibilidades de uso con menos consumo.',
    portadaAlt: 'Chaqueta reversible SIRA en vino y dorado',
    portadaEtiqueta: 'Código de marca SIRA',
    descubrir: 'Descubrir la colección →',
    historiaEtiqueta: 'La historia reversible',
    caraAAlt: 'Chaqueta reversible SIRA, cara A en grafito',
    caraA: 'Cara A · Sobriedad',
    caraBAlt: 'Chaqueta reversible SIRA, cara B estampada',
    caraB: 'Cara B · Contraste',
    disponibles: 'Piezas disponibles',
    piezasTitulo: 'Chaquetas Reversibles',
    porGenero: 'Filtrar por género',
    todas: 'Todas',
    mujer: 'Mujer',
    hombre: 'Hombre',
    vacioGenero: 'Pronto nuevas piezas reversibles en esta selección.',
    verReversibles: 'Ver todas las reversibles →',
    vacio: 'Pronto nuevas piezas reversibles.',
    verTienda: 'Ver toda la tienda →',
  },
  en: {
    meta: `Reversibles: two sides, one essence | ${tienda.marca.nombre}`,
    historia:
      'At SIRA, reversibility is not a technical trick: it is a statement of intent. Each jacket begins with two carefully paired textiles, new and reclaimed, so that both sides carry their own presence, multiplying the ways to wear it while consuming less.',
    portadaAlt: 'SIRA reversible jacket in wine and gold',
    portadaEtiqueta: 'The SIRA signature',
    descubrir: 'Discover the collection →',
    historiaEtiqueta: 'The reversible story',
    caraAAlt: 'SIRA reversible jacket, side A in graphite',
    caraA: 'Side A · Restraint',
    caraBAlt: 'SIRA reversible jacket, printed side B',
    caraB: 'Side B · Contrast',
    disponibles: 'Available pieces',
    piezasTitulo: 'Reversible Jackets',
    porGenero: 'Filter by gender',
    todas: 'All',
    mujer: 'Women',
    hombre: 'Men',
    vacioGenero: 'New reversible pieces are coming to this selection soon.',
    verReversibles: 'View all reversibles →',
    vacio: 'New reversible pieces are coming soon.',
    verTienda: 'Visit the shop →',
  },
}[lang];

const productos = (await getProductos()).filter((p) => p.reversible);
const historia = t.historia;
const generos = [
  { id: '', texto: t.todas },
  { id: 'mujer', texto: t.mujer },
  { id: 'hombre', texto: t.hombre },
];
---
<PaginaSira
  lang={lang}
  title={t.meta}
  description={historia}
  activo="reversibles"
  imagen={imgPortada.src}
>
  <section class="portada" aria-labelledby="reversibles-titulo">
    <Image
      class="portada-foto"
      src={imgPortada}
      alt={t.portadaAlt}
      format="webp"
      widths={[640, 1024, 1440, 2160, 2880]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="portada-velo" aria-hidden="true"></div>
    <div class="portada-texto">
      <p class="portada-etiqueta">{t.portadaEtiqueta}</p>
      <h1 id="reversibles-titulo" class="portada-titulo serif">
        REVERSIBLE BY NATURE.<br />EXPRESSIVE BY DESIGN.
      </h1>
      <a class="enlace-linea portada-enlace" href="#piezas">{t.descubrir}</a>
    </div>
  </section>

  <section class="historia" id="historia" aria-labelledby="historia-titulo">
    <div class="ancho historia-rejilla">
      <div class="historia-texto">
        <p class="etiqueta-espaciada">{t.historiaEtiqueta}</p>
        <h2 id="historia-titulo" class="historia-titulo serif">ONE PIECE. TWO STORIES.</h2>
        <p class="parrafo">{historia}</p>
      </div>
      <div class="caras">
        <figure>
          <div class="cara-foto">
            <Image src={imgCaraA} alt={t.caraAAlt} format="webp" widths={[294, 588]} sizes="(max-width: 560px) 44vw, 294px" />
          </div>
          <figcaption>{t.caraA}</figcaption>
        </figure>
        <figure>
          <div class="cara-foto">
            <Image src={imgCaraB} alt={t.caraBAlt} format="webp" widths={[294, 588]} sizes="(max-width: 560px) 44vw, 294px" />
          </div>
          <figcaption>{t.caraB}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="piezas ancho" id="piezas" aria-labelledby="piezas-titulo" data-reversibles-lista>
    <div class="piezas-cabecera">
      <div>
        <p class="etiqueta-espaciada">{t.disponibles}</p>
        <h2 id="piezas-titulo" class="piezas-titulo serif">{t.piezasTitulo}</h2>
      </div>
      {productos.length > 0 && (
        <div class="generos" role="group" aria-label={t.porGenero}>
          {generos.map((g) => (
            <button type="button" class:list={['genero', { activo: !g.id }]} data-genero-filtro={g.id} aria-pressed={!g.id ? 'true' : 'false'}>
              {g.texto}
            </button>
          ))}
        </div>
      )}
    </div>

    {productos.length > 0 ? (
      <>
        <ul class="cuadricula">
          {productos.map((p, i) => (
            <li data-item data-genero={p.genero}>
              <TarjetaProducto producto={p} variante="lista" prioridad={i < 4} ancho={292} lang={lang} />
            </li>
          ))}
        </ul>
        <div data-vacio-genero hidden>
          <EstadoVacio titulo={t.vacioGenero} enlaces={[{ texto: t.verReversibles, href: `${rutas.reversibles}#piezas` }]} lang={lang} />
        </div>
      </>
    ) : (
      <EstadoVacio
        titulo={t.vacio}
        enlaces={[{ texto: t.verTienda, href: rutas.productos }]}
        lang={lang}
      />
    )}
  </section>
</PaginaSira>

<script>
  // Filtro Todas · Mujer · Hombre, con ?genero= en la URL (lo usan los enlaces del menú).
  const lista = document.querySelector<HTMLElement>('[data-reversibles-lista]');
  const botones = [...(lista?.querySelectorAll<HTMLButtonElement>('[data-genero-filtro]') ?? [])];
  if (lista && botones.length) {
    const items = [...lista.querySelectorAll<HTMLElement>('[data-item]')];
    const vacio = lista.querySelector<HTMLElement>('[data-vacio-genero]')!;
    const validos = ['mujer', 'hombre'];
    let genero = new URLSearchParams(location.search).get('genero') ?? '';
    if (!validos.includes(genero)) genero = '';

    const aplicar = () => {
      let visibles = 0;
      items.forEach((li) => {
        const si = !genero || li.dataset.genero === genero;
        li.hidden = !si;
        if (si) visibles++;
      });
      vacio.hidden = visibles > 0;
      botones.forEach((b) => {
        const si = (b.dataset.generoFiltro ?? '') === genero;
        b.classList.toggle('activo', si);
        b.setAttribute('aria-pressed', String(si));
      });
      const u = new URL(location.href);
      if (genero) u.searchParams.set('genero', genero);
      else u.searchParams.delete('genero');
      history.replaceState(history.state, '', u.pathname + u.search + u.hash);
    };
    botones.forEach((b) =>
      b.addEventListener('click', () => {
        genero = b.dataset.generoFiltro ?? '';
        aplicar();
      }),
    );
    aplicar();
  }
</script>

<style>
  .ancho {
    width: min(100% - 2 * var(--margen), 1264px);
    margin-inline: auto;
  }

  /* Portada (Figma: 1440 × 648, foto con velo 30 %) */
  .portada {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(480px, 45vw, 648px);
    overflow: hidden;
    background: var(--tinta-fuerte);
  }
  .portada :global(.portada-foto),
  .portada-velo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .portada :global(.portada-foto) {
    object-fit: cover;
  }
  .portada-velo {
    background: rgba(28, 26, 24, 0.3);
  }
  .portada-texto {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48px var(--margen);
    text-align: center;
    color: #fffdfb;
  }
  .portada-etiqueta {
    margin: 0;
    font-size: 11px;
    line-height: 16.5px;
    letter-spacing: 2.86px;
    text-transform: uppercase;
    color: rgba(255, 253, 251, 0.85);
  }
  .portada-titulo {
    margin: 16px 0 0;
    font-size: clamp(34px, 4.2vw, 60px);
    line-height: 1.25;
    color: #fffdfb;
  }
  .portada-enlace {
    margin-top: 32px;
    color: #fffdfb;
  }

  /* La historia reversible (Figma: fondo arena, texto 499 + dos figuras 294 × 392) */
  .historia {
    padding-block: clamp(64px, 7.8vw, 112px);
    background: var(--arena);
    scroll-margin-top: 80px;
  }
  .historia-rejilla {
    display: grid;
    grid-template-columns: minmax(0, 499px) minmax(0, 608px);
    justify-content: space-between;
    align-items: center;
    gap: 48px;
  }
  .historia .etiqueta-espaciada,
  .piezas .etiqueta-espaciada {
    line-height: 16.5px;
    letter-spacing: 2.64px;
  }
  .historia-titulo {
    margin: 24px 0 0;
    font-size: clamp(36px, 3.4vw, 48px);
    line-height: 1.25;
    color: var(--tinta-fuerte);
  }
  .parrafo {
    margin: 24px 0 0;
    font-size: 14px;
    line-height: 28px;
    letter-spacing: 0.35px;
    color: var(--gris);
  }
  .caras {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  figure {
    margin: 0;
  }
  .cara-foto {
    aspect-ratio: 294 / 392;
    overflow: hidden;
    background: var(--arena-oscura);
  }
  .cara-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    padding-top: 12px;
    font-size: 10px;
    line-height: 15px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gris);
  }

  /* Piezas disponibles (Figma: cuadrícula 4 × 292, separación 32) */
  .piezas {
    padding-block: clamp(64px, 6.7vw, 96px);
    scroll-margin-top: 60px;
  }
  .piezas-cabecera {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--linea);
  }
  .piezas-titulo {
    margin: 8px 0 0;
    font-size: clamp(30px, 2.6vw, 36px);
    line-height: 40px;
    color: var(--tinta-fuerte);
  }
  .generos {
    display: flex;
    gap: 20px;
  }
  .genero {
    padding: 0 0 4px;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    font: inherit;
    font-size: 11px;
    line-height: 16.5px;
    letter-spacing: 1.98px;
    color: var(--gris);
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .genero:hover {
    color: var(--tinta-fuerte);
  }
  .genero.activo {
    color: var(--tinta-fuerte);
    border-bottom-color: var(--tinta-fuerte);
  }
  .cuadricula {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 48px 32px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }
  .cuadricula > li[hidden] {
    display: none;
  }
  [data-vacio-genero] {
    margin-top: 16px;
  }
  .piezas > :global(.vacio) {
    margin-top: 16px;
  }

  @media (max-width: 1100px) {
    .cuadricula {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .historia-rejilla {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .caras {
      gap: 12px;
    }
    .cuadricula {
      gap: 32px 12px;
      margin-top: 32px;
    }
    .cuadricula :global(.fila-precio) {
      flex-wrap: wrap;
      row-gap: 4px;
    }
    .cuadricula :global(.tarjeta-lista .nombre) {
      font-size: 16px;
      line-height: 21px;
    }
  }
</style>
