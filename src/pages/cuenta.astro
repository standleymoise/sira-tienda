---
// Página /cuenta: entrar, crear cuenta, recuperar contraseña y «Mi cuenta»
// (perfil, pedidos y datos de entrega). Habla con el plugin wordpress/mu-plugins/tienda-cuenta.php.
import PaginaSira from '../layouts/PaginaSira.astro';
import { storeApiUrl } from '../data/tienda';
import { rutas } from '../data/rutas';
import { tienda } from '../../tienda.config';

const { regiones, etiquetaRegion, etiquetaCiudad, codigoPostal } = tienda.pais;
---
<PaginaSira title={`Mi cuenta | ${tienda.marca.nombre}`} description={`Inicie sesión o cree su cuenta en ${tienda.marca.nombre}.`} noindex>
  <div class="cuenta" data-api={storeApiUrl} data-inicio={rutas.inicio} data-estado="cargando">
    <p class="cargando" data-vista-cargando>Cargando…</p>

    <!-- ===================== sin sesión ===================== -->
    <section class="acceso" data-vista-acceso hidden aria-labelledby="acceso-titulo">
      <div class="burbuja" aria-hidden="true">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8.5" r="4" /><path d="M4.5 20a7.5 7.5 0 0 1 15 0" /></svg>
      </div>
      <h1 id="acceso-titulo">Su cuenta</h1>
      <p class="sub">Guarde sus datos de entrega y vea sus pedidos.</p>

      <div class="pestanas" role="tablist" aria-label="Acceso">
        <button type="button" role="tab" aria-selected="true" aria-controls="form-login" id="tab-login" data-tab="login">
          Iniciar sesión
        </button>
        <button type="button" role="tab" aria-selected="false" aria-controls="form-registro" id="tab-registro" data-tab="registro" tabindex="-1">
          Crear cuenta
        </button>
      </div>

      <form class="form" id="form-login" role="tabpanel" aria-labelledby="tab-login" data-form="login" novalidate>
        <label>Correo electrónico <input name="email" type="email" required autocomplete="email" /></label>
        <label>Contraseña <input name="password" type="password" required autocomplete="current-password" /></label>
        <p class="error" data-error role="alert" hidden></p>
        <button class="pildora" type="submit">Iniciar sesión</button>
        <button class="enlace" type="button" data-ir="recuperar">¿Olvidó su contraseña?</button>
      </form>

      <form class="form" id="form-registro" role="tabpanel" aria-labelledby="tab-registro" data-form="registro" hidden novalidate>
        <div class="dos">
          <label>Nombre <input name="nombre" required autocomplete="given-name" /></label>
          <label>Apellidos <input name="apellidos" autocomplete="family-name" /></label>
        </div>
        <label>Correo electrónico <input name="email" type="email" required autocomplete="email" /></label>
        <label>
          Contraseña
          <input name="password" type="password" required minlength="8" autocomplete="new-password" />
          <span class="ayuda">Al menos 8 caracteres.</span>
        </label>
        <p class="error" data-error role="alert" hidden></p>
        <button class="pildora" type="submit">Crear cuenta</button>
      </form>

      <form class="form" data-form="recuperar" hidden novalidate>
        <p class="sub">Escriba su correo y le enviaremos un enlace para crear una contraseña nueva.</p>
        <label>Correo electrónico <input name="email" type="email" required autocomplete="email" /></label>
        <p class="error" data-error role="alert" hidden></p>
        <p class="ok" data-ok role="status" hidden></p>
        <button class="pildora" type="submit">Enviar enlace</button>
        <button class="enlace" type="button" data-ir="login">Volver a iniciar sesión</button>
      </form>
    </section>

    <!-- ===================== con sesión ===================== -->
    <section class="perfil" data-vista-perfil hidden aria-labelledby="perfil-nombre">
      <div class="avatar" aria-hidden="true"><span data-iniciales></span></div>
      <h1 id="perfil-nombre" data-nombre></h1>
      <p class="sub" data-email></p>
      <p class="desde" data-desde></p>

      <div class="atajos">
        <button type="button" class="atajo" data-ir="datos">
          <span class="atajo-icono"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-4-4L4 16z" /></svg></span>
          Mis datos
        </button>
        <a class="atajo principal" href={rutas.productos}>
          <span class="atajo-icono"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 10.2a1.5 1.5 0 0 0 1.5 1.1h8.6a1.5 1.5 0 0 0 1.4-1.1L21 8H6.2" /><circle cx="9.5" cy="19.5" r="1.4" /><circle cx="17" cy="19.5" r="1.4" /></svg></span>
          Tienda
        </a>
        <a class="atajo" href={rutas.favoritos}>
          <span class="atajo-icono"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1.17 5.54c0-.65.2-1.28.56-1.82a3.21 3.21 0 0 1 4.44-.81c.32.22.6.5.83.83a3.21 3.21 0 0 1 5.83 1.8c0 1.34-.88 2.35-1.75 3.22L7.88 11.9a1.17 1.17 0 0 1-1.66.06L3 8.76c-.88-.87-1.83-1.87-1.83-3.22z" /></svg></span>
          Favoritos
        </a>
      </div>

      <section class="tarjeta" aria-labelledby="pedidos-titulo">
        <h2 id="pedidos-titulo">Mis pedidos</h2>
        <ul class="pedidos" data-pedidos></ul>
        <p class="vacio" data-sin-pedidos hidden>
          Todavía no tiene pedidos. <a href={rutas.productos}>Vea las piezas de la tienda</a>.
        </p>
      </section>

      <section class="tarjeta" id="datos" aria-labelledby="datos-titulo">
        <h2 id="datos-titulo">Mis datos de entrega</h2>
        <p class="sub izq">Se usan para llenar el checkout automáticamente.</p>
        <form class="form" data-form="datos" novalidate>
          <div class="dos">
            <label>Nombre <input name="nombre" required autocomplete="given-name" /></label>
            <label>Apellidos <input name="apellidos" autocomplete="family-name" /></label>
          </div>
          <label>Teléfono <input name="telefono" type="tel" autocomplete="tel" /></label>
          <div class="dos">
            {regiones.length > 0 && (
              <label>
                {etiquetaRegion}
                <select name="provincia">
                  <option value="">Elegir…</option>
                  {regiones.map(([c, n]) => <option value={c}>{n}</option>)}
                </select>
              </label>
            )}
            <label>{etiquetaCiudad} <input name="ciudad" autocomplete="address-level2" /></label>
          </div>
          <label>Dirección exacta <input name="direccion" autocomplete="street-address" /></label>
          <label>
            Código postal
            <input name="postal" pattern={codigoPostal.patron || undefined} autocomplete="postal-code" />
          </label>
          <p class="error" data-error role="alert" hidden></p>
          <button class="pildora" type="submit">Guardar cambios</button>
        </form>
      </section>

      <button class="salir" type="button" data-salir>Cerrar sesión</button>
    </section>

    <button class="instalar-cuenta" type="button" data-instalar-app hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5" /><path d="M12 7v7M9 11l3 3 3-3" /></svg>
      Instalar la app en este teléfono
    </button>

    <p class="aviso" data-aviso role="status" aria-live="polite"></p>
  </div>
</PaginaSira>

<script>
  import { tienda } from '../../tienda.config';
  import { crearCliente, iniciales, leerPerfil, type Pedido, type Perfil } from '../scripts/tienda-api';

  const raiz = document.querySelector<HTMLElement>('.cuenta');
  if (raiz) iniciar(raiz);

  function iniciar(raiz: HTMLElement) {
    const cliente = crearCliente(raiz.dataset.api!);
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => raiz.querySelector<T>(sel)!;
    const vistas = {
      cargando: $('[data-vista-cargando]'),
      acceso: $('[data-vista-acceso]'),
      perfil: $('[data-vista-perfil]'),
    };
    const forms = {
      login: $<HTMLFormElement>('[data-form="login"]'),
      registro: $<HTMLFormElement>('[data-form="registro"]'),
      recuperar: $<HTMLFormElement>('[data-form="recuperar"]'),
      datos: $<HTMLFormElement>('[data-form="datos"]'),
    };

    let avisoTimer = 0;
    const avisar = (texto: string) => {
      const a = $('[data-aviso]');
      a.textContent = texto;
      a.classList.add('visible');
      clearTimeout(avisoTimer);
      avisoTimer = window.setTimeout(() => a.classList.remove('visible'), 2600);
    };

    function mostrar(vista: keyof typeof vistas) {
      (Object.keys(vistas) as (keyof typeof vistas)[]).forEach((k) => (vistas[k].hidden = k !== vista));
      raiz.dataset.estado = vista;
    }

    // ---------- pestañas de acceso ----------
    const tabs = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    function irA(cual: 'login' | 'registro' | 'recuperar') {
      tabs.forEach((t) => {
        const activa = t.dataset.tab === cual;
        t.setAttribute('aria-selected', String(activa));
        t.tabIndex = activa ? 0 : -1;
      });
      raiz.querySelector('.pestanas')!.toggleAttribute('hidden', cual === 'recuperar');
      forms.login.hidden = cual !== 'login';
      forms.registro.hidden = cual !== 'registro';
      forms.recuperar.hidden = cual !== 'recuperar';
      const f = forms[cual];
      f.querySelector<HTMLElement>('[data-error]')!.hidden = true;
      f.querySelector('input')?.focus();
    }
    tabs.forEach((t) =>
      t.addEventListener('click', () => irA(t.dataset.tab as 'login' | 'registro')),
    );
    raiz.querySelector('.pestanas')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k !== 'ArrowLeft' && k !== 'ArrowRight') return;
      const actual = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      const siguiente = tabs[(actual + 1) % tabs.length];
      irA(siguiente.dataset.tab as 'login' | 'registro');
      siguiente.focus();
    });

    // ---------- envío de formularios ----------
    async function enviar(f: HTMLFormElement, accion: (d: Record<string, string>) => Promise<void>) {
      const error = f.querySelector<HTMLElement>('[data-error]')!;
      const boton = f.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      error.hidden = true;
      if (!f.checkValidity()) {
        f.classList.add('validar');
        const malo = f.querySelector<HTMLInputElement>(':invalid');
        error.textContent = malo?.validationMessage || 'Revise los campos marcados.';
        error.hidden = false;
        malo?.focus();
        return;
      }
      const texto = boton.textContent;
      boton.disabled = true;
      boton.textContent = 'Un momento…';
      try {
        await accion(Object.fromEntries(new FormData(f)) as Record<string, string>);
        f.classList.remove('validar');
      } catch (e) {
        error.textContent = (e as Error).message || 'Algo salió mal. Intente de nuevo.';
        error.hidden = false;
      } finally {
        boton.disabled = false;
        boton.textContent = texto;
      }
    }

    forms.login.addEventListener('submit', (e) => {
      e.preventDefault();
      enviar(forms.login, async (d) => {
        const p = await cliente.login(d.email, d.password);
        forms.login.reset();
        avisar(`¡Hola, ${p.nombre || 'de nuevo'}!`);
        await cargarCuenta();
      });
    });
    forms.registro.addEventListener('submit', (e) => {
      e.preventDefault();
      enviar(forms.registro, async (d) => {
        const p = await cliente.registro({
          email: d.email,
          password: d.password,
          nombre: d.nombre,
          apellidos: d.apellidos,
        });
        forms.registro.reset();
        avisar(`¡Bienvenido, ${p.nombre}!`);
        await cargarCuenta();
      });
    });
    forms.recuperar.addEventListener('submit', (e) => {
      e.preventDefault();
      enviar(forms.recuperar, async (d) => {
        await cliente.recuperar(d.email);
        const ok = forms.recuperar.querySelector<HTMLElement>('[data-ok]')!;
        ok.textContent = `Si existe una cuenta con ${d.email}, le enviamos un correo con el enlace.`;
        ok.hidden = false;
      });
    });
    forms.datos.addEventListener('submit', (e) => {
      e.preventDefault();
      enviar(forms.datos, async (d) => {
        const p = await cliente.guardarCuenta(d);
        pintarPerfil(p);
        avisar('Datos guardados.');
      });
    });

    raiz.addEventListener('click', (e) => {
      const ir = (e.target as HTMLElement).closest<HTMLElement>('[data-ir]');
      if (!ir) return;
      const destino = ir.dataset.ir!;
      if (destino === 'datos') {
        document.getElementById('datos')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
        forms.datos.querySelector('input')?.focus({ preventScroll: true });
      } else irA(destino as 'login' | 'recuperar');
    });

    $('[data-salir]').addEventListener('click', async () => {
      await cliente.salir();
      avisar('Sesión cerrada.');
      irA('login');
      mostrar('acceso');
    });

    // ---------- perfil ----------
    const fecha = (iso: string, opciones: Intl.DateTimeFormatOptions) =>
      iso ? new Intl.DateTimeFormat(tienda.pais.locale, opciones).format(new Date(iso + 'T12:00:00')) : '';
    const dinero = (n: number, moneda: string) =>
      new Intl.NumberFormat(tienda.pais.locale, { style: 'currency', currency: moneda, maximumFractionDigits: 0 }).format(n);

    function pintarPerfil(p: Perfil) {
      $('[data-iniciales]').textContent = iniciales(p);
      $('[data-nombre]').textContent = [p.nombre, p.apellidos].filter(Boolean).join(' ') || p.email;
      $('[data-email]').textContent = p.email;
      $('[data-desde]').textContent = p.desde ? `Cliente desde ${fecha(p.desde, { month: 'long', year: 'numeric' })}` : '';
      const f = forms.datos.elements as unknown as Record<string, HTMLInputElement>;
      (['nombre', 'apellidos', 'telefono', 'provincia', 'ciudad', 'direccion', 'postal'] as const).forEach((k) => {
        if (f[k]) f[k].value = p[k] ?? '';
      });
    }

    function pintarPedidos(pedidos: Pedido[]) {
      const lista = $('[data-pedidos]');
      $('[data-sin-pedidos]').hidden = pedidos.length > 0;
      lista.replaceChildren(
        ...pedidos.map((o) => {
          const li = document.createElement('li');
          li.className = 'pedido';
          li.innerHTML = `
            <div class="pedido-cabeza">
              <strong></strong>
              <span class="estado"></span>
            </div>
            <div class="pedido-fotos"></div>
            <p class="pedido-items"></p>
            <div class="pedido-pie"><span class="pedido-fecha"></span><strong class="pedido-total"></strong></div>`;
          li.querySelector('.pedido-cabeza strong')!.textContent = `Pedido #${o.numero}`;
          const estado = li.querySelector<HTMLElement>('.estado')!;
          estado.textContent = o.estado_texto;
          estado.dataset.estado = o.estado;
          const fotos = li.querySelector<HTMLElement>('.pedido-fotos')!;
          o.items.forEach((it) => {
            if (!it.imagen) return;
            const img = document.createElement('img');
            img.src = it.imagen;
            img.alt = '';
            img.loading = 'lazy';
            fotos.append(img);
          });
          li.querySelector('.pedido-items')!.textContent = o.items.map((it) => `${it.cantidad}× ${it.nombre}`).join(' · ');
          li.querySelector('.pedido-fecha')!.textContent = [fecha(o.fecha, { day: 'numeric', month: 'short', year: 'numeric' }), o.pago]
            .filter(Boolean)
            .join(' · ');
          li.querySelector('.pedido-total')!.textContent = dinero(o.total, o.moneda);
          return li;
        }),
      );
    }

    async function cargarCuenta() {
      try {
        const { perfil, pedidos } = await cliente.cuenta();
        pintarPerfil(perfil);
        pintarPedidos(pedidos);
        mostrar('perfil');
      } catch (e) {
        if ((e as { status?: number }).status === 401) {
          mostrar('acceso');
          irA('login');
        } else {
          avisar((e as Error).message);
          // Sin conexión: con el perfil guardado al menos se ve quién es.
          const p = leerPerfil();
          if (p) {
            pintarPerfil(p);
            pintarPedidos([]);
            mostrar('perfil');
          } else mostrar('acceso');
        }
      }
    }

    if (cliente.conSesion()) {
      const p = leerPerfil();
      if (p) {
        pintarPerfil(p);
        mostrar('perfil');
      }
      cargarCuenta();
    } else {
      mostrar('acceso');
      if (location.hash === '#crear') irA('registro');
    }
  }
</script>


<style>
  /* Estilo SIRA: Cormorant en títulos, Montserrat en texto, bordes finos y botones cuadrados. */
  .cuenta {
    width: min(100% - 2 * var(--margen), 560px);
    min-height: 60vh;
    margin-inline: auto;
    padding: clamp(32px, 3.5vw, 51px) 0 clamp(56px, 6vw, 96px);
    color: var(--tinta);
  }
  .atajo-icono svg,
  .burbuja svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cargando {
    margin-top: 20vh;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gris);
  }
  .cargando[hidden],
  section[hidden],
  form[hidden],
  .pestanas[hidden] {
    display: none;
  }

  h1 {
    margin: 18px 0 6px;
    font-family: var(--font-alt);
    font-weight: 400;
    font-size: clamp(38px, 3.9vw, 52px);
    line-height: 1.05;
    text-align: center;
    color: var(--tinta-fuerte);
  }
  .sub {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    text-align: center;
    color: var(--gris);
  }
  .sub.izq {
    margin-bottom: 18px;
    text-align: left;
  }

  /* ---------- acceso ---------- */
  .acceso {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .burbuja {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border: 1px solid var(--linea);
    border-radius: 50%;
    background: var(--arena);
    color: var(--tinta-fuerte);
  }
  .burbuja svg {
    width: 30px;
    height: 30px;
  }
  .pestanas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    margin: 32px 0 24px;
    border-bottom: 1px solid var(--linea);
  }
  .pestanas button {
    margin-bottom: -1px;
    padding: 14px 8px;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    font: inherit;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gris);
    cursor: pointer;
  }
  .pestanas [aria-selected='true'] {
    border-bottom-color: var(--tinta-fuerte);
    color: var(--tinta-fuerte);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }
  .form label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gris);
  }
  .dos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .form input,
  .form select {
    width: 100%;
    padding: 14px 18px;
    border: 1px solid var(--linea);
    border-radius: 0;
    background: var(--crema-clara);
    font: inherit;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--tinta-fuerte);
  }
  .form input:focus-visible,
  .form select:focus-visible {
    outline: 1px solid var(--tinta-fuerte);
    outline-offset: 0;
    border-color: var(--tinta-fuerte);
  }
  .validar :invalid {
    border-color: #a33a2a;
  }
  .ayuda {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--gris);
  }
  /* Botón principal = .btn del sitio (negro, cuadrado, mayúsculas espaciadas) */
  .pildora {
    margin-top: 8px;
    padding: 15px 24px;
    border: 1px solid var(--tinta-fuerte);
    border-radius: 0;
    background: var(--tinta-fuerte);
    color: var(--crema);
    font: inherit;
    font-size: 12.9px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .pildora:hover {
    background: #000;
  }
  .pildora:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .enlace {
    align-self: center;
    padding: 4px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13px;
    color: var(--tinta);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .error,
  .ok {
    margin: 0;
    padding: 12px 16px;
    border-left: 2px solid;
    font-size: 13px;
    line-height: 1.6;
    background: var(--arena);
  }
  .error {
    border-color: #a33a2a;
    color: #7d2b1f;
  }
  .ok {
    border-color: var(--oro);
    color: var(--tinta);
  }
  .error[hidden],
  .ok[hidden] {
    display: none;
  }

  /* ---------- perfil ---------- */
  .perfil {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 104px;
    height: 104px;
    padding: 4px;
    border: 1px solid var(--oro);
    border-radius: 50%;
  }
  .avatar span {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--arena-oscura);
    color: var(--tinta-fuerte);
    font-family: var(--font-alt);
    font-weight: 400;
    font-size: 40px;
    letter-spacing: 0.04em;
  }
  .desde {
    margin: 8px 0 0;
    font-family: var(--font-alt);
    font-style: italic;
    font-size: 17px;
    color: var(--oro);
  }
