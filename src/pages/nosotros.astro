---
// Página «Nosotros» (Figma 147:4876): historia de SIRA, la diseñadora Laura Mata,
// filosofía y diseño consciente. Las anclas #disenadora, #filosofia y #consciente las usa el pie.
// Recibe `lang` por props: /en/nosotros/ reutiliza esta página con lang="en".
import { Image } from 'astro:assets';
import PaginaSira from '../layouts/PaginaSira.astro';
import type { Idioma } from '../i18n/idiomas';
import { rutasPara } from '../data/rutas';
import atelier from '../assets/sira/atelier-textiles.png';
import laura from '../assets/sira/laura-mata.png';

const { lang = 'es' } = Astro.props as { lang?: Idioma };
const rutas = rutasPara(lang);
const t = {
  es: {
    meta: 'Nosotros | SIRA Conscious Apparel',
    descripcion:
      'SIRA nace del deseo de crear piezas únicas que escapen de la producción masiva: prendas reversibles y siluetas limpias diseñadas en Costa Rica por Laura Mata.',
    historiaEtiqueta: 'SIRA · Nuestra historia',
    historia1:
      'SIRA nace del deseo de crear piezas únicas que escapen de la producción masiva. Cada diseño surge de la mezcla inesperada de textiles nuevos y recuperados, dando vida a prendas reversibles y siluetas limpias concebidas para durar.',
    historia2:
      'Diseñamos con intención: valoramos el carácter irrepetible de cada rollo de tela, el oficio de la confección local y la libertad de vestir prendas que conversan con quien las lleva.',
    altAtelier: 'Atelier y textiles SIRA',
    altLaura: 'Laura Mata, fundadora y diseñadora de SIRA',
    disenadora: 'La diseñadora',
    bio1:
      'Su trayectoria une mundos que rara vez coinciden. Con formación inicial en tecnología, el año 2000 la acercó al universo de la moda internacional a través de Miss Costa Rica y Miss Universo, despertando una sensibilidad duradera por las proporciones, la imagen y el lenguaje de los textiles.',
    bio2:
      'Posteriormente profundizó su visión cursando estudios de Personal Styling en London College of Fashion. De esa síntesis entre rigor, intuición estética y búsqueda de autenticidad nació SIRA: una casa contemporánea donde cada prenda tiene historia propia.',
    principios: 'Filosofía y diseño consciente',
    filosofiaEtiqueta: 'Nuestra filosofía',
    filosofiaTitulo: 'Menos volumen, mayor intención',
    filosofiaTexto:
      'Creemos en el lujo silencioso: piezas que no gritan por atención, pero se reconocen al instante por su textura, construcción y versatilidad.',
    conscienteEtiqueta: 'Diseño consciente',
    conscienteTitulo: 'Textiles con segunda vida',
    conscienteTexto:
      'Combinamos textiles nuevos seleccionados y remanentes recuperados en ediciones cortas y prendas reversibles, extendiendo el ciclo de vida de cada material.',
    descubrir: 'Descubrir Reversible',
  },
  en: {
    meta: 'About | SIRA Conscious Apparel',
    descripcion:
      'SIRA was born from a desire to create one-of-a-kind pieces that stand apart from mass production: reversible garments and clean silhouettes designed in Costa Rica by Laura Mata.',
    historiaEtiqueta: 'SIRA · Our story',
    historia1:
      'SIRA was born from a desire to create one-of-a-kind pieces that stand apart from mass production. Each design grows out of an unexpected pairing of new and reclaimed textiles, giving life to reversible garments and clean silhouettes made to last.',
    historia2:
      'We design with intention: we value the singular character of every bolt of fabric, the craft of local tailoring, and the freedom of wearing clothes that hold a conversation with the person who wears them.',
    altAtelier: 'The SIRA atelier and its textiles',
    altLaura: 'Laura Mata, founder and designer of SIRA',
    disenadora: 'The designer',
    bio1:
      'Her path connects worlds that rarely meet. Trained first in technology, in 2000 she was drawn into the world of international fashion through Miss Costa Rica and Miss Universe, awakening a lasting sensitivity to proportion, image and the language of textiles.',
    bio2:
      'She later deepened her vision by studying Personal Styling at London College of Fashion. From that blend of rigor, aesthetic intuition and a search for authenticity, SIRA was born: a contemporary house where every garment carries a story of its own.',
    principios: 'Philosophy and conscious design',
    filosofiaEtiqueta: 'Our philosophy',
    filosofiaTitulo: 'Less volume, more intention',
    filosofiaTexto:
      'We believe in quiet luxury: pieces that never shout for attention, yet are recognized instantly by their texture, construction and versatility.',
    conscienteEtiqueta: 'Conscious design',
    conscienteTitulo: 'Textiles with a second life',
    conscienteTexto:
      'We pair carefully selected new textiles with reclaimed remnants in short runs and reversible garments, extending the life cycle of every material.',
    descubrir: 'Discover Reversible',
  },
}[lang];
---
<PaginaSira lang={lang} title={t.meta} description={t.descripcion} activo="nosotros">
  <section class="historia contenedor-n" aria-labelledby="historia-titulo">
    <div class="historia-texto">
      <p class="etiqueta-espaciada">{t.historiaEtiqueta}</p>
      <h1 id="historia-titulo" class="serif titulo">Costa Rican Spirit.<br />Global Mindset.</h1>
      <p class="parrafo">{t.historia1}</p>
      <p class="parrafo">{t.historia2}</p>
    </div>
    <div class="foto">
      <Image
        src={atelier}
        alt={t.altAtelier}
        format="webp"
        widths={[489, 978]}
        sizes="(max-width: 760px) calc(100vw - 40px), 489px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="disenadora" id="disenadora" aria-labelledby="disenadora-titulo">
    <div class="disenadora-grid contenedor-n">
      <div class="foto foto-laura">
        <Image
          src={laura}
          alt={t.altLaura}
          format="webp"
          widths={[489, 978]}
          sizes="(max-width: 760px) calc(100vw - 40px), 489px"
        />
      </div>
      <div class="disenadora-texto">
        <p class="etiqueta-espaciada">{t.disenadora}</p>
        <h2 id="disenadora-titulo" class="serif nombre">LAURA MATA</h2>
        <p class="serif cargo">Founder &amp; Designer</p>
        <p class="parrafo">{t.bio1}</p>
        <p class="parrafo">{t.bio2}</p>
      </div>
    </div>
  </section>

  <section class="principios contenedor-n" aria-label={t.principios}>
    <article id="filosofia" class="principio">
      <p class="etiqueta-espaciada">{t.filosofiaEtiqueta}</p>
      <h2 class="serif">{t.filosofiaTitulo}</h2>
      <p class="parrafo">{t.filosofiaTexto}</p>
    </article>
    <article id="consciente" class="principio">
      <p class="etiqueta-espaciada">{t.conscienteEtiqueta}</p>
      <h2 class="serif">{t.conscienteTitulo}</h2>
      <p class="parrafo">{t.conscienteTexto}</p>
    </article>
  </section>

  <p class="descubrir">
    <a class="enlace-linea" href={rutas.reversibles}>{t.descubrir} <span aria-hidden="true">→</span></a>
  </p>
</PaginaSira>

<style>
  /* El Figma usa un contenido de 1264 px (88 px de margen en 1440). */
  .contenedor-n {
    width: min(100% - 2 * var(--margen), 1264px);
    margin-inline: auto;
  }
  .parrafo {
    margin: 24px 0 0;
    font-size: 14px;
    line-height: 2;
    letter-spacing: 0.025em;
    color: var(--gris);
  }
  .foto {
    background: var(--arena);
    aspect-ratio: 489 / 612;
    overflow: hidden;
  }
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- 1. Historia ---------- */
  .historia {
    display: grid;
    grid-template-columns: minmax(0, 600px) minmax(0, 489px);
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    padding-top: clamp(32px, 3.5vw, 51px);
  }
  .titulo {
    margin: 24px 0 0;
    font-size: clamp(40px, 4.17vw, 60px);
    line-height: 1.08;
    color: var(--tinta-fuerte);
  }

  /* ---------- 2. La diseñadora ---------- */
  .disenadora {
    margin-top: 22px;
    padding-block: clamp(56px, 8.9vw, 128px);
    background: var(--arena);
  }
  .disenadora-grid {
    display: grid;
    grid-template-columns: minmax(0, 489px) minmax(0, 600px);
    justify-content: space-between;
    align-items: center;
    gap: 48px;
  }
  .foto-laura {
    background: var(--arena-oscura);
  }
  .foto-laura :global(img) {
    object-position: 50% 20%;
  }
  .nombre {
    margin: 24px 0 0;
    font-size: clamp(36px, 3.33vw, 48px);
    line-height: 1;
    color: var(--tinta-fuerte);
  }
  .cargo {
    margin: 24px 0 0;
    font-size: 18px;
    font-style: italic;
    line-height: 28px;
    color: var(--oro);
  }

  /* ---------- 3. Filosofía y diseño consciente ---------- */
  .principios {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 80px;
    margin-top: clamp(56px, 6.7vw, 96px);
  }
  .principio {
    padding-top: 32px;
    border-top: 1px solid var(--linea);
    scroll-margin-top: 24px;
  }
  .principio h2 {
    margin: 16px 0 0;
    font-size: clamp(26px, 2.08vw, 30px);
    line-height: 1.2;
    color: var(--tinta-fuerte);
  }
  .principio .parrafo {
    margin-top: 16px;
  }
  .descubrir {
    margin: 64px 0 0;
    padding-bottom: 42px;
    text-align: center;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 900px) {
    .historia,
    .disenadora-grid {
      gap: 32px;
    }
    .principios {
      gap: 40px;
    }
  }
  @media (max-width: 760px) {
    .historia,
    .disenadora-grid,
    .principios {
      grid-template-columns: minmax(0, 1fr);
    }
    .historia .foto,
    .foto-laura {
      width: 100%;
      max-width: 489px;
    }
    .foto-laura {
      order: 0;
    }
    .principios {
      gap: 48px;
    }
    .descubrir {
      margin-top: 48px;
    }
    .disenadora {
      margin-top: 48px;
    }
  }
</style>
