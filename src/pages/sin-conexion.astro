---
// Lo que muestra la app instalada cuando no hay internet y la página pedida no está guardada.
// OJO: el service worker (src/pages/sw.js.ts) guarda esta ruta (/sin-conexion/) al instalarse.
import PaginaSira from '../layouts/PaginaSira.astro';
import { rutas } from '../data/rutas';
---
<PaginaSira title="Sin conexión | SIRA Conscious Apparel" noindex>
  <section class="mensaje" aria-labelledby="titulo-sin-conexion">
    <p class="etiqueta-espaciada">Sin internet</p>
    <h1 id="titulo-sin-conexion" class="serif">Sin conexión</h1>
    <p class="texto">
      Revise su internet. Las páginas que ya visitó se pueden abrir igual; el carrito y los pagos necesitan conexión.
    </p>
    <div class="acciones">
      <a class="btn" href={rutas.inicio}>Volver a intentar</a>
    </div>
  </section>
</PaginaSira>

<style>
  .mensaje {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100% - 2 * var(--margen), 640px);
    margin: 0 auto;
    padding: clamp(64px, 9vw, 128px) 0 clamp(72px, 9vw, 128px);
    text-align: center;
  }
  h1 {
    margin: 20px 0 0;
    font-size: clamp(40px, 4.17vw, 60px);
    line-height: 1.08;
    color: var(--tinta-fuerte);
  }
  .texto {
    margin: 20px 0 0;
    font-size: 14px;
    line-height: 2;
    letter-spacing: 0.025em;
    color: var(--gris);
  }
  .acciones {
    margin-top: 36px;
  }
</style>
