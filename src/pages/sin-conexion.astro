---
// Lo que muestra la app instalada cuando no hay internet y la página pedida no está guardada.
// OJO: el service worker (src/pages/sw.js.ts) guarda esta ruta (/sin-conexion/) al instalarse.
// Recibe `lang` por props: /en/sin-conexion/ reutiliza esta página con lang="en".
import PaginaSira from '../layouts/PaginaSira.astro';
import type { Idioma } from '../i18n/idiomas';
import { rutasPara } from '../data/rutas';

const { lang = 'es' } = Astro.props as { lang?: Idioma };
const rutas = rutasPara(lang);
const t = {
  es: {
    meta: 'Sin conexión | SIRA Conscious Apparel',
    etiqueta: 'Sin internet',
    titulo: 'Sin conexión',
    texto: 'Revise su internet. Las páginas que ya visitó se pueden abrir igual; el carrito y los pagos necesitan conexión.',
    reintentar: 'Volver a intentar',
    // Sin descripción propia: Base usa la descripción general del sitio.
    descripcion: undefined as string | undefined,
  },
  en: {
    meta: 'Offline | SIRA Conscious Apparel',
    etiqueta: 'No internet',
    titulo: 'You are offline',
    texto: 'Please check your connection. Pages you have already visited will still open; the cart and checkout need a connection.',
    reintentar: 'Try again',
    // La descripción general del sitio (la de Base) está en español.
    descripcion: 'SIRA Conscious Apparel: one-of-a-kind pieces and reversible garments, designed with intention in Costa Rica.' as string | undefined,
  },
}[lang];
---
<PaginaSira lang={lang} title={t.meta} description={t.descripcion} noindex>
  <section class="mensaje" aria-labelledby="titulo-sin-conexion">
    <p class="etiqueta-espaciada">{t.etiqueta}</p>
    <h1 id="titulo-sin-conexion" class="serif">{t.titulo}</h1>
    <p class="texto">{t.texto}</p>
    <div class="acciones">
      <a class="btn" href={rutas.inicio}>{t.reintentar}</a>
    </div>
  </section>
</PaginaSira>

<style>
  .mensaje {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(100% - 2 * var(--margen), 640px);
    margin: 0 auto;
    padding: clamp(64px, 9vw, 128px) 0 clamp(72px, 9vw, 128px);
    text-align: center;
  }
  h1 {
    margin: 20px 0 0;
    font-size: clamp(40px, 4.17vw, 60px);
    line-height: 1.08;
    color: var(--tinta-fuerte);
  }
  .texto {
    margin: 20px 0 0;
    font-size: 14px;
    line-height: 2;
    letter-spacing: 0.025em;
    color: var(--gris);
  }
  .acciones {
    margin-top: 36px;
  }
</style>
