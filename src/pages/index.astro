---
// Inicio SIRA (Figma: «SIRA · Inicio editorial · ES», 147:5070).
// Portada, manifiesto, colección actual, universo reversible, nuevas piezas (productos reales de
// WooCommerce), nuestra historia, historias y comunidad.
import PaginaSira from '../layouts/PaginaSira.astro';
import Hero from '../components/sira/inicio/Hero.astro';
import Coleccion from '../components/sira/inicio/Coleccion.astro';
import Reversible from '../components/sira/inicio/Reversible.astro';
import NuevasPiezas from '../components/sira/inicio/NuevasPiezas.astro';
import Historia from '../components/sira/inicio/Historia.astro';
import Historias from '../components/sira/inicio/Historias.astro';
import Comunidad from '../components/sira/inicio/Comunidad.astro';
import { getProductos } from '../data/tienda';
import { tienda } from '../../tienda.config';

const productos = await getProductos();

// Datos estructurados de la portada: la tienda y el sitio.
const sitio = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url).href;
const descripcion =
  'SIRA Conscious Apparel: piezas únicas y prendas reversibles diseñadas con intención desde Costa Rica.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'OnlineStore',
      name: 'SIRA Conscious Apparel',
      alternateName: tienda.marca.nombre,
      url: sitio,
      description: descripcion,
      logo: new URL('img/logo-sira.png', sitio).href,
      areaServed: 'CR',
      sameAs: tienda.seo.redes.length ? tienda.seo.redes : undefined,
    },
    { '@type': 'WebSite', name: tienda.marca.nombre, url: sitio, inLanguage: tienda.pais.locale },
  ],
};
---
<PaginaSira
  title={tienda.seo.tituloInicio || tienda.marca.nombre}
  description={descripcion}
  imagen={productos.find((p) => p.imagen)?.imagen?.src}
  jsonLd={jsonLd}
>
  <Hero />

  <section class="manifiesto" aria-label="Manifiesto de marca">
    <p class="serif">Diseño que se transforma contigo.<br />Piezas únicas, pensadas para permanecer.</p>
  </section>

  <Coleccion />
  <Reversible />
  <NuevasPiezas productos={productos} />
  <Historia />
  <Historias />
  <Comunidad />
</PaginaSira>

<style>
  /* Manifiesto (Figma: 147:5108, 1440×240): texto centrado Cormorant 38 px. */
  .manifiesto {
    display: grid;
    place-items: start center;
    min-height: 240px;
    padding: 68px var(--margen) 60px;
  }
  .manifiesto p {
    max-width: 840px;
    margin: 0;
    font-size: clamp(26px, 2.64vw, 38px);
    line-height: 1.04;
    text-align: center;
    color: var(--tinta);
  }
  @media (max-width: 700px) {
    .manifiesto {
      min-height: 0;
      padding: 56px var(--margen);
    }
    .manifiesto p {
      line-height: 1.15;
    }
  }
</style>
