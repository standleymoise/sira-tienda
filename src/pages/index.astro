---
// Inicio: la tienda con tarjetas deslizables. Si todavía no hay PUBLIC_TIENDA_URL,
// muestra cómo conectar la tienda (para que el primer build nunca falle).
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import TiendaSwipe from '../components/TiendaSwipe.astro';
import { getProductos, tiendaActiva } from '../data/tienda';
import { tienda } from '../../tienda.config';

const productos = await getProductos();

// Datos estructurados de la portada: la tienda y el sitio.
const sitio = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'OnlineStore',
      name: tienda.marca.nombre,
      url: sitio,
      description: tienda.marca.descripcion,
      logo: tienda.marca.logo ? new URL(tienda.marca.logo.replace(/^\//, ''), sitio).href : undefined,
      sameAs: tienda.seo.redes.length ? tienda.seo.redes : undefined,
    },
    { '@type': 'WebSite', name: tienda.marca.nombre, url: sitio, inLanguage: tienda.pais.locale },
  ],
};
---
<Base
  title={tienda.seo.tituloInicio || tienda.marca.nombre}
  imagen={productos[0]?.imagen?.src}
  jsonLd={jsonLd}
>
  {tiendaActiva ? (
    <TiendaSwipe productos={productos} />
  ) : (
    <main class="configurar">
      <Logo alto={48} />
      <h1>Falta conectar la tienda</h1>
      <p>
        Defina la variable <code>PUBLIC_TIENDA_URL</code> con la URL de su WordPress + WooCommerce
        (por ejemplo <code>https://tienda.midominio.com</code>) y vuelva a compilar.
      </p>
      <ul>
        <li>En su computadora: copie <code>.env.example</code> como <code>.env</code>.</li>
        <li>En GitHub: <em>Settings → Secrets and variables → Actions → Variables</em>.</li>
      </ul>
      <p>La guía completa está en el <code>README.md</code> del proyecto.</p>
    </main>
  )}
</Base>

<style>
  .configurar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 560px;
    margin: 0 auto;
    padding: 14vh 20px 40px;
    text-align: center;
    line-height: 1.6;
  }
  h1 {
    margin: 12px 0 0;
    color: var(--primario);
  }
  p,
  ul {
    margin: 0;
  }
  ul {
    text-align: left;
  }
  code {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--suave);
    color: var(--primario);
    font-size: 0.92em;
  }
</style>
