---
// Carrito y pago SIRA: /carrito/ (Figma «Carrito – 2», 147:5743), fondo blanco, sin indexar.
// Todo es real y en vivo desde la Store API de WooCommerce (carrito con Cart-Token):
//   - tabla de artículos con cantidad −/+ y quitar; «Detalles de la compra» con los totales;
//   - «Detalles de facturación y envío» + «Sumatoria de pedido» con las opciones de envío de
//     WooCommerce (POST /cart/select-shipping-rate), cupón (POST /cart/apply-coupon) y los
//     métodos de pago activos; «REALIZAR PAGO» → POST /checkout.
// WooCommerce no tiene campos para el tipo y número de identificación: van al inicio de la nota
// del pedido («Identificación: Cédula física 1-2345-6789»). Cantón → city, distrito → address_2,
// dirección → address_1.
// No se dibujan campos de tarjeta: una pasarela (p. ej. Afinia) lleva a su página segura de pago,
// así los datos de la tarjeta nunca pasan por este sitio. Se omitieron los puntos de lealtad y el
// texto de «Tienda City Mall» del Figma (no son de SIRA).
import PaginaSira from '../layouts/PaginaSira.astro';
import { getProductos, storeApiUrl } from '../data/tienda';
import { rutasPara, url } from '../data/rutas';
import type { Idioma } from '../i18n/idiomas';
import { tienda } from '../../tienda.config';

const { lang = 'es' } = Astro.props as { lang?: Idioma };
const rutas = rutasPara(lang);

// id de producto o de variación → ficha en este sitio (los enlaces del carrito van a WordPress).
const enlaces: Record<number, string> = {};
for (const p of await getProductos()) {
  enlaces[p.id] = rutas.producto(p.slug);
  for (const v of p.variaciones) enlaces[v.id] = rutas.producto(p.slug);
}

// Códigos de provincia que acepta WooCommerce para Costa Rica (SJ, AL, CG…). tienda.config.ts
// trae los de ISO (CR-SJ…): se traducen aquí; si el config ya trae los de WooCommerce, quedan igual.
const CODIGOS_WC: Record<string, string> = {
  'CR-SJ': 'SJ',
  'CR-A': 'AL',
  'CR-C': 'CG',
  'CR-H': 'HD',
  'CR-G': 'GT',
  'CR-P': 'PT',
  'CR-L': 'LM',
};
const provincias = tienda.pais.regiones.map(([codigo, nombre]) => [CODIGOS_WC[codigo] ?? codigo, nombre, codigo]);
// El valor de cada tipo de identificación queda en español (va a la nota del pedido, que lee la
// tienda); solo cambia el texto que ve el cliente.
const tiposId = ['Cédula física', 'Cédula jurídica', 'DIMEX', 'Pasaporte'];
const postal = tienda.pais.codigoPostal;

const t = {
  es: {
    meta: 'Carrito',
    descripcion: 'Su carrito de compras y el pago del pedido.',
    titulo: 'Artículos en el Carrito',
    cargando: 'Cargando su carrito…',
    vacioTitulo: 'Su carrito está vacío',
    vacioTexto: 'Descubra las piezas únicas y prendas reversibles de SIRA.',
    verTienda: 'Ver la tienda',
    gracias: 'Gracias',
    seguir: 'Seguir comprando',
    articulos: 'Artículos en su carrito',
    producto: 'Producto',
    precio: 'Precio',
    cantidad: 'Cantidad',
    quitar: 'Quitar',
    detallesCompra: 'Detalles de la compra',
    subtotal: 'Subtotal',
    envio: 'Envío',
    descuento: 'Descuento',
    impuestos: 'Impuestos',
    total: 'Total:',
    proceder: 'Proceder al pago',
    facturacion: 'Detalles de facturación y envío',
    tipoId: 'Tipo de Identificación*',
    tiposId: tiposId,
    numeroId: 'Número de Cédula / Identificación*',
    nombre: 'Nombre*',
    nombreAyuda: 'Digite su nombre aquí',
    apellidos: 'Apellidos*',
    apellidosAyuda: 'Digite sus apellidos aquí',
    correo: 'Correo*',
    correoAyuda: 'correo@mail.com',
    telefono: 'Teléfono*',
    pais: 'País*',
    region: tienda.pais.etiquetaRegion,
    elijaRegion: 'Elija su provincia',
    ciudad: tienda.pais.etiquetaCiudad,
    distrito: 'Distrito*',
    postal: 'Código postal',
    postalAyuda: postal.ayuda,
    direccion: 'Dirección*',
    direccionAyuda: 'Digite su dirección aquí',
    sumatoria: 'Sumatoria de pedido',
    cupon: 'Cupón',
    cuponPregunta: '¿Tienes un cupón?',
    cuponAbrir: 'Haz click aquí para agregar el cupón',
    cuponCodigo: 'Código del cupón',
    aplicar: 'Aplicar',
    formaPago: 'Forma de pago',
    realizar: 'REALIZAR PAGO',
  },
  en: {
    meta: 'Cart',
    descripcion: 'Your shopping cart and checkout.',
    titulo: 'Your Cart',
    cargando: 'Loading your cart…',
    vacioTitulo: 'Your cart is empty',
    vacioTexto: 'Discover SIRA’s unique pieces and reversible garments.',
    verTienda: 'Visit the shop',
    gracias: 'Thank you',
    seguir: 'Continue shopping',
    articulos: 'Items in your cart',
    producto: 'Product',
    precio: 'Price',
    cantidad: 'Quantity',
    quitar: 'Remove',
    detallesCompra: 'Cart totals',
    subtotal: 'Subtotal',
    envio: 'Shipping',
    descuento: 'Discount',
    impuestos: 'Taxes',
    total: 'Total:',
    proceder: 'Proceed to checkout',
    facturacion: 'Billing & shipping details',
    tipoId: 'ID type*',
    tiposId: ['National ID (Costa Rica)', 'Corporate ID (Costa Rica)', 'DIMEX (resident ID)', 'Passport'],
    numeroId: 'ID number*',
    nombre: 'First name*',
    nombreAyuda: 'Enter your first name',
    apellidos: 'Last name*',
    apellidosAyuda: 'Enter your last name',
    correo: 'Email*',
    correoAyuda: 'name@mail.com',
    telefono: 'Phone*',
    pais: 'Country*',
    region: 'Province',
    elijaRegion: 'Select your province',
    ciudad: 'Canton',
    distrito: 'District*',
    postal: 'Postal code',
    postalAyuda: postal.ayuda ? '5 digits' : '',
    direccion: 'Address*',
    direccionAyuda: 'Street address and directions',
    sumatoria: 'Your order',
    cupon: 'Coupon',
    cuponPregunta: 'Have a coupon?',
    cuponAbrir: 'Click here to enter your code',
    cuponCodigo: 'Coupon code',
    aplicar: 'Apply',
    formaPago: 'Payment method',
    realizar: 'PLACE ORDER',
  },
}[lang];

// Textos del script del navegador. {n}, {c}, {m}, {email}, {tel}: datos que se ponen al pintar.
// pagos: nombres de los métodos de pago (en español se usan los de tienda.config).
const tScript = {
  es: {
    lang,
    titulo: t.titulo,
    pedidoRecibido: 'Pedido recibido',
    pagos: {} as Record<string, string>,
    notas: {
      cod: 'Paga al recibir su pedido.',
      bacs: 'Al confirmar, le enviamos por correo los datos para hacer la transferencia.',
    } as Record<string, string>,
    notaPasarela: 'Se le llevará a la página segura de pago.',
    precio: 'Precio',
    cantidadDe: 'Cantidad de {n}',
    quitarUna: 'Quitar una unidad de {n}',
    agregarUna: 'Agregar una unidad de {n}',
    quitarDel: 'Quitar {n} del carrito',
    noAplica: 'No aplica',
    gratis: 'Gratis',
    segunDireccion: 'Según su dirección',
    incluidos: '(incluidos)',
    sinTarifas: 'Complete su provincia, cantón y código postal para ver las opciones de envío.',
    cuponLinea: 'Cupón «{c}»: −{m}',
    quitar: 'Quitar',
    quitarCupon: 'Quitar el cupón {c}',
    sinPagos: 'No hay formas de pago disponibles en este momento.',
    errorActualizar: 'No se pudo actualizar el carrito. Intente de nuevo.',
    aplicando: 'Aplicando…',
    cuponAplicado: 'Cupón aplicado.',
    cuponError: 'No se pudo aplicar el cupón.',
    revise: 'Revise los campos marcados: todos son obligatorios',
    postalAyuda: postal.ayuda ? ` (código postal: ${postal.ayuda})` : '',
    enviando: 'Enviando…',
    abriendo: 'Abriendo el pago seguro…',
    graciasPedido: 'Gracias, pedido #{n}',
    textoBacs: 'Su pedido quedó registrado. Le enviamos a {email} los datos para hacer la transferencia.',
    textoPedido: 'Su pedido quedó registrado. Le confirmaremos la entrega a {email} o al {tel}.',
    errorPedido: 'No se pudo enviar el pedido. Intente de nuevo.',
    realizar: t.realizar,
    pagoNoCompletado: 'El pago del pedido #{n} no se completó',
    pagoAprobado: 'Su pago con tarjeta fue aprobado. Le enviamos la confirmación por correo.',
    pagoNoConfirmado: 'Afinia no confirmó el pago. Puede intentarlo de nuevo desde su carrito o escribirnos y le ayudamos.',
    errorCargar: 'No se pudo cargar el carrito: ',
  },
  en: {
    lang,
    titulo: t.titulo,
    pedidoRecibido: 'Order received',
    pagos: {
      afinia_gateway: 'Credit or debit card',
      cod: 'Cash on delivery',
      bacs: 'Bank transfer',
      cheque: 'Check',
    } as Record<string, string>,
    notas: {
      cod: 'Pay when your order arrives.',
      bacs: 'Once you place your order, we’ll email you the bank transfer details.',
    } as Record<string, string>,
    notaPasarela: 'You’ll be taken to a secure payment page.',
    precio: 'Price',
    cantidadDe: 'Quantity of {n}',
    quitarUna: 'Remove one {n}',
    agregarUna: 'Add one more {n}',
    quitarDel: 'Remove {n} from cart',
    noAplica: 'Not applicable',
    gratis: 'Free',
    segunDireccion: 'Calculated from your address',
    incluidos: '(included)',
    sinTarifas: 'Enter your province, canton and postal code to see shipping options.',
    cuponLinea: 'Coupon “{c}”: −{m}',
    quitar: 'Remove',
    quitarCupon: 'Remove coupon {c}',
    sinPagos: 'No payment methods are available right now.',
    errorActualizar: 'We couldn’t update your cart. Please try again.',
    aplicando: 'Applying…',
    cuponAplicado: 'Coupon applied.',
    cuponError: 'We couldn’t apply this coupon.',
    revise: 'Please review the highlighted fields: all are required',
    postalAyuda: postal.ayuda ? ' (postal code: 5 digits)' : '',
    enviando: 'Sending…',
    abriendo: 'Opening secure payment…',
    graciasPedido: 'Thank you — order #{n}',
    textoBacs: 'Your order has been placed. We’ve emailed the bank transfer details to {email}.',
    textoPedido: 'Your order has been placed. We’ll confirm delivery by email at {email} or by phone at {tel}.',
    errorPedido: 'We couldn’t place your order. Please try again.',
    realizar: t.realizar,
    pagoNoCompletado: 'Payment for order #{n} was not completed',
    pagoAprobado: 'Your card payment was approved. A confirmation is on its way to your inbox.',
    pagoNoConfirmado: 'Afinia did not confirm the payment. You can try again from your cart, or write to us and we’ll help.',
    errorCargar: 'We couldn’t load your cart: ',
  },
}[lang];
---
<PaginaSira
  lang={lang}
  title={`${t.meta} | ${tienda.marca.nombre}`}
  description={t.descripcion}
  noindex
  activo="tienda"
  fondo="blanco"
>
  <div
    class="compra"
    data-compra
    data-api={storeApiUrl}
    data-enlaces={JSON.stringify(enlaces)}
    data-provincias={JSON.stringify(provincias.map(([wc, , iso]) => [iso, wc]))}
    data-basurero={url('/img/icono-basurero.svg')}
    data-textos={JSON.stringify(tScript)}
    style={`--flecha: url(${url('/img/icono-flecha-abajo.svg')})`}
  >
    <h1 class="titulo serif" data-titulo>{t.titulo}</h1>

    <p class="cargando" data-cargando role="status">{t.cargando}</p>

    <div class="mensaje" data-vacio hidden>
      <p class="mensaje-titulo serif">{t.vacioTitulo}</p>
      <p>{t.vacioTexto}</p>
      <a class="boton-oro" href={rutas.productos}>{t.verTienda}</a>
    </div>

    <div class="mensaje" data-gracias hidden tabindex="-1">
      <p class="mensaje-titulo serif" data-gracias-titulo>{t.gracias}</p>
      <p data-gracias-texto></p>
      <a class="boton-oro" href={rutas.productos}>{t.seguir}</a>
    </div>

    <p class="error-general" data-error-general role="alert" hidden></p>

    <div class="lleno" data-lleno hidden>
      <!-- Fila 1: artículos + detalles de la compra -->
      <div class="fila fila-carrito">
        <div class="tabla-marco">
          <table class="tabla">
            <caption class="sr-only">{t.articulos}</caption>
            <thead>
              <tr>
                <th scope="col" class="col-producto">{t.producto}</th>
                <th scope="col">{t.precio}</th>
                <th scope="col">{t.cantidad}</th>
                <th scope="col"><span class="sr-only">{t.quitar}</span></th>
              </tr>
            </thead>
            <tbody data-items></tbody>
          </table>
        </div>

        <aside class="detalles-compra" aria-labelledby="titulo-detalles-compra">
          <h2 id="titulo-detalles-compra">{t.detallesCompra}</h2>
          <dl class="totales">
            <div><dt>{t.subtotal}</dt><dd data-t-subtotal></dd></div>
            <div class="normal"><dt>{t.envio}</dt><dd data-t-envio></dd></div>
            <div data-fila-descuento hidden><dt>{t.descuento}</dt><dd data-t-descuento></dd></div>
            <div data-fila-impuestos><dt>{t.impuestos}</dt><dd data-t-impuestos></dd></div>
            <div class="total"><dt>{t.total}</dt><dd data-t-total></dd></div>
          </dl>
          <a class="boton-oro ancho" href="#facturacion" data-ir-pago>{t.proceder}</a>
        </aside>
      </div>

      <!-- Fila 2: facturación y envío + sumatoria y pago -->
      <form class="fila fila-pago" id="facturacion" data-form novalidate>
        <div class="campos">
          <h2>{t.facturacion}</h2>

          <label class="campo">
            <span>{t.tipoId}</span>
            <select name="tipo_id" required>
              {tiposId.map((v, i) => <option value={v}>{t.tiposId[i]}</option>)}
            </select>
          </label>
          <label class="campo">
            <span>{t.numeroId}</span>
            <input name="numero_id" required minlength="5" placeholder="12345678" autocomplete="off" />
          </label>
          <label class="campo">
            <span>{t.nombre}</span>
            <input name="first_name" required placeholder={t.nombreAyuda} autocomplete="given-name" />
          </label>
          <label class="campo">
            <span>{t.apellidos}</span>
            <input name="last_name" required placeholder={t.apellidosAyuda} autocomplete="family-name" />
          </label>
          <label class="campo">
            <span>{t.correo}</span>
            <input name="email" type="email" required placeholder={t.correoAyuda} autocomplete="email" />
          </label>
          <label class="campo">
            <span>{t.telefono}</span>
            <input name="phone" type="tel" required placeholder="8888 8888" autocomplete="tel" />
          </label>
          <label class="campo">
            <span>{t.pais}</span>
            <select name="country" required>
              <option value={tienda.pais.codigo}>Costa Rica</option>
            </select>
          </label>
          <label class="campo">
            <span>{t.region}*</span>
            <select name="state" required data-envio>
              <option value="">{t.elijaRegion}</option>
              {provincias.map(([codigo, nombre]) => <option value={codigo}>{nombre}</option>)}
            </select>
          </label>
          <label class="campo">
            <span>{t.ciudad}*</span>
            <input name="city" required placeholder="Curridabat" autocomplete="address-level2" data-envio />
          </label>
          <label class="campo">
            <span>{t.distrito}</span>
            <input name="address_2" required placeholder="Granadilla" autocomplete="address-level3" />
          </label>
          <label class="campo">
            <span>{t.postal}{postal.requerido ? '*' : ''}</span>
            <input
              name="postcode"
              required={postal.requerido}
              pattern={postal.patron || undefined}
              inputmode="numeric"
              placeholder={t.postalAyuda || ''}
              autocomplete="postal-code"
              data-envio
            />
          </label>
          <label class="campo">
            <span>{t.direccion}</span>
            <input name="address_1" required placeholder={t.direccionAyuda} autocomplete="street-address" />
          </label>
        </div>

        <div class="sumatoria">
          <section class="caja caja-pedido" aria-labelledby="titulo-sumatoria">
            <h2 id="titulo-sumatoria" class="titulo-oro">{t.sumatoria}</h2>
            <div class="par cabeza"><span>{t.producto}</span><span>{t.subtotal}</span></div>
            <ul class="lineas" data-lineas></ul>
            <div class="par fuerte"><span>{t.subtotal}</span><span data-s-subtotal></span></div>
            <fieldset class="envio" data-envio-caja>
              <legend>{t.envio}</legend>
              <div class="tarifas" data-tarifas></div>
            </fieldset>
            <div class="par" data-s-fila-descuento hidden><span>{t.descuento}</span><span data-s-descuento></span></div>
            <div class="par" data-s-fila-impuestos><span>{t.impuestos}</span><span data-s-impuestos></span></div>
            <div class="par fuerte total"><span>{t.total}</span><span data-s-total></span></div>
          </section>

          <section class="caja caja-cupon" aria-label={t.cupon}>
            <p class="cupon-pregunta">
              <span>{t.cuponPregunta}</span>
              <button type="button" class="enlace-cupon" data-abrir-cupon aria-expanded="false" aria-controls="cupon-campos">
                {t.cuponAbrir}
              </button>
            </p>
            <div class="cupon-campos" id="cupon-campos" data-cupon-campos hidden>
              <label class="sr-only" for="cupon">{t.cuponCodigo}</label>
              <input id="cupon" data-cupon placeholder={t.cuponCodigo} autocomplete="off" />
              <button type="button" class="aplicar" data-aplicar>{t.aplicar}</button>
            </div>
            <ul class="cupones" data-cupones></ul>
            <p class="cupon-aviso" data-cupon-aviso role="status" aria-live="polite"></p>
          </section>

          <section class="caja caja-pago">
            <fieldset class="pagos">
              <legend>{t.formaPago}</legend>
              <div data-metodos></div>
            </fieldset>
            <p class="nota-pago" data-nota-pago></p>
          </section>

          <p class="error" data-error role="alert" hidden></p>
          <button type="submit" class="boton-oro ancho realizar" data-enviar>{t.realizar}</button>
        </div>
      </form>
    </div>
  </div>
</PaginaSira>

<script>
  import { tienda } from '../../tienda.config';
  import { crearCliente, formato, leerPerfil } from '../scripts/tienda-api';

  // ---------- tipos de la Store API (lo que usa esta página) ----------
  type Monto = { currency_code: string; currency_minor_unit: number };
  type Item = {
    key: string;
    id: number;
    name: string;
    quantity: number;
    quantity_limits?: { minimum: number; maximum: number; editable: boolean };
    variation?: { attribute: string; value: string }[];
    images: { thumbnail?: string; src?: string; alt?: string }[];
    prices?: Monto & { price: string };
    totals: Monto & { line_total: string; line_total_tax?: string };
  };
  type Tarifa = Monto & { rate_id: string; name: string; price: string; taxes?: string; selected: boolean };
  type Paquete = { package_id: number; name: string; shipping_rates: Tarifa[] };
  type CarritoC = {
    items: Item[];
    items_count: number;
    needs_shipping?: boolean;
    shipping_rates?: Paquete[];
    coupons?: { code: string; totals: Monto & { total_discount: string; total_discount_tax?: string } }[];
    payment_methods: string[];
    totals: Monto & {
      total_price: string;
      total_items?: string;
      total_items_tax?: string;
      total_shipping?: string | null;
      total_shipping_tax?: string | null;
      total_tax?: string;
      total_discount?: string;
      total_discount_tax?: string;
    };
  };

  // Métodos que no son pasarela (se pagan fuera de línea); los demás llevan a una página de pago.
  const FUERA_DE_LINEA = ['cod', 'bacs', 'cheque'];
  // Nombre de respaldo para pasarelas que no están en tienda.pagos.
  const NOMBRES_RESPALDO: Record<string, string> = { afinia_gateway: 'Tarjeta de crédito o débito' };
  const nombrePago = (id: string) => tienda.pagos[id] ?? NOMBRES_RESPALDO[id] ?? id;

  // Textos de la página en su idioma (vienen del HTML: data-textos).
  type Textos = Record<string, string> & { pagos: Record<string, string>; notas: Record<string, string> };
  /** Pone los datos en un texto: llenar('Pedido #{n}', { n: 12 }) → «Pedido #12». */
  const llenar = (texto: string, datos: Record<string, string | number>) =>
    texto.replace(/\{(\w+)\}/g, (_, k) => String(datos[k] ?? ''));

  const raiz = document.querySelector<HTMLElement>('[data-compra]');
  if (raiz) iniciar(raiz);

  function iniciar(raiz: HTMLElement) {
    const cliente = crearCliente(raiz.dataset.api!);
    const enlaces: Record<string, string> = JSON.parse(raiz.dataset.enlaces || '{}');
    const isoAWc = Object.fromEntries(JSON.parse(raiz.dataset.provincias || '[]')) as Record<string, string>;
    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => raiz.querySelector<T>(sel)!;
    const form = $<HTMLFormElement>('[data-form]');
    const T: Textos = JSON.parse(raiz.dataset.textos || '{}');
    let carrito: CarritoC | null = null;
    let ocupado = false;

    const decodificar = (s: string) => new DOMParser().parseFromString(s, 'text/html').body.textContent?.trim() ?? s;
    const suma = (...v: (string | null | undefined)[]) => String(v.reduce((a, b) => a + Number(b || 0), 0));
    const avisarEncabezado = (n: number) => dispatchEvent(new CustomEvent('sira:carrito', { detail: n }));

    // ---------- vistas ----------
    function vista(cual: 'cargando' | 'vacio' | 'lleno' | 'gracias') {
      $('[data-cargando]').hidden = cual !== 'cargando';
      $('[data-vacio]').hidden = cual !== 'vacio';
      $('[data-lleno]').hidden = cual !== 'lleno';
      $('[data-gracias]').hidden = cual !== 'gracias';
      $('[data-titulo]').textContent = cual === 'gracias' ? T.pedidoRecibido : T.titulo;
    }
    function errorGeneral(texto: string) {
      const e = $('[data-error-general]');
      e.textContent = texto;
      e.hidden = !texto;
    }

    // ---------- pintar ----------
    function usar(c: CarritoC) {
      carrito = c;
      avisarEncabezado(c.items_count);
      if (!c.items.length) {
        vista('vacio');
        return;
      }
      vista('lleno');
      pintarItems(c);
      pintarTotales(c);
      pintarEnvio(c);
      pintarCupones(c);
      pintarPagos(c);
    }

    function pintarItems(c: CarritoC) {
      const cuerpo = $('[data-items]');
      const lineas = $('[data-lineas]');
      cuerpo.replaceChildren();
      lineas.replaceChildren();
      for (const it of c.items) {
        const nombre = decodificar(it.name);
        const opciones = (it.variation ?? []).map((v) => `${decodificar(v.attribute)}: ${decodificar(v.value)}`).join(' · ');
        const lineaTotal = suma(it.totals.line_total, it.totals.line_total_tax);
        const unitario = it.prices?.price ?? String(Math.round(Number(lineaTotal) / Math.max(1, it.quantity)));
        const m = it.prices ?? it.totals;
        const max = it.quantity_limits?.maximum ?? 9999;
        const editable = it.quantity_limits?.editable ?? true;

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="col-producto">
            <div class="producto">
              <span class="miniatura"></span>
              <div class="producto-texto"><a class="producto-nombre"></a><span class="producto-opciones"></span></div>
            </div>
          </td>
          <td class="col-precio"><span class="etiqueta-movil"></span><span class="valor"></span></td>
          <td class="col-cantidad">
            <div class="cantidad" role="group">
              <button type="button" class="menos">−</button>
              <span class="numero" aria-live="polite"></span>
              <button type="button" class="mas">+</button>
            </div>
          </td>
          <td class="col-quitar"><button type="button" class="quitar"><img alt="" width="18" height="18" /></button></td>`;
        const img = it.images?.[0]?.thumbnail || it.images?.[0]?.src;
        if (img) {
          const el = document.createElement('img');
          el.src = img;
          el.alt = '';
          el.width = 82;
          el.height = 82;
          el.loading = 'lazy';
          tr.querySelector('.miniatura')!.append(el);
        }
        const a = tr.querySelector<HTMLAnchorElement>('.producto-nombre')!;
        a.textContent = nombre;
        if (enlaces[it.id]) a.href = enlaces[it.id];
        tr.querySelector('.producto-opciones')!.textContent = opciones;
        tr.querySelector('.col-precio .etiqueta-movil')!.textContent = T.precio;
        tr.querySelector('.col-precio .valor')!.textContent = formato(unitario, m);
        tr.querySelector('.numero')!.textContent = String(it.quantity);
        tr.querySelector('.cantidad')!.setAttribute('aria-label', llenar(T.cantidadDe, { n: nombre }));
        const menos = tr.querySelector<HTMLButtonElement>('.menos')!;
        const mas = tr.querySelector<HTMLButtonElement>('.mas')!;
        const quitar = tr.querySelector<HTMLButtonElement>('.quitar')!;
        menos.setAttribute('aria-label', llenar(T.quitarUna, { n: nombre }));
        mas.setAttribute('aria-label', llenar(T.agregarUna, { n: nombre }));
        quitar.setAttribute('aria-label', llenar(T.quitarDel, { n: nombre }));
        quitar.querySelector('img')!.src = raiz.dataset.basurero!;
        menos.disabled = !editable || it.quantity <= 1;
        mas.disabled = !editable || it.quantity >= max;
        menos.addEventListener('click', () => cambiar(it.key, it.quantity - 1));
        mas.addEventListener('click', () => cambiar(it.key, it.quantity + 1));
        quitar.addEventListener('click', () => cambiar(it.key, 0));
        cuerpo.append(tr);

        const li = document.createElement('li');
        li.className = 'par linea';
        const t = document.createElement('span');
        t.textContent = `${it.quantity} × ${nombre}${opciones ? ` (${opciones})` : ''}`;
        const v = document.createElement('span');
        v.textContent = formato(lineaTotal, it.totals);
        li.append(t, v);
        lineas.append(li);
      }
    }

    function tarifaElegida(c: CarritoC) {
      const tarifas = (c.shipping_rates ?? []).flatMap((p) => p.shipping_rates);
      return tarifas.find((t) => t.selected) ?? null;
    }

    function pintarTotales(c: CarritoC) {
      const t = c.totals;
      const subtotal =
        t.total_items !== undefined
          ? suma(t.total_items, t.total_items_tax)
          : suma(...c.items.map((i) => suma(i.totals.line_total, i.totals.line_total_tax)));
      const descuento = suma(t.total_discount, t.total_discount_tax);
      const elegida = tarifaElegida(c);
      let envio: string;
      if (c.needs_shipping === false) envio = T.noAplica;
      else if (elegida) envio = Number(suma(elegida.price, elegida.taxes)) === 0 ? T.gratis : formato(suma(t.total_shipping, t.total_shipping_tax), t);
      else envio = T.segunDireccion;
      const conImpuestos = t.total_tax !== undefined;
      const valores: Record<string, string> = {
        subtotal: formato(subtotal, t),
        envio,
        descuento: `−${formato(descuento, t)}`,
        impuestos: conImpuestos ? `${formato(t.total_tax!, t)} ${T.incluidos}` : '',
        total: formato(t.total_price, t),
      };
      for (const [k, v] of Object.entries(valores)) {
        $(`[data-t-${k}]`).textContent = v;
        const s = raiz.querySelector<HTMLElement>(`[data-s-${k}]`);
        if (s) s.textContent = v;
      }
      $('[data-fila-descuento]').hidden = $('[data-s-fila-descuento]').hidden = Number(descuento) <= 0;
      $('[data-fila-impuestos]').hidden = $('[data-s-fila-impuestos]').hidden = !conImpuestos || Number(t.total_tax) === 0;
    }

    function pintarEnvio(c: CarritoC) {
      const caja = $<HTMLFieldSetElement>('[data-envio-caja]');
      const cont = $('[data-tarifas]');
      caja.hidden = c.needs_shipping === false;
      cont.replaceChildren();
      const paquetes = (c.shipping_rates ?? []).filter((p) => p.shipping_rates.length);
      if (!paquetes.length) {
        const p = document.createElement('p');
        p.className = 'sin-tarifas';
        p.textContent = T.sinTarifas;
        cont.append(p);
        return;
      }
      for (const paq of paquetes) {
        for (const r of paq.shipping_rates) {
          const label = document.createElement('label');
          label.className = 'tarifa';
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = `envio-${paq.package_id}`;
          input.value = r.rate_id;
          input.checked = r.selected;
          input.addEventListener('change', () =>
            actualizar(() => cliente.api<CarritoC>('/cart/select-shipping-rate', { package_id: paq.package_id, rate_id: r.rate_id })),
          );
          const precio = Number(suma(r.price, r.taxes));
          const texto = document.createElement('span');
          texto.textContent = `${decodificar(r.name)} · ${precio === 0 ? T.gratis : formato(String(precio), r)}`;
          label.append(input, texto);
          cont.append(label);
        }
      }
    }

    function pintarCupones(c: CarritoC) {
      const lista = $('[data-cupones]');
      lista.replaceChildren();
      for (const cu of c.coupons ?? []) {
        const li = document.createElement('li');
        const t = document.createElement('span');
        t.textContent = llenar(T.cuponLinea, {
          c: cu.code,
          m: formato(suma(cu.totals.total_discount, cu.totals.total_discount_tax), cu.totals),
        });
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'quitar-cupon';
        b.textContent = T.quitar;
        b.setAttribute('aria-label', llenar(T.quitarCupon, { c: cu.code }));
        b.addEventListener('click', () => actualizar(() => cliente.api<CarritoC>('/cart/remove-coupon', { code: cu.code })));
        li.append(t, b);
        lista.append(li);
      }
    }

    function pintarPagos(c: CarritoC) {
      const cont = $('[data-metodos]');
      const antes = form.querySelector<HTMLInputElement>('input[name="payment_method"]:checked')?.value;
      cont.replaceChildren();
      if (!c.payment_methods.length) {
        cont.textContent = T.sinPagos;
      }
      c.payment_methods.forEach((m, i) => {
        const label = document.createElement('label');
        label.className = 'tarifa';
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'payment_method';
        input.value = m;
        input.required = true;
        input.checked = antes ? antes === m : i === 0;
        input.addEventListener('change', notaPago);
        const t = document.createElement('span');
        t.textContent = T.pagos?.[m] ?? nombrePago(m);
        label.append(input, t);
        cont.append(label);
      });
      if (!cont.querySelector('input:checked')) cont.querySelector<HTMLInputElement>('input')?.click();
      notaPago();
    }
    function notaPago() {
      const m = form.querySelector<HTMLInputElement>('input[name="payment_method"]:checked')?.value ?? '';
      $('[data-nota-pago]').textContent = !m
        ? ''
        : FUERA_DE_LINEA.includes(m)
          ? (T.notas[m] ?? '')
          : T.notaPasarela;
    }

    // ---------- acciones ----------
    async function actualizar(accion: () => Promise<CarritoC>) {
      if (ocupado) return;
      ocupado = true;
      raiz.setAttribute('aria-busy', 'true');
      errorGeneral('');
      try {
        usar(await accion());
      } catch (e) {
        errorGeneral((e as Error).message || T.errorActualizar);
        if (carrito) usar(carrito);
      } finally {
        ocupado = false;
        raiz.removeAttribute('aria-busy');
      }
    }
    const cambiar = (key: string, cantidad: number) => actualizar(() => cliente.cambiar(key, cantidad) as Promise<CarritoC>);

    // Envío: al cambiar provincia, cantón o código postal se le pasa la dirección a WooCommerce,
    // que devuelve las tarifas de esa zona.
    let espera: ReturnType<typeof setTimeout> | undefined;
    const valor = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement | null)?.value.trim() ?? '';
    function direccion() {
      return {
        first_name: valor('first_name'),
        last_name: valor('last_name'),
        company: '',
        address_1: valor('address_1'),
        address_2: valor('address_2'),
        city: valor('city'),
        state: valor('state'),
        postcode: valor('postcode'),
        country: valor('country') || tienda.pais.codigo,
        phone: valor('phone'),
      };
    }
    function enviarDireccion() {
      clearTimeout(espera);
      espera = setTimeout(() => {
        if (!valor('state')) return;
        const d = direccion();
        actualizar(() =>
          cliente.api<CarritoC>('/cart/update-customer', {
            shipping_address: { country: d.country, state: d.state, city: d.city, postcode: d.postcode },
          }),
        );
      }, 500);
    }
    form.querySelectorAll('[data-envio]').forEach((el) => el.addEventListener('change', enviarDireccion));

    // Cupón
    const abrirCupon = $<HTMLButtonElement>('[data-abrir-cupon]');
    const campoCupon = $<HTMLInputElement>('[data-cupon]');
    const avisoCupon = $('[data-cupon-aviso]');
    abrirCupon.addEventListener('click', () => {
      const abrir = $('[data-cupon-campos]').hidden;
      $('[data-cupon-campos]').hidden = !abrir;
      abrirCupon.setAttribute('aria-expanded', String(abrir));
      if (abrir) campoCupon.focus();
    });
    async function aplicarCupon() {
      const code = campoCupon.value.trim();
      if (!code || ocupado) return;
      avisoCupon.textContent = T.aplicando;
      ocupado = true;
      try {
        usar(await cliente.api<CarritoC>('/cart/apply-coupon', { code }));
        avisoCupon.textContent = T.cuponAplicado;
        campoCupon.value = '';
      } catch (e) {
        avisoCupon.textContent = (e as Error).message || T.cuponError;
      } finally {
        ocupado = false;
      }
    }
    $('[data-aplicar]').addEventListener('click', aplicarCupon);
    campoCupon.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        aplicarCupon();
      }
    });

    // «Proceder al pago»: baja al formulario y pone el foco en el primer campo.
    $('[data-ir-pago]').addEventListener('click', (e) => {
      e.preventDefault();
      form.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      form.querySelector<HTMLElement>('select, input')?.focus({ preventScroll: true });
    });

    // ---------- pago ----------
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const error = $('[data-error]');
      const enviar = $<HTMLButtonElement>('[data-enviar]');
      if (!form.checkValidity()) {
        error.textContent = `${T.revise}${T.postalAyuda}.`;
        error.hidden = false;
        form.classList.add('validar');
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      const d = direccion();
      const metodo = valor('payment_method') || form.querySelector<HTMLInputElement>('input[name="payment_method"]:checked')?.value || '';
      const email = valor('email');
      error.hidden = true;
      enviar.disabled = true;
      enviar.textContent = T.enviando;
      try {
        const r = await cliente.api<{ order_id: number; status: string; payment_result?: { redirect_url?: string } }>(
          '/checkout',
          {
            billing_address: { ...d, email },
            shipping_address: d,
            payment_method: metodo,
            payment_data: [],
            // WooCommerce no tiene campos de identificación: van al inicio de la nota del pedido.
            customer_note: `Identificación: ${valor('tipo_id')} ${valor('numero_id')}`,
            // Pedido hecho desde /en/: el plugin sira-afinia-astro lo guarda en el pedido para que,
            // al volver de Afinia, el cliente llegue al «Gracias» en inglés (/en/carrito/).
            ...(T.lang === 'en' ? { sira_idioma: 'en' } : {}),
          },
        );
        // Una pasarela lleva a su página segura de pago (otra página que no es la de «pedido recibido»).
        const destino = r.payment_result?.redirect_url ?? '';
        const esPaginaPropia = !destino || /order-received|pedido-recibido/.test(destino);
        if (!esPaginaPropia) {
          enviar.textContent = T.abriendo;
          // Afinia: directo a su página segura, sin pasar por la página de pago de WordPress.
          // Si algo falla, se usa la página de WordPress (el pago igual se puede completar ahí).
          if (metodo === 'afinia_gateway') await pagarConAfinia(destino).catch(() => (location.href = destino));
          else location.href = destino;
          return;
        }
        avisarEncabezado(0);
        $('[data-gracias-titulo]').textContent = llenar(T.graciasPedido, { n: r.order_id });
        $('[data-gracias-texto]').textContent = llenar(metodo === 'bacs' ? T.textoBacs : T.textoPedido, {
          email,
          tel: d.phone,
        });
        vista('gracias');
        form.reset();
        form.classList.remove('validar');
        $('[data-gracias]').focus();
        scrollTo({ top: 0 });
      } catch (err) {
        error.textContent = (err as Error).message || T.errorPedido;
        error.hidden = false;
        // El carrito pudo cambiar (stock, precios): se vuelve a leer.
        cliente.api<CarritoC>('/cart').then(usar).catch(() => {});
      } finally {
        enviar.disabled = false;
        enviar.textContent = T.realizar;
      }
    });

    // ---------- Afinia directo ----------
    // Mismos datos que la página de pago de WordPress le pasa al script de Afinia; los entrega el plugin
    // wordpress/plugins/sira-afinia-astro.php solo con la clave del pedido. La tarjeta se escribe en la
    // página segura de Afinia; el sitio nunca la ve.
    const cargarScript = (src: string, listo: () => unknown) =>
      new Promise<void>((ok, mal) => {
        if (listo()) return ok();
        const s = document.createElement('script');
        s.src = src;
        s.onload = () => (listo() ? ok() : mal(new Error('script')));
        s.onerror = () => mal(new Error('script'));
        document.head.append(s);
      });

    async function pagarConAfinia(destino: string) {
      const u = new URL(destino);
      const id = u.pathname.match(/order-pay\/(\d+)/)?.[1] ?? u.searchParams.get('order-pay');
      const key = u.searchParams.get('key');
      if (!id || !key) throw new Error('sin datos del pedido');
      const wp = raiz.dataset.api!.replace(/\/wc\/store\/v1\/?$/, '');
      const r = await fetch(`${wp}/sira/v1/afinia/${id}?key=${encodeURIComponent(key)}`);
      if (!r.ok) throw new Error(`Afinia ${r.status}`);
      const c = (await r.json()) as {
        apikey: string; email: string; moneda: string; monto: string;
        referencia: string; referencia2: string; script: string;
      };
      type Afinia = ((cb: (res: { Error?: string; Url?: string }[]) => void) => void) & { setup: Record<string, string> };
      const w = window as unknown as { jQuery?: { fn?: { AFINIA_PaymentGateway?: Afinia } } };
      // El script de Afinia es un plugin de jQuery.
      await cargarScript('https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js', () => w.jQuery);
      await cargarScript(c.script, () => w.jQuery?.fn?.AFINIA_PaymentGateway);
      const pg = w.jQuery!.fn!.AFINIA_PaymentGateway!;
      Object.assign(pg.setup, {
        Apikey: c.apikey,
        Email: c.email,
        Currency: c.moneda,
        Totalamount: c.monto,
        Reference: c.referencia,
        Reference2: c.referencia2,
        Version: 'WC2.0',
      });
      const url = await new Promise<string>((ok, mal) => {
        const t = setTimeout(() => mal(new Error('Afinia no respondió')), 20000);
        pg((res) => {
          clearTimeout(t);
          const x = res?.[0];
          if (x?.Url) ok(x.Url);
          else mal(new Error(x?.Error || 'Afinia no devolvió la página de pago'));
        });
      });
      avisarEncabezado(0);
      location.replace(url);
    }

    // ---------- regreso desde Afinia ----------
    // El plugin de WordPress trae al cliente aquí con ?pedido=<n>&estado=ok|<estado>.
    const regreso = new URLSearchParams(location.search);
    if (regreso.get('pedido')) {
      const n = regreso.get('pedido');
      const ok = regreso.get('estado') === 'ok';
      avisarEncabezado(0);
      $('[data-gracias-titulo]').textContent = llenar(ok ? T.graciasPedido : T.pagoNoCompletado, { n: n ?? '' });
      $('[data-gracias-texto]').textContent = ok ? T.pagoAprobado : T.pagoNoConfirmado;
      vista('gracias');
      history.replaceState(null, '', location.pathname);
      return;
    }

    // ---------- inicio ----------
    // Con sesión, se llenan los campos con los datos guardados de la cuenta.
    const perfil = leerPerfil();
    if (perfil) {
      const campos: Record<string, string> = {
        first_name: perfil.nombre,
        last_name: perfil.apellidos,
        email: perfil.email,
        phone: perfil.telefono,
        state: isoAWc[perfil.provincia] ?? perfil.provincia,
        city: perfil.ciudad,
        postcode: perfil.postal,
        address_1: perfil.direccion,
      };
      for (const [n, v] of Object.entries(campos)) {
        const el = form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement | null;
        if (el && v) el.value = v;
      }
    }

    if (!cliente.tieneCarrito()) {
      // Sin carrito todavía: no se crea uno solo por abrir la página.
      vista('vacio');
      avisarEncabezado(0);
      return;
    }
    cliente
      .api<CarritoC>('/cart')
      .then((c) => {
        usar(c);
        if (valor('state')) enviarDireccion();
      })
      .catch((e) => {
        vista('vacio');
        errorGeneral(`${T.errorCargar}${(e as Error).message}`);
      });
  }
</script>

<style>
  .compra {
    width: min(100% - 2 * var(--margen), 1312px);
    margin-inline: auto;
    padding: clamp(24px, 4.1vw, 59px) 0 clamp(48px, 3.5vw, 50px);
    color: #0f0f0f;
  }
  .compra[aria-busy='true'] .lleno {
    cursor: progress;
  }
  .titulo {
    margin: 0 0 clamp(18px, 2.2vw, 31px);
    font-size: clamp(30px, 2.8vw, 40px);
    line-height: 1.5;
    color: var(--tinta-fuerte);
  }
  .cargando {
    font-size: 15px;
    color: #6a635c;
  }

  /* ---------- botón dorado (Figma: #ceb04e, radio 9) ---------- */
  .boton-oro {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 32px;
    border: 0;
    border-radius: 9px;
    background: var(--oro-boton);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 15.7px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .boton-oro:hover:not([disabled]) {
    background: #b89a3d;
  }
  .boton-oro[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .boton-oro.ancho {
    width: 100%;
  }

  /* ---------- mensajes: vacío y gracias ---------- */
  .mensaje {
    max-width: 640px;
    padding: clamp(32px, 5vw, 56px) clamp(20px, 4vw, 48px);
    border-radius: 9px;
    background: #f8f8f8;
    font-size: 15px;
    line-height: 1.7;
    color: #333;
  }
  .mensaje:focus {
    outline: none;
  }
  .mensaje-titulo {
    margin: 0 0 6px;
    font-size: clamp(26px, 2.2vw, 32px);
    line-height: 1.3;
    color: var(--tinta-fuerte);
  }
  .mensaje .boton-oro {
    margin-top: 18px;
  }
  .error-general,
  .error {
    margin: 0 0 16px;
    padding: 12px 16px;
    border-radius: 9px;
    background: #fbeeec;
    color: #8a2c1f;
    font-size: 14px;
    line-height: 1.5;
  }

  /* ---------- filas ---------- */
  .fila {
    display: grid;
    gap: 33px;
    align-items: start;
  }
  @media (min-width: 1100px) {
    .fila-carrito {
      grid-template-columns: minmax(0, 800px) minmax(0, 485px);
    }
    .fila-pago {
      grid-template-columns: minmax(0, 749px) minmax(0, 510px);
      gap: 41px;
      padding-inline: 6px;
    }
  }
  .fila-pago {
    margin-top: clamp(40px, 2.5vw, 36px);
    scroll-margin-top: 24px;
  }

  /* ---------- tabla de artículos (Figma: 800 px, borde #b7b7b7, radio 9) ---------- */
  .tabla-marco {
    border: 1px solid #b7b7b7;
    border-radius: 9px;
    padding: 22px clamp(14px, 3.2vw, 36px) 12px clamp(14px, 3.2vw, 46px);
  }
  .tabla {
    width: 100%;
