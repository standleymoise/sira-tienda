---
// Página «Contacto» (Figma 147:4986): datos de contacto y formulario.
// El formulario se envía (fetch + JSON) a la URL de PUBLIC_FORMULARIO_CONTACTO (un servicio tipo
// Formspree). Si la variable no existe, no se simula el envío: se avisa y se ofrece Instagram.
// El bloque #servicio existe porque el pie enlaza ahí (envíos, tallas, preguntas frecuentes).
// Recibe `lang` por props: /en/contacto/ reutiliza esta página con lang="en".
import PaginaSira from '../layouts/PaginaSira.astro';
import type { Idioma } from '../i18n/idiomas';
import { pie } from '../data/sira';

const { lang = 'es' } = Astro.props as { lang?: Idioma };
const formulario = (import.meta.env.PUBLIC_FORMULARIO_CONTACTO ?? '').trim();
const instagram = pie.instagram.href;

const t = {
  es: {
    meta: 'Contacto y servicio | SIRA Conscious Apparel',
    descripcion: 'Citas privadas en atelier, consultas de tallas o pedidos internacionales: escríbale a SIRA.',
    etiqueta: 'Atención al cliente',
    titulo: 'Contacto y Servicio',
    contacto: 'Contacto',
    intro: 'Para citas privadas en atelier, consultas de tallas o pedidos internacionales, escribinos directamente.',
    nombre: 'Nombre',
    email: 'Correo electrónico',
    mensaje: 'Tu mensaje',
    enviar: 'Enviar mensaje',
    servicio: 'Servicio al cliente',
    servicioTexto: 'Envíos, devoluciones, guía de tallas y preguntas frecuentes: escríbanos y le ayudamos. También puede encontrarnos en',
  },
  en: {
    meta: 'Contact & client care | SIRA Conscious Apparel',
    descripcion: 'Private atelier appointments, sizing questions or international orders: get in touch with SIRA.',
    etiqueta: 'Client care',
    titulo: 'Contact & Client Care',
    contacto: 'Contact',
    intro: 'For private atelier appointments, sizing questions or international orders, write to us directly.',
    nombre: 'Name',
    email: 'Email',
    mensaje: 'Your message',
    enviar: 'Send message',
    servicio: 'Client care',
    servicioTexto: 'Shipping, returns, size guide and frequently asked questions: write to us and we will be glad to help. You can also find us on',
  },
}[lang];

// Mensajes del script del formulario (se pasan al HTML con data-textos).
const tScript = {
  es: {
    revisar: 'Revise los campos marcados.',
    sinConectar: 'El formulario todavía no está conectado. Escríbanos por Instagram:',
    enviando: 'Enviando…',
    gracias: 'Gracias, le responderemos pronto.',
    error: 'No se pudo enviar el mensaje. Intente de nuevo o escríbanos por Instagram:',
  },
  en: {
    revisar: 'Please check the highlighted fields.',
    sinConectar: 'The form is not connected yet. Message us on Instagram:',
    enviando: 'Sending…',
    gracias: 'Thank you, we will be in touch soon.',
    error: 'Your message could not be sent. Please try again or message us on Instagram:',
  },
}[lang];
---
<PaginaSira lang={lang} title={t.meta} description={t.descripcion} activo="contacto">
  <div class="contacto contenedor-c">
    <header class="cabecera">
      <p class="etiqueta-espaciada">{t.etiqueta}</p>
      <h1 class="serif">{t.titulo}</h1>
    </header>

    <section class="cuerpo" aria-labelledby="contacto-titulo">
      <div class="datos">
        <h2 id="contacto-titulo" class="serif">{t.contacto}</h2>
        <p>{t.intro}</p>
      </div>

      <form
        class="form"
        data-contacto
        data-accion={formulario}
        data-instagram={instagram}
        data-textos={JSON.stringify(tScript)}
        novalidate
      >
        <label class="campo">
          <span class="sr-only">{t.nombre}</span>
          <input name="nombre" type="text" placeholder={t.nombre} required autocomplete="name" />
        </label>
        <label class="campo">
          <span class="sr-only">{t.email}</span>
          <input name="email" type="email" placeholder={t.email} required autocomplete="email" />
        </label>
        <label class="campo">
          <span class="sr-only">{t.mensaje}</span>
          <textarea name="mensaje" rows="4" placeholder={t.mensaje} required></textarea>
        </label>
        <div class="acciones">
          <button class="enviar" type="submit">{t.enviar}</button>
        </div>
        <p class="estado" data-estado role="status" aria-live="polite" hidden></p>
      </form>
    </section>

    <section class="servicio" id="servicio" aria-labelledby="servicio-titulo">
      <h2 id="servicio-titulo" class="etiqueta-espaciada">{t.servicio}</h2>
      <p>
        {t.servicioTexto} <a href={instagram} target="_blank" rel="noopener">Instagram · @siraconsciousapparel</a>.
      </p>
    </section>
  </div>
</PaginaSira>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contacto]');
  if (form) {
    const estado = form.querySelector<HTMLElement>('[data-estado]')!;
    const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const accion = form.dataset.accion || '';
    const instagram = form.dataset.instagram || '';
    // Mensajes en el idioma de la página (vienen del HTML en data-textos).
    const tx = JSON.parse(form.dataset.textos || '{}') as Record<string, string>;

    const mostrar = (tipo: 'ok' | 'error' | 'aviso', texto: string, enlace = false) => {
      estado.className = `estado ${tipo}`;
      estado.textContent = texto;
      if (enlace && instagram) {
        const a = document.createElement('a');
        a.href = instagram;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = '@siraconsciousapparel';
        estado.append(' ', a);
      }
      estado.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.classList.add('validar');
        const malo = form.querySelector<HTMLInputElement>(':invalid');
        mostrar('error', malo?.validationMessage || tx.revisar);
        malo?.focus();
        return;
      }
      if (!accion) {
        mostrar('aviso', tx.sinConectar, true);
        return;
      }
      const texto = boton.textContent;
      boton.disabled = true;
      boton.textContent = tx.enviando;
      try {
        const r = await fetch(accion, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!r.ok) throw new Error(String(r.status));
        form.reset();
        form.classList.remove('validar');
        mostrar('ok', tx.gracias);
      } catch {
        mostrar('error', tx.error, true);
      } finally {
        boton.disabled = false;
        boton.textContent = texto;
      }
    });
  }
</script>

<style>
  /* El Figma usa un contenido de 1145 px (145 px de margen en 1440). */
  .contenedor-c {
    width: min(100% - 2 * var(--margen), 1145px);
    margin-inline: auto;
  }
  .contacto {
    padding: clamp(32px, 3vw, 43px) 0 clamp(48px, 3vw, 42px);
  }
  .cabecera {
    padding-bottom: 37.5px;
    border-bottom: 1.17px solid var(--linea);
  }
  .cabecera .etiqueta-espaciada {
    font-size: 12.9px;
  }
  h1 {
    margin: 14px 0 0;
    font-size: clamp(38px, 3.9vw, 56.3px);
    line-height: 1;
    color: var(--tinta-fuerte);
  }
  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 449px) minmax(0, 648px);
    justify-content: space-between;
    gap: 48px;
    padding-top: clamp(48px, 6.5vw, 94px);
  }
  .datos h2 {
    margin: 0;
    font-size: clamp(30px, 2.44vw, 35.2px);
    line-height: 1.2;
    color: var(--tinta-fuerte);
  }
  .datos p {
    margin: 14px 0 0;
    font-size: 14px;
    line-height: 1.63;
    color: var(--gris);
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 19px;
  }
  .campo input,
  .campo textarea {
    display: block;
    width: 100%;
    padding: 14px 18.8px;
    border: 1.17px solid var(--linea);
    border-radius: 0;
    background: transparent;
    font: inherit;
    font-size: 14px;
    line-height: 1.22;
    color: var(--tinta-fuerte);
  }
  .campo textarea {
    min-height: 106px;
    resize: vertical;
    line-height: 1.34;
  }
  .campo input::placeholder,
  .campo textarea::placeholder {
    color: rgba(28, 26, 24, 0.5);
  }
  .campo input:focus-visible,
  .campo textarea:focus-visible {
    outline: 1px solid var(--tinta-fuerte);
    outline-offset: 0;
    border-color: var(--tinta-fuerte);
  }
  .validar :invalid {
    border-color: #a33a2a;
  }
  .acciones {
    padding-top: 7px;
  }
  .enviar {
    min-width: 230px;
    padding: 13px 38px;
    border: 0;
    border-radius: 0;
    background: var(--tinta-fuerte);
    color: var(--crema);
    font: inherit;
    font-size: 12.9px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .enviar:hover {
    background: #000;
  }
  .enviar:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .estado {
    margin: 0;
    padding: 12px 16px;
    font-size: 14px;
    line-height: 1.6;
    border-left: 2px solid var(--oro);
    background: var(--arena);
    color: var(--tinta);
  }
  .estado[hidden] {
    display: none;
  }
  .estado.error {
    border-left-color: #a33a2a;
  }
  .estado :global(a) {
    color: var(--tinta-fuerte);
    font-weight: 500;
  }
  .servicio {
    margin-top: clamp(56px, 6vw, 80px);
    padding-top: 24px;
    border-top: 1px solid var(--linea);
    scroll-margin-top: 24px;
  }
  .servicio h2 {
    margin: 0;
  }
  .servicio p {
    max-width: 640px;
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--gris);
  }
  .servicio a {
    color: var(--tinta-fuerte);
  }

  @media (max-width: 760px) {
    .cuerpo {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .enviar {
      width: 100%;
      min-width: 0;
    }
  }
</style>
