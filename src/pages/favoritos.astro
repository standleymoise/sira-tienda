---
// Página /favoritos: las piezas guardadas con el corazón de las tarjetas.
// Los favoritos viven en el navegador (localStorage) con la clave de `claveFavorito(p)`
// (SKU, o «id-<n>» si el producto no tiene SKU). Precios y stock se leen en vivo de WooCommerce
// y «Agregar al carrito» usa el mismo carrito que el resto del sitio (avisa al encabezado con
// el evento `sira:carrito`). Los productos variables llevan a su ficha para elegir opciones.
// Recibe `lang` por props: /en/favoritos/ reutiliza esta página con lang="en".
import PaginaSira from '../layouts/PaginaSira.astro';
import type { Idioma } from '../i18n/idiomas';
import { getProductos, storeApiUrl, claveFavorito } from '../data/tienda';
import { rutasPara } from '../data/rutas';

const { lang = 'es' } = Astro.props as { lang?: Idioma };
const rutas = rutasPara(lang);

const t = {
  es: {
    meta: 'Mis favoritos | SIRA Conscious Apparel',
    descripcion: 'Las piezas que guardó como favoritas.',
    etiqueta: 'Su selección',
    titulo: 'Mis favoritos',
    vacioTitulo: 'Todavía no tiene favoritos',
    vacioTexto: 'Toque el corazón de una pieza para guardarla aquí.',
    verTienda: 'Ver la tienda',
  },
  en: {
    meta: 'My wishlist | SIRA Conscious Apparel',
    descripcion: 'The pieces you saved to your wishlist.',
    etiqueta: 'Your selection',
    titulo: 'My wishlist',
    vacioTitulo: 'Your wishlist is empty',
    vacioTexto: 'Tap the heart on any piece to save it here.',
    verTienda: 'Visit the shop',
  },
}[lang];

// Textos del script del navegador (se pasan al HTML con data-textos). «{n}» = nombre del producto.
const tScript = {
  es: {
    quitar: 'Quitar',
    agotado: 'Agotado',
    elegir: 'Elegir opciones',
    agregar: 'Agregar al carrito',
    agregando: 'Agregando…',
    agregado: 'Agregado al carrito: {n}',
    noAgregado: 'No se pudo agregar: {n}',
    quitado: 'Quitado de favoritos: {n}',
    quitarDe: 'Quitar {n} de favoritos',
  },
  en: {
    quitar: 'Remove',
    agotado: 'Sold out',
    elegir: 'Choose options',
    agregar: 'Add to cart',
    agregando: 'Adding…',
    agregado: 'Added to cart: {n}',
    noAgregado: 'Could not add to cart: {n}',
    quitado: 'Removed from your wishlist: {n}',
    quitarDe: 'Remove {n} from your wishlist',
  },
}[lang];

// Catálogo de la última compilación: se muestra al instante y luego se actualiza en vivo.
const iniciales = (await getProductos()).map((p) => ({
  id: p.id,
  clave: claveFavorito(p),
  url: rutas.producto(p.slug),
  nombre: p.nombre,
  precio: p.precio,
  variable: p.tipo === 'variable',
  enStock: p.enStock,
  reversible: p.reversible,
  imagen: p.imagen?.src ?? '',
  alt: p.imagen?.alt ?? p.nombre,
}));
---
<PaginaSira lang={lang} title={t.meta} description={t.descripcion} noindex>
  <div
    class="favs contenedor"
    data-api={storeApiUrl}
    data-plantilla-producto={rutas.producto('__slug__')}
    data-textos={JSON.stringify(tScript)}
  >
    <header class="cabecera">
      <p class="etiqueta-espaciada">{t.etiqueta}</p>
      <h1 class="serif">{t.titulo}</h1>
    </header>

    <ul class="lista" data-lista aria-live="polite"></ul>

    <div class="vacio" data-vacio hidden>
      <p class="serif vacio-titulo">{t.vacioTitulo}</p>
      <p>{t.vacioTexto}</p>
      <a class="btn" href={rutas.productos}>{t.verTienda}</a>
    </div>

    <p class="aviso" data-aviso role="status" aria-live="polite"></p>
  </div>

  <script type="application/json" data-iniciales set:html={JSON.stringify(iniciales)} />
</PaginaSira>

<script>
  import { crearCliente, formato, leerFavoritos, guardarFavoritos, textoPlano, type ProductoApi } from '../scripts/tienda-api';

  type Fav = {
    id: number;
    clave: string;
    url: string;
    nombre: string;
    precio: string;
    variable: boolean;
    enStock: boolean;
    reversible: boolean;
    imagen: string;
    alt: string;
    srcset?: string;
  };
  /** Campos de la Store API que el cliente compartido no declara. */
  type ProductoVivo = ProductoApi & { slug?: string; type?: string; categories?: { slug: string }[] };

  const corazon =
    '<svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1.17 5.54c0-.65.2-1.28.56-1.82a3.21 3.21 0 0 1 4.44-.81c.32.22.6.5.83.83a3.21 3.21 0 0 1 5.83 1.8c0 1.34-.88 2.35-1.75 3.22L7.88 11.9a1.17 1.17 0 0 1-1.66.06L3 8.76c-.88-.87-1.83-1.87-1.83-3.22z" /></svg>';

  const raiz = document.querySelector<HTMLElement>('.favs');
  if (raiz) iniciar(raiz);

  function iniciar(raiz: HTMLElement) {
    const api = raiz.dataset.api || '';
    const cliente = api ? crearCliente(api) : null;
    const plantilla = raiz.dataset.plantillaProducto || '/producto/__slug__/';
    const lista = raiz.querySelector<HTMLUListElement>('[data-lista]')!;
    const vacio = raiz.querySelector<HTMLElement>('[data-vacio]')!;
    const aviso = raiz.querySelector<HTMLElement>('[data-aviso]')!;
    // Textos en el idioma de la página (vienen del HTML en data-textos). «{n}» = nombre del producto.
    const tx = JSON.parse(raiz.dataset.textos || '{}') as Record<string, string>;
    const conNombre = (texto: string, n: string) => texto.replace('{n}', () => n);

    let productos: Fav[] = JSON.parse(document.querySelector('[data-iniciales]')!.textContent || '[]');
    let favoritos = leerFavoritos();

    let avisoTimer = 0;
    const avisar = (texto: string) => {
      aviso.textContent = texto;
      aviso.classList.add('visible');
      clearTimeout(avisoTimer);
      avisoTimer = window.setTimeout(() => aviso.classList.remove('visible'), 2600);
    };
    const avisarCarrito = (n: number) => window.dispatchEvent(new CustomEvent('sira:carrito', { detail: n }));

    function pintar() {
      const favs = productos.filter((p) => favoritos.has(p.clave));
      vacio.hidden = favs.length > 0;
      lista.hidden = favs.length === 0;
      lista.replaceChildren(
        ...favs.map((p) => {
          const li = document.createElement('li');
          li.className = 'tarjeta';
          li.innerHTML = `
            <div class="foto">
              <a class="foto-enlace" tabindex="-1" aria-hidden="true"><img alt="" loading="lazy" decoding="async" /></a>
              <button type="button" class="quitar-corazon">${corazon}</button>
            </div>
            <div class="datos">
              <h2 class="nombre serif"><a></a></h2>
              <div class="fila-precio"><p class="precio"></p><p class="etiqueta-rev">Reversible</p></div>
              <div class="botones">
                <button type="button" class="btn agregar"></button>
                <button type="button" class="quitar"></button>
              </div>
            </div>`;
          li.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => (a.href = p.url));
          const img = li.querySelector('img')!;
          if (p.imagen) {
            img.src = p.imagen;
            if (p.srcset) {
              img.srcset = p.srcset;
              img.sizes = '(max-width: 760px) 46vw, (max-width: 1100px) 30vw, 400px';
            }
          } else {
            const sin = document.createElement('span');
            sin.className = 'sin-foto';
            sin.textContent = p.nombre;
            img.replaceWith(sin);
          }
          li.querySelector('.nombre a')!.textContent = p.nombre;
          li.querySelector('.quitar')!.textContent = tx.quitar;
          li.querySelector('.precio')!.textContent = p.enStock ? p.precio : `${p.precio} · ${tx.agotado}`;
          if (!p.reversible) li.querySelector('.etiqueta-rev')!.remove();

          const agregarBtn = li.querySelector<HTMLButtonElement>('.agregar')!;
          if (p.variable) {
            // Hay que elegir talla/color: se lleva a la ficha.
            const a = document.createElement('a');
            a.className = 'btn agregar';
            a.href = p.url;
            a.textContent = tx.elegir;
            agregarBtn.replaceWith(a);
          } else {
            agregarBtn.textContent = p.enStock ? tx.agregar : tx.agotado;
            agregarBtn.disabled = !p.enStock || !cliente;
            agregarBtn.addEventListener('click', async () => {
              if (!cliente) return;
              agregarBtn.disabled = true;
              agregarBtn.textContent = tx.agregando;
              try {
                const c = await cliente.agregar(p.id);
                avisarCarrito(c.items_count);
                avisar(conNombre(tx.agregado, p.nombre));
              } catch (e) {
                avisar(conNombre(tx.noAgregado, (e as Error).message));
              } finally {
                agregarBtn.disabled = false;
                agregarBtn.textContent = tx.agregar;
              }
            });
          }

          const quitar = () => {
            favoritos.delete(p.clave);
            guardarFavoritos(favoritos);
            pintar();
            avisar(conNombre(tx.quitado, p.nombre));
          };
          for (const b of li.querySelectorAll<HTMLButtonElement>('.quitar-corazon, .quitar')) {
            b.setAttribute('aria-label', conNombre(tx.quitarDe, p.nombre));
            b.addEventListener('click', quitar);
          }
          return li;
        }),
      );
    }

    async function refrescar() {
      if (!cliente) return;
      const vivos = (await cliente.productos()) as ProductoVivo[];
      const previos = new Map(productos.map((p) => [p.id, p]));
      productos = vivos.map((p) => {
        const antes = previos.get(p.id);
        const variable = p.type ? p.type === 'variable' : !!antes?.variable;
        return {
          id: p.id,
          clave: p.sku || `id-${p.id}`,
          url: p.slug ? plantilla.replace('__slug__', p.slug) : antes?.url || plantilla.replace('__slug__/', ''),
          nombre: textoPlano(p.name),
          precio: formato(p.prices.price, p.prices),
          variable,
          enStock: p.is_in_stock && (p.is_purchasable || variable),
          reversible: p.categories ? p.categories.some((c) => c.slug.includes('reversible')) : !!antes?.reversible,
          imagen: p.images[0]?.src ?? '',
          srcset: p.images[0]?.srcset,
          alt: textoPlano(p.images[0]?.alt || p.name),
        };
      });
      pintar();
    }

    pintar();
    refrescar().catch(() => {
      /* sin conexión con la tienda: quedan los datos de la última compilación */
    });
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      favoritos = leerFavoritos();
      pintar();
    });
  }
</script>

<style>
  .favs {
    padding: clamp(32px, 3.5vw, 51px) 0 clamp(56px, 6vw, 96px);
  }
  .cabecera {
    padding-bottom: 32px;
    margin-bottom: clamp(32px, 3.3vw, 48px);
    border-bottom: 1px solid var(--linea);
  }
  h1 {
    margin: 14px 0 0;
    font-size: clamp(38px, 3.9vw, 56px);
    line-height: 1;
    color: var(--tinta-fuerte);
  }

  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 40px;
  }
  .lista[hidden] {
    display: none;
  }
  @media (max-width: 1100px) {
    .lista {
      gap: 48px 24px;
    }
  }
  @media (max-width: 760px) {
    .lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 14px;
    }
  }
  .lista :global(.tarjeta) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .lista :global(.foto) {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--arena);
  }
  .lista :global(.foto-enlace) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .lista :global(.foto img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lista :global(.sin-foto) {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 20px;
    font-family: var(--font-alt);
    font-size: 20px;
    text-align: center;
    color: var(--gris);
  }
  .lista :global(.quitar-corazon) {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(253, 250, 246, 0.8);
    backdrop-filter: blur(8px);
    color: var(--tinta-fuerte);
    cursor: pointer;
  }
  .lista :global(.quitar-corazon svg) {
    width: 14px;
    height: 14px;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.06;
    stroke-linejoin: round;
  }
  .lista :global(.datos) {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    padding-top: 16px;
  }
  .lista :global(.nombre) {
    margin: 0;
    font-size: 18px;
    line-height: 24.8px;
    color: var(--tinta-fuerte);
  }
  .lista :global(.nombre a) {
    color: inherit;
    text-decoration: none;
  }
  .lista :global(.fila-precio) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 12px;
  }
  .lista :global(.precio) {
    margin: 0;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.3px;
    color: var(--gris);
  }
  .lista :global(.etiqueta-rev) {
    margin: 0;
    font-size: 10px;
    line-height: 13.3px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--oro);
  }
  .lista :global(.botones) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: auto;
    padding-top: 16px;
  }
  .lista :global(.btn) {
    width: 100%;
    padding: 12px 10px;
    font-size: 11px;
    letter-spacing: 0.18em;
  }
  @media (max-width: 760px) {
    .lista :global(.btn) {
      min-height: 44px;
      padding: 10px 6px;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-align: center;
    }
  }
  .lista :global(.btn:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .lista :global(.quitar) {
    align-self: center;
    padding: 4px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--gris);
    cursor: pointer;
  }

  .vacio {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    max-width: 440px;
    margin: 6vh auto 0;
    text-align: center;
    color: var(--gris);
  }
  .vacio[hidden] {
    display: none;
  }
  .vacio p {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
  }
  .vacio .vacio-titulo {
    font-size: 30px;
    line-height: 1.2;
    color: var(--tinta-fuerte);
  }
  .vacio .btn {
    margin-top: 18px;
  }

  .aviso {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 50;
    max-width: min(420px, 100% - 32px);
    margin: 0;
    padding: 12px 18px;
    background: var(--tinta-fuerte);
    color: var(--crema);
    font-size: 13px;
    letter-spacing: 0.03em;
    text-align: center;
    opacity: 0;
    transform: translate(-50%, 12px);
    transition:
      opacity 0.2s,
      transform 0.2s;
    pointer-events: none;
  }
  .aviso.visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
