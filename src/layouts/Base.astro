---
// Layout de todas las páginas: colores, fuentes, estilos base y SEO salen de tienda.config.ts.
import { Font } from 'astro:assets';
import InstalarApp from '../components/InstalarApp.astro';
import { tienda } from '../../tienda.config';
import { url } from '../data/rutas';
import { tiendaUrl } from '../data/tienda';
import { type Idioma, locale, rutaEn } from '../i18n/idiomas';

interface Props {
  title: string;
  description?: string;
  /** Las páginas personales (favoritos, cuenta) no se indexan. */
  noindex?: boolean;
  /** Imagen al compartir el enlace: URL absoluta o ruta de /public. */
  imagen?: string;
  /** Tipo de página para Open Graph. */
  tipo?: 'website' | 'product';
  /** Datos estructurados (schema.org) de la página: un objeto o una lista. */
  jsonLd?: object | object[];
  /** Idioma de la página (por defecto español). */
  lang?: Idioma;
}
const { title, noindex = false, imagen, tipo = 'website', jsonLd, lang = 'es' } = Astro.props;
// Descripción por defecto de la marca, en el idioma de la página.
const description =
  Astro.props.description ??
  (lang === 'en'
    ? 'SIRA Conscious Apparel: unique pieces and reversible garments designed with intention in Costa Rica.'
    : tienda.marca.descripcion);
// La misma página en español y en inglés (hreflang).
const alterna = (l: Idioma) => new URL(rutaEn(Astro.url, l), Astro.site ?? Astro.url).href;
const c = tienda.colores;
// Vista previa (GitHub Pages): ninguna página se indexa. Se activa con PUBLIC_VISTA_PREVIA=1.
const vistaPrevia = import.meta.env.PUBLIC_VISTA_PREVIA === '1';

const variables = [
  `--primario:${c.primario}`,
  `--secundario:${c.secundario}`,
  `--acento:${c.acento}`,
  `--acento-oscuro:${c.acentoOscuro}`,
  `--texto:${c.texto}`,
  `--borde:${c.borde}`,
  `--suave:${c.suave}`,
  `--exito:${c.exito}`,
  `--favorito:${c.favorito}`,
  // Las fuentes las define <Font /> (ver «fonts» en astro.config.mjs).
  `--font-sans:var(--fuente-texto)`,
  `--font-alt:var(--fuente-titulos)`,
].join(';');
// Dominio oficial (SITE_URL) y URL canónica.
const hostOficial = Astro.site?.host ?? '';
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const absoluta = (x: string) => new URL(x.startsWith('http') ? x : url(x), Astro.site ?? Astro.url).href;
const imagenOg = imagen || tienda.seo.imagenCompartir;
// JSON dentro de <script>: «<» escapado para que un texto con «</script>» no rompa la página.
const ld = jsonLd ? JSON.stringify(jsonLd).replaceAll('<', '\\u003c') : '';
---
<!doctype html>
<html lang={lang} style={variables}>
  <head>
    <script is:inline define:vars={{ hostOficial }}>
      // Quien entra por www. va al dominio oficial: el CORS de la tienda solo acepta ese.
      if (hostOficial && location.host === 'www.' + hostOficial) {
        location.replace(location.protocol + '//' + hostOficial + location.pathname + location.search + location.hash);
      }
    </script>
    <meta charset="utf-8" />
    <link rel="canonical" href={canonica} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || vistaPrevia) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={tienda.marca.nombre} />
    <meta property="og:locale" content={locale[lang].replace('-', '_')} />
    <link rel="alternate" hreflang="es" href={alterna('es')} />
    <link rel="alternate" hreflang="en" href={alterna('en')} />
    <link rel="alternate" hreflang="x-default" href={alterna('es')} />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {imagenOg && <meta property="og:image" content={absoluta(imagenOg)} />}
    <meta name="twitter:card" content={imagenOg ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content={c.primario} />
    {/* Abre la conexión con WooCommerce mientras carga la página: el carrito responde antes. */}
    {tiendaUrl && <link rel="preconnect" href={tiendaUrl} crossorigin />}
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={url('/iconos/apple-180.png')} />
    <meta name="apple-mobile-web-app-title" content={tienda.app.nombreCorto || tienda.marca.nombre} />
    <meta name="mobile-web-app-capable" content="yes" />
    <Font cssVariable="--fuente-texto" preload={[{ weight: tienda.fuentes.texto.pesos[0] }]} />
    <Font cssVariable="--fuente-titulos" />
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body>
    <slot />
    <InstalarApp
      lang={lang}
      nombre={tienda.app.nombreCorto || tienda.marca.nombre}
      icono={url('/iconos/icono-192.png')}
      color={c.acento}
      clave={`${tienda.prefijo}-instalar-cerrado`}
    />
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ sw: url('/sw.js'), scope: url('/') }}>
        // App instalable: el service worker guarda el sitio para abrirlo rápido y sin conexión.
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => navigator.serviceWorker.register(sw, { scope }).catch(() => {}));
        }
      </script>
    )}
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
    /* Mezcla del color suave con blanco, para fondos de fotos y tarjetas */
    --suave-claro: color-mix(in srgb, var(--suave) 70%, #fff);

    /* Paleta SIRA (Figma) */
    --crema: #fdfaf6;
    --crema-clara: #fffdfb;
    --tinta: #292621;
    --tinta-fuerte: #1c1a18;
    --gris: #6a635c;
    --gris-claro: #666157;
    --linea: #e7e2db;
    --linea-tinta: rgba(41, 38, 33, 0.18);
    --arena: #f7f2eb;
    --arena-oscura: #efe8df;
    --piedra: #f0ede6;
    --lino: #ebe7dd;
    --oro: #ac8338;
    --oro-claro: #eab96e;
    --oro-boton: #ceb04e;

    /* Medidas del Figma (escritorio 1440): márgenes de 80 px, contenido de 1280 */
    --margen: clamp(20px, 5.56vw, 80px);
    --ancho: 1280px;
  }
  body {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--tinta);
    overflow-x: hidden;
    background: var(--crema);
    min-height: 100dvh;
  }
  h1,
  h2,
  h3 {
    font-weight: 400;
  }
  .contenedor {
    width: min(100% - 2 * var(--margen), var(--ancho));
    margin-inline: auto;
  }
  /* Etiquetas pequeñas en mayúsculas (Figma: Montserrat 500 10–11 px) */
  .etiqueta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    line-height: 1.7;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--tinta);
  }
  .etiqueta-espaciada {
    margin: 0;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gris);
  }
  .serif {
    font-family: var(--font-alt);
    font-weight: 400;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  a {
    color: inherit;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 12.9px;
    line-height: 1.5;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--crema);
    background: var(--acento);
    border: 1px solid var(--acento);
    border-radius: 0;
    padding: 13px 38px;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .btn:hover {
    background: var(--acento-oscuro);
    border-color: var(--acento-oscuro);
  }
  .btn-borde {
    background: transparent;
    color: var(--acento);
  }
  .btn-borde:hover {
    background: var(--acento);
    color: var(--crema);
  }
  /* Enlace con línea debajo (Figma: «Descubrir la colección →», «Ver piezas →») */
  .enlace-linea {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 5.6px;
    border-bottom: 1px solid currentColor;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--tinta-fuerte);
  }
  /* Enlace con flecha ↗ y separador corto (Figma: «Descubrir la colección    ↗») */
  .enlace-flecha {
    display: inline-block;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--linea-tinta);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.7;
    text-decoration: none;
    color: var(--tinta);
  }
  .enlace-flecha span {
    margin-left: 1.6em;
  }
  :focus-visible {
    outline: 2px solid var(--oro);
    outline-offset: 2px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* Aviso «Instalar app» abajo: arriba tapaba el encabezado editorial */
  .instalar-app[data-banner-app] {
    top: auto !important;
    bottom: max(10px, env(safe-area-inset-bottom));
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
