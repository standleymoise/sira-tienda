    font-weight: 700;
    font-size: 20px;
    color: var(--primario);
  }
  .fin p {
    margin: 0;
  }
  .fin-botones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
  }

  /* ---------- botones de acción ---------- */
  .acciones {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 3vw, 18px);
    padding-top: 4px;
  }
  .accion {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 6px 18px color-mix(in srgb, var(--primario) 16%, transparent);
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .accion:hover {
    transform: scale(1.08);
  }
  .accion:active {
    transform: scale(0.94);
  }
  .accion.chica {
    width: 50px;
    height: 50px;
  }
  .accion.chica svg {
    width: 22px;
    height: 22px;
  }
  .accion svg {
    width: 30px;
    height: 30px;
  }
  .deshacer {
    color: var(--secundario);
  }
  .pasar {
    color: var(--acento);
  }
  .pasar svg {
    stroke-width: 2.6;
  }
  .favorito {
    color: var(--favorito);
  }
  .favorito svg path {
    fill: currentColor;
  }
  .carrito {
    color: var(--exito);
  }
  .info-btn {
    color: var(--primario);
  }

  .aviso {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 50;
