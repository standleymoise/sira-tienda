  .btn-carrito svg circle {
    fill: currentColor;
    stroke: none;
  }
  .contador {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 11px;
    background: var(--acento);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    line-height: 22px;
  }
  .contador[hidden] {
    display: none;
  }

  /* ---------- mazo ---------- */
  .mazo {
    position: relative;
    flex: 1;
    min-height: 300px;
  }
  .tarjeta {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 10px 30px color-mix(in srgb, var(--primario) 16%, transparent);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    transition: transform 0.25s ease;
  }
  .tarjeta[hidden] {
    display: none;
  }
  .tarjeta.arriba {
    z-index: 3;
    cursor: grab;
  }
  .tarjeta.arriba:active {
    cursor: grabbing;
  }
  .tarjeta.siguiente {
    z-index: 2;
    transform: translateY(10px) scale(0.96);
  }
  .tarjeta.tercera {
    z-index: 1;
    transform: translateY(20px) scale(0.92);
  }
  /* Sin JavaScript (o antes de que cargue) se ve la primera tarjeta */
  .tienda:not(.lista) .tarjeta:not(:first-child) {
    display: none;
  }
  .foto {
    flex: 1;
    min-height: 0;
    padding: 24px;
    background: linear-gradient(180deg, var(--suave-claro), #fff);
