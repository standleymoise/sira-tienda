    width: 52px;
    height: 52px;
    border: 1px solid var(--borde);
    border-radius: 50%;
    background: #fff;
    color: var(--primario);
    cursor: pointer;
  }
  .btn-carrito svg,
  .accion svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
