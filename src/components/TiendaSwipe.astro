    width: min(460px, 100%);
    height: 100vh;
    height: 100dvh;
    margin-inline: auto;
    padding: max(10px, env(safe-area-inset-top)) 16px max(12px, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @media (max-height: 540px) {
    .tienda {
      height: auto;
      min-height: 100dvh;
    }
    .mazo {
      flex: none !important;
      height: 440px;
    }
  }
  .cabecera {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px;
    min-height: 52px;
  }
  .cabecera-botones {
    justify-self: end;
  }
  .btn-cuenta {
    justify-self: start;
    overflow: hidden;
  }
  .btn-cuenta .iniciales {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(160deg, var(--secundario), var(--primario));
    color: #fff;
    font-family: var(--font-alt);
    font-weight: 800;
    font-size: 17px;
  }
  .btn-cuenta .iniciales[hidden] {
    display: none;
  }
  .ayuda {
    margin: 0;
    font-size: 13px;
    text-align: center;
    color: var(--texto);
  }
  .btn-carrito {
    position: relative;
    flex: none;
    display: grid;
