---
// Tienda con tarjetas deslizables (página de inicio).
//   → derecha: agregar al carrito   ← izquierda: pasar
//   ↑ arriba: guardar en favoritos  ↓ abajo: ver el detalle
// El carrito y el checkout usan la Store API de WooCommerce desde el navegador
// (con el encabezado Cart-Token), así que el visitante nunca sale del sitio.
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import { rutas } from '../data/rutas';
import { tienda } from '../../tienda.config';
import type { Producto } from '../data/tienda';
import { storeApiUrl } from '../data/tienda';

interface Props {
  productos: Producto[];
}
const { productos } = Astro.props;

const { regiones, etiquetaRegion, etiquetaCiudad, codigoPostal } = tienda.pais;
---
<main class="tienda" data-api={storeApiUrl} aria-labelledby="tienda-titulo">
  <header class="cabecera">
    <a class="btn-carrito btn-cuenta" href={rutas.cuenta} data-cuenta>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="4" /><path d="M4.5 20a7.5 7.5 0 0 1 15 0" /></svg>
      <span class="iniciales" data-iniciales hidden></span>
      <span class="sr-only">Mi cuenta</span>
    </a>
    <Logo alto={40} />
    <h1 id="tienda-titulo" class="sr-only">{tienda.marca.nombre}</h1>
    <div class="cabecera-botones">
    <a class="btn-carrito btn-favs" href={rutas.favoritos}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>
      <span class="sr-only">Mis favoritos</span>
      <span class="contador" data-contador-favs hidden>0</span>
    </a>
    <button class="btn-carrito" type="button" data-accion="abrir-carrito">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 10.2a1.5 1.5 0 0 0 1.5 1.1h8.6a1.5 1.5 0 0 0 1.4-1.1L21 8H6.2" /><circle cx="9.5" cy="19.5" r="1.4" /><circle cx="17" cy="19.5" r="1.4" /></svg>
      <span class="sr-only">Carrito</span>
      <span class="contador" data-contador hidden>0</span>
    </button>
    </div>
  </header>

  <div class="mazo" data-mazo>
    {productos.map((p, i) => (
      <article
        class="tarjeta"
        data-id={p.id}
        data-sku={p.sku}
        data-nombre={p.nombre}
        data-stock={p.enStock ? '1' : '0'}
        aria-roledescription="tarjeta de producto"
        aria-label={`${p.nombre}, ${p.precio}`}
      >
        <div class="foto">
          {p.imagen && (
            <Image
              src={p.imagen.src}
              alt={p.imagen.alt}
              inferSize
              format="webp"
              widths={[320, 480, 720]}
              sizes="(max-width: 480px) 90vw, 420px"
              loading={i < 2 ? 'eager' : 'lazy'}
              draggable="false"
            />
          )}
        </div>
        <span class="sello sello-carrito" aria-hidden="true">Al carrito</span>
        <span class="sello sello-pasar" aria-hidden="true">Paso</span>
        <span class="sello sello-favorito" aria-hidden="true">Favorito</span>
        <div class="info">
          <h2>{p.nombre}</h2>
          <p class="precio">{p.precio}</p>
          <p class={p.enStock ? 'stock' : 'stock agotado'}>{p.stockTexto}</p>
          <p class="destacado" hidden={!p.destacado}>{p.destacado}</p>
        </div>
        <template data-detalle>
          <div class="detalle-fotos">
            {p.imagenes.map((img) => <img src={img.src} alt={img.alt} loading="lazy" />)}
          </div>
          <h2>{p.nombre}</h2>
          <p class="precio">{p.precio}</p>
          <p class={p.enStock ? 'stock' : 'stock agotado'}>{p.stockTexto}</p>
          {p.destacado && <p class="destacado">{p.destacado}</p>}
          {p.resumen && <p class="resumen">{p.resumen}</p>}
          {p.descripcion.map((d) => <p>{d}</p>)}
          <p><a class="ver-pagina" href={rutas.producto(p.slug)}>Ver la página del producto</a></p>
        </template>
      </article>
    ))}

    <div class="fin" data-fin hidden>
      <p class="fin-titulo">¡Ya vio todos los productos!</p>
      <p>Revise su carrito o vuelva a verlos.</p>
      <div class="fin-botones">
        <button class="btn" type="button" data-accion="abrir-carrito">Ver carrito</button>
        <button class="btn btn-borde" type="button" data-accion="reiniciar">Ver de nuevo</button>
      </div>
    </div>
  </div>

  <div class="acciones">
    <button type="button" class="accion chica deshacer" data-accion="deshacer" aria-label="Deshacer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7H4V2" /><path d="M4.5 7A8 8 0 1 1 4 13" /></svg>
    </button>
    <button type="button" class="accion pasar" data-accion="pasar" aria-label="Pasar al siguiente">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <button type="button" class="accion chica favorito" data-accion="favorito" aria-label="Guardar en favoritos">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>
    </button>
    <button type="button" class="accion carrito" data-accion="carrito" aria-label="Agregar al carrito">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 10.2a1.5 1.5 0 0 0 1.5 1.1h8.6a1.5 1.5 0 0 0 1.4-1.1L21 8H6.2" /><path d="M13 9.5v4M11 11.5h4" /></svg>
    </button>
    <button type="button" class="accion chica info-btn" data-accion="detalle" aria-label="Ver detalle del producto">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.5" /></svg>
    </button>
  </div>

  <p class="ayuda">
    <span aria-hidden="true">→</span> carrito · <span aria-hidden="true">←</span> pasar ·
    <span aria-hidden="true">↑</span> favorito · <span aria-hidden="true">↓</span> detalle
  </p>
  <p class="ayuda"><a href={rutas.productos}>Ver todos los productos en lista</a></p>

  <!-- Molde para productos nuevos que aparecen en WooCommerce después de compilar -->
  <template data-plantilla-tarjeta>
    <article class="tarjeta" aria-roledescription="tarjeta de producto">
      <div class="foto"><img alt="" draggable="false" decoding="async" /></div>
      <span class="sello sello-carrito" aria-hidden="true">Al carrito</span>
      <span class="sello sello-pasar" aria-hidden="true">Paso</span>
      <span class="sello sello-favorito" aria-hidden="true">Favorito</span>
      <div class="info">
        <h2></h2>
        <p class="precio"></p>
        <p class="stock"></p>
        <p class="destacado" hidden></p>
      </div>
      <template data-detalle></template>
    </article>
  </template>

  <p class="aviso" data-aviso role="status" aria-live="polite"></p>
</main>

<!-- Detalle del producto (↓) -->
<dialog class="hoja detalle" data-dialog-detalle aria-label="Detalle del producto">
  <button class="cerrar" type="button" data-cerrar aria-label="Cerrar">×</button>
  <div class="hoja-cuerpo" data-detalle-cuerpo></div>
  <div class="hoja-pie">
    <button class="btn btn-borde" type="button" data-accion="favorito">Favorito</button>
    <button class="btn" type="button" data-accion="carrito">Agregar al carrito</button>
  </div>
</dialog>

<!-- Carrito y checkout -->
<dialog class="panel" data-dialog-carrito aria-labelledby="carrito-titulo">
  <div class="panel-cabecera">
    <h2 id="carrito-titulo" data-panel-titulo>Su carrito</h2>
    <button class="cerrar" type="button" data-cerrar aria-label="Cerrar">×</button>
  </div>

  <div class="vista" data-vista="carrito">
    <ul class="items" data-items></ul>
    <p class="vacio" data-vacio>Su carrito está vacío. Deslice a la derecha para agregar productos.</p>
    <section class="favoritos" data-favoritos hidden aria-labelledby="favoritos-titulo">
      <h3 id="favoritos-titulo">Sus favoritos</h3>
      <ul data-favoritos-lista></ul>
    </section>
    <div class="panel-pie" data-pie-carrito hidden>
      <p class="total"><span>Total</span><strong data-total></strong></p>
      <button class="btn" type="button" data-accion="ir-checkout">Finalizar compra</button>
    </div>
  </div>

  <form class="vista" data-vista="checkout" data-form-checkout hidden novalidate>
    <div class="campos">
      <label>Nombre <input name="first_name" required autocomplete="given-name" /></label>
      <label>Apellidos <input name="last_name" required autocomplete="family-name" /></label>
      <label class="ancho">Correo electrónico <input name="email" type="email" required autocomplete="email" /></label>
      <label class="ancho">Teléfono <input name="phone" type="tel" required autocomplete="tel" /></label>
      {regiones.length > 0 && (
        <label>
          {etiquetaRegion}
          <select name="state" required>
            {regiones.map(([codigo, nombre]) => <option value={codigo}>{nombre}</option>)}
          </select>
        </label>
      )}
      <label>{etiquetaCiudad} <input name="city" required autocomplete="address-level2" /></label>
      <label>
        Código postal
        <input
          name="postcode"
          required={codigoPostal.requerido}
          pattern={codigoPostal.patron || undefined}
          autocomplete="postal-code"
        />
      </label>
      <label class="ancho">Dirección exacta <input name="address_1" required autocomplete="street-address" /></label>
      <label class="ancho">Nota para el pedido (opcional) <textarea name="customer_note" rows="2"></textarea></label>
      <!-- Solo aparece si WordPress tiene el plugin de ejemplo tienda-extras.php -->
      <label class="ancho" data-regalo hidden>
        Mensaje de regalo (opcional)
        <textarea name="nota_regalo" rows="2" placeholder="Lo incluimos en el paquete"></textarea>
      </label>
    </div>
    <fieldset class="pagos">
      <legend>Forma de pago</legend>
      <div data-metodos></div>
    </fieldset>
    <p class="error" data-error role="alert" hidden></p>
    <div class="panel-pie">
      <p class="total"><span>Total</span><strong data-total></strong></p>
      <div class="pie-botones">
        <button class="btn btn-borde" type="button" data-accion="volver-carrito">Volver</button>
        <button class="btn" type="submit" data-enviar>Confirmar pedido</button>
      </div>
    </div>
  </form>

  <div class="vista gracias" data-vista="gracias" hidden>
    <p class="gracias-icono" aria-hidden="true">✓</p>
    <p class="gracias-titulo">¡Pedido recibido!</p>
    <p data-gracias-texto></p>
    <button class="btn" type="button" data-cerrar>Seguir comprando</button>
  </div>
</dialog>

<script>
  import { tienda } from '../../tienda.config';
  import {
    crearCliente,
    iniciales,
    leerPerfil,
    type ProductoApi,
    formato,
    leerFavoritos,
    guardarFavoritos,
    type Carrito,
    destacadoDe,
  } from '../scripts/tienda-api';

  const raiz = document.querySelector<HTMLElement>('.tienda');
  if (raiz) iniciar(raiz);

  function iniciar(raiz: HTMLElement) {
    const API = raiz.dataset.api!;
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const mazo = raiz.querySelector<HTMLElement>('[data-mazo]')!;
    const fin = raiz.querySelector<HTMLElement>('[data-fin]')!;
    const aviso = raiz.querySelector<HTMLElement>('[data-aviso]')!;
    const contador = raiz.querySelector<HTMLElement>('[data-contador]')!;
    const contadorFavs = raiz.querySelector<HTMLElement>('[data-contador-favs]')!;
    const dlgDetalle = document.querySelector<HTMLDialogElement>('[data-dialog-detalle]')!;
    const dlgCarrito = document.querySelector<HTMLDialogElement>('[data-dialog-carrito]')!;
    const formCheckout = dlgCarrito.querySelector<HTMLFormElement>('[data-form-checkout]')!;

    const cliente = crearCliente(API);
    const api = cliente.api;

    // ---------- favoritos (compartidos con la página /favoritos) ----------
    let favoritos = leerFavoritos();
    const pintarContadorFavs = () => {
      contadorFavs.textContent = String(favoritos.size);
      contadorFavs.hidden = favoritos.size === 0;
    };
    const guardarFavs = () => {
      guardarFavoritos(favoritos);
      pintarContadorFavs();
    };

    // ---------- cuenta (iniciales en la barra si hay sesión) ----------
    function pintarCuenta() {
      const perfil = leerPerfil();
      const el = raiz.querySelector<HTMLElement>('[data-iniciales]')!;
      el.hidden = !perfil;
      el.textContent = perfil ? iniciales(perfil) : '';
    }

    // ---------- carrito ----------
    let carrito: Carrito | null = null;

    function usarCarrito(c: Carrito) {
      carrito = c;
      contador.textContent = String(c.items_count);
      contador.hidden = c.items_count === 0;
      if (dlgCarrito.open) pintarCarrito();
    }

    const cargarCarrito = () => cliente.carrito().then(usarCarrito);
    const agregar = (id: number) => cliente.agregar(id).then(usarCarrito);
    const cambiar = (key: string, quantity: number) => cliente.cambiar(key, quantity).then(usarCarrito);

    // ---------- avisos ----------
    let avisoTimer = 0;
    function avisar(texto: string) {
      aviso.textContent = texto;
      aviso.classList.add('visible');
      clearTimeout(avisoTimer);
      avisoTimer = window.setTimeout(() => aviso.classList.remove('visible'), 2600);
    }

    // ---------- mazo ----------
    const tarjetas = [...mazo.querySelectorAll<HTMLElement>('.tarjeta')];
    // #sku en la URL (p. ej. desde «Comprar ahora» de una ficha) pone ese producto primero.
    const pedido = decodeURIComponent(location.hash.slice(1));
    const orden = [...tarjetas].sort(
      (a, b) => Number(b.dataset.sku === pedido) - Number(a.dataset.sku === pedido),
    );
    let pos = 0;
    let historial: { tarjeta: HTMLElement; accion: Accion }[] = [];
    type Accion = 'carrito' | 'pasar' | 'favorito';

    // ---------- catálogo en vivo ----------
    // La página trae los productos de la última compilación (carga instantánea) y al abrir
    // los compara con WooCommerce: precio, stock, nombre y fotos quedan al día, aparecen
    // los productos nuevos y se quitan los borrados, sin volver a publicar el sitio.
    const plantillaTarjeta = raiz.querySelector<HTMLTemplateElement>('template[data-plantilla-tarjeta]')!;

    const parrafosDe = (html: string) => {
      const doc = new DOMParser().parseFromString(html || '', 'text/html');
      const ps = [...doc.querySelectorAll('p')].map((p) => p.textContent!.trim()).filter(Boolean);
      return ps.length ? ps : [doc.body.textContent!.trim()].filter(Boolean);
    };

    function crearDetalle(p: ProductoApi, precio: string, stock: string, enStock: boolean) {
      const f = document.createDocumentFragment();
      const el = (tag: string, texto = '', clase = '') => {
        const e = document.createElement(tag);
        if (texto) e.textContent = texto;
        if (clase) e.className = clase;
        return e;
      };
      const fotos = el('div', '', 'detalle-fotos');
      p.images.forEach((i) => {
        const img = document.createElement('img');
        img.src = i.src;
        img.alt = i.alt || p.name;
        img.loading = 'lazy';
        fotos.append(img);
      });
      f.append(fotos, el('h2', p.name), el('p', precio, 'precio'), el('p', stock, enStock ? 'stock' : 'stock agotado'));
      const destacado = destacadoDe(p);
      if (destacado) f.append(el('p', destacado, 'destacado'));
      const resumen = parrafosDe(p.short_description).join(' ');
      if (resumen) f.append(el('p', resumen, 'resumen'));
      parrafosDe(p.description).forEach((d) => f.append(el('p', d)));
      return f;
    }

    function actualizarTarjeta(t: HTMLElement, p: ProductoApi) {
      const precio = formato(p.prices.price, p.prices);
      const enStock = p.is_purchasable && p.is_in_stock;
      const stock = p.stock_availability?.text || (p.is_in_stock ? 'Disponible' : 'Agotado');
      t.dataset.id = String(p.id);
      t.dataset.sku = p.sku;
      t.dataset.nombre = p.name;
      t.dataset.stock = enStock ? '1' : '0';
      t.setAttribute('aria-label', `${p.name}, ${precio}`);
      t.querySelector('.info h2')!.textContent = p.name;
      t.querySelector('.info .precio')!.textContent = precio;
      const st = t.querySelector<HTMLElement>('.info .stock')!;
      st.textContent = stock;
      st.classList.toggle('agotado', !enStock);
      const dest = t.querySelector<HTMLElement>('.info .destacado')!;
      dest.textContent = destacadoDe(p);
      dest.hidden = !dest.textContent;
      t.querySelector<HTMLTemplateElement>('template[data-detalle]')!.content.replaceChildren(
        crearDetalle(p, precio, stock, enStock),
      );
    }

    function crearTarjeta(p: ProductoApi) {
      const t = (plantillaTarjeta.content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      const img = t.querySelector('img')!;
      const foto = p.images[0];
      if (foto) {
        img.src = foto.src;
        if (foto.srcset) img.srcset = foto.srcset;
        img.sizes = '(max-width: 480px) 90vw, 420px';
        img.alt = foto.alt || p.name;
      } else img.remove();
      return t;
    }

    async function refrescarCatalogo() {
      const lista = await cliente.productos();
      const porId = new Map(tarjetas.map((t) => [Number(t.dataset.id), t]));
      const vivos = new Set(lista.map((p) => p.id));

      // Quitar los que ya no están publicados; la tarjeta que se está viendo sigue arriba.
      const enPantalla = actual();
      for (const t of [...tarjetas]) {
        if (vivos.has(Number(t.dataset.id))) continue;
        const i = orden.indexOf(t);
        if (i > -1) orden.splice(i, 1);
        tarjetas.splice(tarjetas.indexOf(t), 1);
        historial = historial.filter((h) => h.tarjeta !== t);
        t.remove();
      }
      if (orden.length) {
        pos = enPantalla && orden.includes(enPantalla) ? orden.indexOf(enPantalla) : pos % orden.length;
      }
      // Actualizar los que existen y agregar los nuevos al final del mazo.
      for (const p of lista) {
        let t = porId.get(p.id);
        if (!t) {
          t = crearTarjeta(p);
          mazo.insertBefore(t, fin);
          tarjetas.push(t);
          orden.push(t);
        }
        actualizarTarjeta(t, p);
      }
      if (!ocupado && !inicio) pintarMazo();
    }

    const actual = () => orden[pos] as HTMLElement | undefined;

    // El mazo es infinito: la posición da la vuelta (después de la última viene la primera),
    // así que nunca se llega a «ya vio todos».
    const n = () => orden.length;
    const avanzar = () => (pos = n() ? (pos + 1) % n() : 0);

    function pintarMazo() {
      orden.forEach((t, i) => {
        const capa = (i - pos + n()) % n();
        t.classList.remove('arriba', 'siguiente', 'tercera');
        t.hidden = capa > 2;
        t.style.transition = '';
        t.style.transform = '';
        t.setAttribute('aria-hidden', capa === 0 ? 'false' : 'true');
        if (capa === 0) t.classList.add('arriba');
        if (capa === 1) t.classList.add('siguiente');
        if (capa === 2) t.classList.add('tercera');
        t.querySelectorAll<HTMLElement>('.sello').forEach((s) => (s.style.opacity = ''));
        t.classList.toggle('es-favorito', favoritos.has(t.dataset.sku!));
      });
      fin.hidden = n() > 0;
      fin.querySelector('.fin-titulo')!.textContent = orden.length
        ? '¡Ya vio todos los productos!'
        : 'Todavía no hay productos publicados.';
    }

    function volar(t: HTMLElement, accion: Accion) {
      const ancho = Math.max(window.innerWidth, 600);
      const destino =
        accion === 'carrito'
          ? `translate(${ancho}px, -40px) rotate(24deg)`
          : accion === 'pasar'
            ? `translate(${-ancho}px, -40px) rotate(-24deg)`
            : `translate(0, ${-window.innerHeight}px)`;
      t.querySelector<HTMLElement>(`.sello-${accion}`)!.style.opacity = '1';
      t.style.transition = reducido ? 'none' : 'transform .32s ease-in';
      t.style.transform = destino;
      return new Promise<void>((ok) => setTimeout(ok, reducido ? 0 : 320));
    }

    let ocupado = false;
    const recordar = (h: { tarjeta: HTMLElement; accion: Accion }) => {
      historial.push(h);
      if (historial.length > 50) historial.shift();
    };
    async function decidir(accion: Accion) {
      const t = actual();
      if (!t || ocupado) return;
      if (accion === 'carrito' && t.dataset.stock !== '1') {
        avisar('Este producto está agotado por ahora.');
        rebotar(t);
        return;
      }
      ocupado = true;
      await volar(t, accion);
      recordar({ tarjeta: t, accion });
      avanzar();
      pintarMazo();
      ocupado = false;

      const nombre = t.dataset.nombre!;
      if (accion === 'favorito') {
        favoritos.add(t.dataset.sku!);
        guardarFavs();
        avisar(`Guardado en favoritos: ${nombre}`);
      }
      if (accion === 'carrito') {
        avisar(`Agregando ${nombre}…`);
        agregar(Number(t.dataset.id))
          .then(() => avisar(`Agregado al carrito: ${nombre}`))
          .catch((e) => avisar(`No se pudo agregar: ${e.message}`));
      }
    }

    async function deshacer() {
      const ultimo = historial.pop();
      if (!ultimo || ocupado) return;
      pos = Math.max(0, orden.indexOf(ultimo.tarjeta));
      pintarMazo();
      const { tarjeta, accion } = ultimo;
      if (accion === 'favorito') {
        favoritos.delete(tarjeta.dataset.sku!);
        guardarFavs();
        pintarMazo();
      }
      if (accion === 'carrito' && carrito) {
        const item = carrito.items.find((i) => i.id === Number(tarjeta.dataset.id));
        if (item) await cambiar(item.key, item.quantity - 1).catch(() => {});
      }
      avisar('Listo, deshecho.');
    }

    function rebotar(t: HTMLElement) {
      t.style.transition = reducido ? 'none' : 'transform .25s cubic-bezier(.3,1.6,.5,1)';
      t.style.transform = '';
      t.querySelectorAll<HTMLElement>('.sello').forEach((s) => (s.style.opacity = ''));
    }

    // ---------- gestos ----------
    const UMBRAL = 90;
    let inicio: { x: number; y: number; id: number } | null = null;
    let dx = 0;
    let dy = 0;

    mazo.addEventListener('pointerdown', (e) => {
      const t = actual();
      if (!t || ocupado || !t.contains(e.target as Node) || e.button > 0) return;
      inicio = { x: e.clientX, y: e.clientY, id: e.pointerId };
      dx = dy = 0;
      t.setPointerCapture(e.pointerId);
      t.style.transition = 'none';
    });

    mazo.addEventListener('pointermove', (e) => {
      const t = actual();
      if (!inicio || !t || e.pointerId !== inicio.id) return;
      dx = e.clientX - inicio.x;
      dy = e.clientY - inicio.y;
      t.style.transform = `translate(${dx}px, ${dy}px) rotate(${dx / 18}deg)`;
      const horizontal = Math.abs(dx) >= Math.abs(dy);
      const op = (v: number) => String(Math.max(0, Math.min(1, v / UMBRAL)));
      t.querySelector<HTMLElement>('.sello-carrito')!.style.opacity = horizontal ? op(dx) : '0';
      t.querySelector<HTMLElement>('.sello-pasar')!.style.opacity = horizontal ? op(-dx) : '0';
      t.querySelector<HTMLElement>('.sello-favorito')!.style.opacity = horizontal ? '0' : op(-dy);
    });

    const soltar = (e: PointerEvent) => {
      const t = actual();
      if (!inicio || !t || e.pointerId !== inicio.id) return;
      inicio = null;
      const horizontal = Math.abs(dx) >= Math.abs(dy);
      if (horizontal && dx > UMBRAL) return decidir('carrito');
      if (horizontal && dx < -UMBRAL) return decidir('pasar');
      if (!horizontal && dy < -UMBRAL) return decidir('favorito');
      rebotar(t);
      // Abajo, o un toque sin arrastrar: ver el detalle.
      if ((!horizontal && dy > UMBRAL) || (Math.abs(dx) < 6 && Math.abs(dy) < 6)) abrirDetalle();
    };
    mazo.addEventListener('pointerup', soltar);
    mazo.addEventListener('pointercancel', (e) => {
      const t = actual();
      inicio = null;
      if (t && e) rebotar(t);
    });

    document.addEventListener('keydown', (e) => {
      if (dlgDetalle.open || dlgCarrito.open) return;
      const enCampo = (e.target as HTMLElement).closest('input, textarea, select, [contenteditable]');
      if (enCampo) return;
      const mapa: Record<string, () => void> = {
        ArrowRight: () => decidir('carrito'),
        ArrowLeft: () => decidir('pasar'),
        ArrowUp: () => decidir('favorito'),
        ArrowDown: () => abrirDetalle(),
      };
      if (mapa[e.key] && actual()) {
        e.preventDefault();
        mapa[e.key]();
      }
    });

    // ---------- detalle ----------
    function abrirDetalle() {
      const t = actual();
      if (!t) return;
      const plantilla = t.querySelector<HTMLTemplateElement>('template[data-detalle]')!;
      const cuerpo = dlgDetalle.querySelector<HTMLElement>('[data-detalle-cuerpo]')!;
      cuerpo.replaceChildren(plantilla.content.cloneNode(true));
      dlgDetalle.showModal();
    }

    // ---------- carrito ----------
    const vistas = [...dlgCarrito.querySelectorAll<HTMLElement>('[data-vista]')];
    const titulo = dlgCarrito.querySelector<HTMLElement>('[data-panel-titulo]')!;
    function mostrarVista(nombre: 'carrito' | 'checkout' | 'gracias') {
      vistas.forEach((v) => (v.hidden = v.dataset.vista !== nombre));
      titulo.textContent = { carrito: 'Su carrito', checkout: 'Datos de entrega', gracias: 'Gracias' }[nombre];
    }

    function pintarCarrito() {
      const lista = dlgCarrito.querySelector<HTMLElement>('[data-items]')!;
      const vacio = dlgCarrito.querySelector<HTMLElement>('[data-vacio]')!;
      const pie = dlgCarrito.querySelector<HTMLElement>('[data-pie-carrito]')!;
      const items = carrito?.items ?? [];
      lista.replaceChildren(
        ...items.map((it) => {
          const li = document.createElement('li');
          li.className = 'item';
          const img = it.images[0];
          li.innerHTML = `
            ${img ? `<img src="${img.thumbnail}" alt="" width="64" height="64" />` : '<span></span>'}
            <div class="item-info">
              <p class="item-nombre"></p>
              <div class="cantidad">
                <button type="button" aria-label="Quitar uno">−</button>
                <span aria-live="polite">${it.quantity}</span>
                <button type="button" aria-label="Agregar uno">+</button>
              </div>
            </div>
            <div class="item-fin">
              <strong>${formato(it.totals.line_total, it.totals)}</strong>
              <button type="button" class="quitar">Quitar</button>
            </div>`;
          li.querySelector('.item-nombre')!.textContent = it.name;
          const [menos, mas] = li.querySelectorAll<HTMLButtonElement>('.cantidad button');
          const actualizar = (n: number) => {
            li.classList.add('cargando');
            cambiar(it.key, n).catch((e) => avisar(e.message));
          };
          menos.addEventListener('click', () => actualizar(it.quantity - 1));
          mas.addEventListener('click', () => actualizar(it.quantity + 1));
          li.querySelector('.quitar')!.addEventListener('click', () => actualizar(0));
          return li;
        }),
      );
      vacio.hidden = items.length > 0;
      pie.hidden = items.length === 0;
      dlgCarrito.querySelectorAll<HTMLElement>('[data-total]').forEach((el) => {
        el.textContent = carrito ? formato(carrito.totals.total_price, carrito.totals) : '';
      });
      pintarFavoritos();
    }

    function pintarFavoritos() {
      const caja = dlgCarrito.querySelector<HTMLElement>('[data-favoritos]')!;
      const lista = dlgCarrito.querySelector<HTMLElement>('[data-favoritos-lista]')!;
      const favs = tarjetas.filter((t) => favoritos.has(t.dataset.sku!));
      caja.hidden = favs.length === 0;
      lista.replaceChildren(
        ...favs.map((t) => {
          const li = document.createElement('li');
          const nombre = document.createElement('span');
          nombre.textContent = t.dataset.nombre!;
          const agregarBtn = document.createElement('button');
          agregarBtn.type = 'button';
          agregarBtn.textContent = 'Agregar';
          agregarBtn.disabled = t.dataset.stock !== '1';
          agregarBtn.addEventListener('click', () =>
            agregar(Number(t.dataset.id))
              .then(() => avisar(`Agregado al carrito: ${t.dataset.nombre}`))
              .catch((e) => avisar(e.message)),
          );
          const quitar = document.createElement('button');
          quitar.type = 'button';
          quitar.className = 'quitar';
          quitar.textContent = 'Quitar';
          quitar.setAttribute('aria-label', `Quitar ${t.dataset.nombre} de favoritos`);
          quitar.addEventListener('click', () => {
            favoritos.delete(t.dataset.sku!);
            guardarFavs();
            pintarFavoritos();
            pintarMazo();
          });
          li.append(nombre, agregarBtn, quitar);
          return li;
        }),
      );
    }

    async function abrirCarrito() {
      mostrarVista('carrito');
      pintarCarrito();
      if (!dlgCarrito.open) dlgCarrito.showModal();
      await cargarCarrito().catch((e) => avisar(e.message));
    }

    // ---------- checkout ----------
    const nombresPago = tienda.pagos;

    function irCheckout() {
      const metodos = dlgCarrito.querySelector<HTMLElement>('[data-metodos]')!;
      const lista = carrito?.payment_methods ?? [];
      metodos.replaceChildren(
        ...lista.map((m, i) => {
          const label = document.createElement('label');
          label.className = 'pago';
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = 'payment_method';
          input.value = m;
          input.checked = i === 0;
          label.append(input, ` ${nombresPago[m] ?? m}`);
          return label;
        }),
      );
      // Con sesión, se llenan los campos vacíos con los datos guardados de la cuenta.
      const perfil = leerPerfil();
      if (perfil) {
        const campos: Record<string, string> = {
          first_name: perfil.nombre,
          last_name: perfil.apellidos,
          email: perfil.email,
          phone: perfil.telefono,
          state: perfil.provincia,
          city: perfil.ciudad,
          postcode: perfil.postal,
          address_1: perfil.direccion,
        };
        for (const [nombre, valor] of Object.entries(campos)) {
          const el = formCheckout.elements.namedItem(nombre) as HTMLInputElement | HTMLSelectElement | null;
          if (el && valor && (!el.value || el.tagName === 'SELECT')) el.value = valor;
        }
      }
      // Mensaje de regalo (plugin tienda-extras.php): el carrito trae el guardado y el largo máximo.
      const extras = carrito?.extensions?.['tienda-extras'];
      const regalo = formCheckout.querySelector<HTMLElement>('[data-regalo]')!;
      const notaRegalo = regalo.querySelector('textarea')!;
      regalo.hidden = !extras;
      if (extras) {
        notaRegalo.maxLength = extras.max;
        if (!notaRegalo.value) notaRegalo.value = extras.nota_regalo;
      }
      formCheckout.querySelector<HTMLElement>('[data-error]')!.hidden = true;
      mostrarVista('checkout');
      formCheckout.querySelector<HTMLInputElement>('input')?.focus();
    }

    formCheckout.addEventListener('submit', async (e) => {
      e.preventDefault();
      const error = formCheckout.querySelector<HTMLElement>('[data-error]')!;
      const enviar = formCheckout.querySelector<HTMLButtonElement>('[data-enviar]')!;
      if (!formCheckout.checkValidity()) {
        error.textContent =
          `Revise los campos marcados: todos son obligatorios excepto la nota${tienda.pais.codigoPostal.ayuda ? ` (código postal: ${tienda.pais.codigoPostal.ayuda})` : ''}.`;
        error.hidden = false;
        formCheckout.classList.add('validar');
        (formCheckout.querySelector(':invalid') as HTMLElement | null)?.focus();
        return;
      }
      const d = Object.fromEntries(new FormData(formCheckout)) as Record<string, string>;
      const direccion = {
        first_name: d.first_name,
        last_name: d.last_name,
        address_1: d.address_1,
        city: d.city,
        state: d.state ?? '',
        postcode: d.postcode,
        country: tienda.pais.codigo,
        phone: d.phone,
      };
      error.hidden = true;
      enviar.disabled = true;
      enviar.textContent = 'Enviando…';
      try {
        // El mensaje de regalo va al carrito antes de confirmar; el plugin lo copia al pedido.
        const extras = carrito?.extensions?.['tienda-extras'];
        const nota = (d.nota_regalo ?? '').trim();
        if (extras && nota !== extras.nota_regalo) usarCarrito(await cliente.notaRegalo(nota));
        const r = await api<{
          order_id: number;
          status: string;
          payment_result?: { redirect_url?: string };
        }>('/checkout', {
          billing_address: { ...direccion, email: d.email },
          shipping_address: direccion,
          payment_method: d.payment_method,
          customer_note: d.customer_note,
        });
        // Una pasarela con tarjeta puede pedir ir a su página de pago (es lo esperado).
        const destino = r.payment_result?.redirect_url ?? '';
        const esPaginaPropia = !destino || destino.includes('order-received') || destino.includes('pedido-recibido');
        if (!esPaginaPropia) {
          location.href = destino;
          return;
        }
        const texto =
          d.payment_method === 'bacs'
            ? `Su pedido #${r.order_id} quedó registrado. Le enviamos a ${d.email} los datos para hacer la transferencia.`
            : `Su pedido #${r.order_id} quedó registrado. Le confirmaremos la entrega a ${d.email} o al ${d.phone}.`;
        dlgCarrito.querySelector<HTMLElement>('[data-gracias-texto]')!.textContent = cliente.conSesion()
          ? `${texto} También lo puede ver en Mi cuenta.`
          : texto;
        mostrarVista('gracias');
        formCheckout.reset();
        formCheckout.classList.remove('validar');
        cargarCarrito().catch(() => {});
      } catch (err) {
        error.textContent = (err as Error).message || 'No se pudo enviar el pedido. Intente de nuevo.';
        error.hidden = false;
      } finally {
        enviar.disabled = false;
        enviar.textContent = 'Confirmar pedido';
      }
    });

    // ---------- botones ----------
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-accion], [data-cerrar]');
      if (!btn) return;
      if (btn.hasAttribute('data-cerrar')) {
        btn.closest('dialog')?.close();
        return;
      }
      const accion = btn.dataset.accion;
      const desdeDetalle = !!btn.closest('[data-dialog-detalle]');
      if (desdeDetalle) dlgDetalle.close();
      switch (accion) {
        case 'carrito':
        case 'pasar':
        case 'favorito':
          decidir(accion);
          break;
        case 'deshacer':
          deshacer();
          break;
        case 'detalle':
          abrirDetalle();
          break;
        case 'reiniciar':
          pos = 0;
          historial.length = 0;
          pintarMazo();
          break;
        case 'abrir-carrito':
          abrirCarrito();
          break;
        case 'ir-checkout':
          irCheckout();
          break;
        case 'volver-carrito':
          mostrarVista('carrito');
          break;
      }
    });

    // Cerrar los diálogos tocando el fondo.
    [dlgDetalle, dlgCarrito].forEach((dlg) =>
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dlg.close();
      }),
    );

    pintarMazo();
    raiz.classList.add('lista');
    pintarContadorFavs();
    pintarCuenta();
    if (cliente.tieneCarrito()) cargarCarrito().catch(() => {});
    // /#carrito (p. ej. desde la página de favoritos) abre el carrito.
    if (location.hash === '#carrito') abrirCarrito();
    refrescarCatalogo().catch(() => {
      /* sin conexión con la tienda: quedan los datos de la última compilación */
    });
    // Al volver a la pestaña (p. ej. después de un rato) se vuelve a consultar.
    const alVolver = () => {
      refrescarCatalogo().catch(() => {});
      favoritos = leerFavoritos();
      pintarContadorFavs();
      pintarCuenta();
      if (!ocupado && !inicio) pintarMazo();
      if (cliente.tieneCarrito()) cargarCarrito().catch(() => {});
    };
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') alVolver();
    });
    // Volver con «atrás» desde /favoritos (la página puede salir del caché del navegador).
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) alVolver();
    });
  }
</script>

<style>
  /* App a pantalla completa: barra, mazo (ocupa el alto que sobra), botones y ayuda.
     En pantallas muy bajas (celular acostado) deja de fijar el alto y se puede desplazar. */
