---
// Pie de página SIRA (Figma: «Pie de página» 1440×500).
import { piePara } from '../../data/sira';
import { rutasPara, url } from '../../data/rutas';
import type { Idioma } from '../../i18n/idiomas';

interface Props {
  lang?: Idioma;
}
const { lang = 'es' } = Astro.props;
const pie = piePara(lang);
const rutas = rutasPara(lang);
---
<footer class="pie">
  <div class="pie-cuerpo">
    <div class="marca">
      <a href={rutas.inicio} aria-label={lang === 'en' ? 'SIRA, home' : 'SIRA, inicio'}>
        <img src={url('/img/logo-sira.png')} alt="SIRA" width="156" height="87" loading="lazy" />
      </a>
      <p class="filosofia">{pie.filosofia[0]}<br />{pie.filosofia[1]}</p>
      <p class="instagram">
        <a href={pie.instagram.href} target="_blank" rel="noopener">{pie.instagram.texto}</a>
      </p>
    </div>
    {pie.columnas.map((col) => (
      <nav class="columna" aria-label={col.titulo}>
        <p class="titulo-columna">{col.titulo}</p>
        <ul>
          {col.enlaces.map((e) => (
            <li><a href={e.href}>{e.texto}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="pie-base">
    <p>{pie.copyright}</p>
    <ul>
      {pie.legales.map((e) => (
        <li><a href={e.href}>{e.texto}</a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .pie {
    padding: 62px 80px 47px;
    background: var(--crema);
    color: var(--tinta);
  }
  .pie-cuerpo {
    display: grid;
    grid-template-columns: 480px 260px 290px 250px;
    max-width: 1280px;
    margin: 0 auto;
    min-height: 278px;
  }
  .marca img {
    width: 156px;
    height: 87px;
    margin-left: -8px;
    object-fit: contain;
  }
  .filosofia {
    margin: 16px 0 0;
    font-size: 13px;
    line-height: 22.1px;
  }
  .instagram {
    margin: 64px 0 0;
    font-size: 11px;
    line-height: 18.7px;
  }
  .columna {
    padding-top: 33px;
  }
  .titulo-columna {
    margin: 0;
    font-size: 10px;
    font-weight: 500;
    line-height: 17px;
    text-transform: uppercase;
  }
  .columna ul {
    display: flex;
    flex-direction: column;
    gap: 17px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .pie a {
    color: inherit;
    text-decoration: none;
  }
  .pie a:hover {
    color: var(--oro);
  }
  .columna a {
    font-size: 12px;
    line-height: 20.4px;
  }
  .pie-base {
    display: grid;
    grid-template-columns: 1fr 150px 170px;
    max-width: 1280px;
    margin: 62px auto 0;
    padding-top: 33px;
    border-top: 1px solid rgba(41, 38, 33, 0.2);
    font-size: 10px;
    line-height: 17px;
  }
  .pie-base p {
    margin: 0;
  }
  .pie-base ul {
    display: contents;
    list-style: none;
  }

  @media (max-width: 1180px) {
    .pie-cuerpo {
      grid-template-columns: 1.6fr 1fr 1.1fr 1fr;
      gap: 24px;
    }
  }
  @media (max-width: 860px) {
    .pie {
      padding: 48px 20px 32px;
    }
    .pie-cuerpo {
      grid-template-columns: 1fr 1fr;
      gap: 8px 24px;
    }
    .marca {
      grid-column: 1 / -1;
      margin-bottom: 8px;
    }
    .instagram {
      margin-top: 20px;
    }
    .columna ul {
      gap: 10px;
      margin-top: 16px;
    }
    .pie-base {
      grid-template-columns: 1fr auto auto;
      gap: 16px;
      margin-top: 40px;
      padding-top: 20px;
    }
  }
  @media (max-width: 480px) {
    .pie-cuerpo {
      grid-template-columns: 1fr;
    }
    .pie-base {
      grid-template-columns: 1fr 1fr;
    }
    .pie-base p {
      grid-column: 1 / -1;
    }
  }
</style>
