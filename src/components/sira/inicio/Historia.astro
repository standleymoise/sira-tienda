---
// Nuestra historia (Figma: 147:5167, 1440×1000, fondo #f0ede6): foto 600×750 y textos de la marca
// y de la diseñadora.
import { Image } from 'astro:assets';
import type { Idioma } from '../../../i18n/idiomas';
import { rutasPara } from '../../../data/rutas';
import imgTextiles from '../../../assets/sira/textiles-silueta.png';

const { lang = 'es' } = Astro.props as { lang?: Idioma };
const rutas = rutasPara(lang);
const t = {
  es: {
    alt: 'Textiles y silueta SIRA',
    etiqueta: 'Nuestra historia',
    titulo: ['Diseñar', 'con intención.'],
    parrafo:
      'SIRA nace de la búsqueda de piezas únicas: mezclas inesperadas de textiles nuevos y recuperados, siluetas reversibles y diseño pensado para permanecer. Espíritu costarricense con mirada global.',
    enlace: 'SIRA — Nuestra historia',
    disenadora: 'La diseñadora',
    rol: 'Fundadora y diseñadora',
    bio: 'De su formación inicial en tecnología y la experiencia en pasarela internacional hasta sus estudios en London College of Fashion, Laura Mata da forma a SIRA desde una sensibilidad íntima por los textiles y la expresión personal.',
    origen: 'Desde Costa Rica, con una mirada global.',
  },
  en: {
    alt: 'SIRA textiles and silhouette',
    etiqueta: 'Our story',
    titulo: ['Designing', 'with intention.'],
    parrafo:
      'SIRA was born from a search for unique pieces: unexpected blends of new and reclaimed textiles, reversible silhouettes and design made to last. A Costa Rican spirit with a global outlook.',
    enlace: 'SIRA — Our story',
    disenadora: 'The designer',
    rol: 'Founder & Designer',
    bio: 'From an early background in technology and international runway experience to her studies at London College of Fashion, Laura Mata shapes SIRA through an intimate sensitivity to textiles and personal expression.',
    origen: 'From Costa Rica, with a global outlook.',
  },
}[lang];
---
<section class="historia" aria-labelledby="historia-titulo">
  <div class="contenedor rejilla">
    <div class="foto">
      <Image
        src={imgTextiles}
        alt={t.alt}
        format="webp"
        widths={[420, 600, 900, 1200]}
        sizes="(max-width: 860px) calc(100vw - 40px), 42vw"
        loading="lazy"
      />
    </div>
    <div class="textos">
      <p class="etiqueta">{t.etiqueta}</p>
      <h2 id="historia-titulo" class="titulo serif">{t.titulo[0]}<br />{t.titulo[1]}</h2>
      <p class="parrafo">{t.parrafo}</p>
      <a class="enlace" href={rutas.nosotros}>{t.enlace}<span aria-hidden="true">↗</span></a>
      <p class="etiqueta disenadora">{t.disenadora}</p>
      <h3 class="nombre serif">Laura Mata</h3>
      <p class="rol serif">{t.rol}</p>
      <p class="parrafo bio">{t.bio}</p>
    </div>
    <p class="etiqueta origen">{t.origen}</p>
  </div>
</section>

<style>
  .historia {
    padding: 120px 0 89px;
    background: var(--piedra);
  }
  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 600fr) minmax(0, 560fr);
    column-gap: clamp(40px, 8.33vw, 120px);
  }
  .foto {
    aspect-ratio: 600 / 750;
    overflow: hidden;
    background: var(--arena);
  }
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .textos {
    max-width: 540px;
  }
  .titulo {
    margin: 33px 0 0 -4px;
    font-size: clamp(42px, 4.58vw, 66px);
    line-height: 1.1;
  }
  .parrafo {
    max-width: 480px;
    margin: 37px 0 0;
    font-size: 14px;
    line-height: 23.8px;
  }
  .enlace {
    display: block;
    max-width: 480px;
    margin-top: 83px;
    padding-bottom: 34px;
    border-bottom: 1px solid var(--linea-tinta);
    font-size: 12px;
    font-weight: 500;
    line-height: 20.4px;
    text-decoration: none;
    color: var(--tinta);
  }
  .enlace span {
    margin-left: 1.6em;
  }
  .enlace:hover {
    color: var(--oro);
  }
  .disenadora {
    margin-top: 39px;
  }
  .nombre {
    margin: 22px 0 0 -2px;
    font-size: clamp(32px, 2.64vw, 38px);
    line-height: 1.1;
  }
  .rol {
    margin: 9px 0 0;
    font-size: 19px;
    font-style: italic;
    line-height: 1.1;
  }
  .bio {
    margin-top: 32px;
  }
  .origen {
    margin-top: 34px;
    font-weight: 400;
  }

  @media (max-width: 860px) {
    .historia {
      padding: 64px 0 56px;
    }
    .rejilla {
      grid-template-columns: 1fr;
    }
    .origen {
      grid-row: 2;
      margin: 16px 0 40px;
    }
    .titulo {
      margin-top: 20px;
    }
    .parrafo {
      margin-top: 24px;
    }
    .enlace {
      margin-top: 36px;
      padding-bottom: 20px;
    }
  }
</style>
