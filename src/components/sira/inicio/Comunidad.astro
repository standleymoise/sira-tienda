---
// Comunidad / boletín (Figma: 147:5195, 1440×360, fondo #ebe7dd).
// Todavía no hay servicio de boletín: el formulario solo revisa el correo y muestra un aviso.
// No guarda ni envía nada. Cuando exista el servicio (Mailchimp, Brevo, MailPoet…), conectarlo aquí.
import type { Idioma } from '../../../i18n/idiomas';
import { piePara } from '../../../data/sira';

const { lang = 'es' } = Astro.props as { lang?: Idioma };
const pie = piePara(lang);
const t = {
  es: {
    etiqueta: 'En el mundo de SIRA',
    titulo: 'Lo esencial, de cerca.',
    parrafo: ['Nuevas piezas, colecciones e historias del atelier.', 'Sin ruido, solo lo esencial.'],
    correo: 'Tu correo electrónico',
    boton: 'Suscribirme',
    aviso: 'Al suscribirte, aceptas nuestra política de privacidad.',
    gracias: 'Gracias. Muy pronto activaremos el boletín; mientras tanto, síganos en',
  },
  en: {
    etiqueta: 'In the world of SIRA',
    titulo: 'The essentials, up close.',
    parrafo: ['New pieces, collections and stories from the atelier.', 'No noise, just the essentials.'],
    correo: 'Your email address',
    boton: 'Subscribe',
    aviso: 'By subscribing, you agree to our privacy policy.',
    gracias: 'Thank you. Our newsletter is launching soon; in the meantime, follow us on',
  },
}[lang];

// Mensajes del script del navegador (errores del correo).
const tScript = {
  es: {
    revisar: 'Revise el correo: parece que le falta algo.',
    vacio: 'Escriba su correo electrónico.',
  },
  en: {
    revisar: 'Please check your email address; something seems to be missing.',
    vacio: 'Please enter your email address.',
  },
}[lang];
---
<section class="comunidad" aria-labelledby="comunidad-titulo">
  <div class="contenedor rejilla">
    <div class="textos">
      <p class="etiqueta">{t.etiqueta}</p>
      <h2 id="comunidad-titulo" class="titulo serif">{t.titulo}</h2>
      <p class="parrafo">{t.parrafo[0]}<br />{t.parrafo[1]}</p>
    </div>
    <div class="formulario" data-textos={JSON.stringify(tScript)}>
      <form class="campo" data-boletin novalidate>
        <label class="sr-only" for="boletin-correo">{t.correo}</label>
        <input
          id="boletin-correo"
          name="correo"
          type="email"
          autocomplete="email"
          inputmode="email"
          placeholder={t.correo}
          required
          aria-describedby="boletin-aviso"
        />
        <button type="submit">{t.boton}<span aria-hidden="true">↗</span></button>
      </form>
      <p id="boletin-aviso" class="aviso" data-aviso aria-live="polite">
        {t.aviso}
      </p>
      <p class="gracias" data-gracias hidden>
        {t.gracias}{' '}<a href={pie.instagram.href} target="_blank" rel="noopener">Instagram</a>.
      </p>
    </div>
  </div>
</section>

<script>
  // Sin servicio de correo todavía: se valida el correo y se muestra el aviso. No se envía nada.
  document.querySelectorAll<HTMLFormElement>('[data-boletin]').forEach((form) => {
    const caja = form.closest<HTMLElement>('.formulario')!;
    const textos = JSON.parse(caja.dataset.textos || '{}') as { revisar: string; vacio: string };
    const input = form.querySelector('input')!;
    const aviso = caja.querySelector<HTMLElement>('[data-aviso]')!;
    const gracias = caja.querySelector<HTMLElement>('[data-gracias]')!;
    const textoAviso = aviso.textContent!.trim();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const correo = input.value.trim();
      const valido = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(correo);
      if (!valido) {
        input.setAttribute('aria-invalid', 'true');
        aviso.classList.add('error');
        aviso.textContent = correo ? textos.revisar : textos.vacio;
        input.focus();
        return;
      }
      input.removeAttribute('aria-invalid');
      aviso.classList.remove('error');
      aviso.textContent = textoAviso;
      form.reset();
      form.hidden = true;
      aviso.hidden = true;
      gracias.hidden = false;
      gracias.setAttribute('tabindex', '-1');
      gracias.focus();
    });
    input.addEventListener('input', () => {
      if (input.getAttribute('aria-invalid')) {
        input.removeAttribute('aria-invalid');
        aviso.classList.remove('error');
        aviso.textContent = textoAviso;
      }
    });
  });
</script>

<style>
  .comunidad {
    padding: 78px 0 100px;
    background: var(--lino);
  }
  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 690fr) minmax(0, 510fr);
    column-gap: clamp(32px, 5.56vw, 80px);
  }
  .titulo {
    margin: 30px 0 0 -2px;
    font-size: clamp(36px, 3.75vw, 54px);
    line-height: 1.1;
  }
  .parrafo {
    margin: 28px 0 0;
    font-size: 14px;
    line-height: 23.8px;
  }
  .formulario {
    padding-top: 85px;
  }
  .campo {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 19px;
    border-bottom: 1px solid rgba(41, 38, 33, 0.2);
  }
  .campo:focus-within {
    border-bottom-color: var(--tinta);
  }
  input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 13px;
    line-height: 22px;
    color: var(--tinta);
  }
  input::placeholder {
    color: var(--tinta);
    opacity: 1;
  }
  input:focus {
    outline: none;
  }
  button {
    flex: none;
    margin-right: clamp(0px, 1.4vw, 20px);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    line-height: 20.4px;
    color: var(--tinta);
    cursor: pointer;
  }
  button span {
    margin-left: 1.6em;
  }
  button:hover {
    color: var(--oro);
  }
  .aviso {
    margin: 25px 0 0;
    font-size: 10px;
    line-height: 17px;
  }
  .aviso.error {
    color: #9b2c1f;
  }
  .gracias {
    margin: 0;
    font-family: var(--font-alt);
    font-size: 22px;
    line-height: 1.3;
  }
  .gracias:focus {
    outline: none;
  }
  .gracias a {
    color: inherit;
  }

  @media (max-width: 860px) {
    .comunidad {
      padding: 64px 0;
    }
    .rejilla {
      grid-template-columns: 1fr;
    }
    .formulario {
      padding-top: 40px;
    }
  }
</style>
