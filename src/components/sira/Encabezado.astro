---
// Encabezado SIRA (Figma: «Encabezado» 1440×144 y «Menú novedades»).
// Escritorio: idioma · logo · íconos, menú centrado y desplegable editorial con fondo oscurecido.
// Móvil: menú lateral con los mismos enlaces.
import { Image } from 'astro:assets';
import { menu, type IdMenu } from '../../data/sira';
import { rutas, url } from '../../data/rutas';
import { storeApiUrl } from '../../data/tienda';

interface Props {
  /** Sección activa del menú (se marca en dorado). */
  activo?: IdMenu;
}
const { activo } = Astro.props;
---
<header class="encabezado" data-encabezado data-api={storeApiUrl}>
  <div class="fila-superior">
    <button class="btn-menu-movil" type="button" data-abrir-menu aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" /></svg>
    </button>
    <p class="idioma" aria-label="Idioma: español">
      <span class="activo">ES</span><span class="sep" aria-hidden="true">|</span><span class="otro" title="Versión en inglés: próximamente">EN</span>
    </p>
    <a class="logo" href={rutas.inicio} aria-label="SIRA, inicio">
      <img src={url('/img/logo-sira.png')} alt="SIRA" width="109" height="60" />
    </a>
    <div class="iconos">
      <button class="icono" type="button" data-abrir-busqueda aria-label="Buscar" aria-expanded="false" aria-controls="busqueda">
        <img src={url('/img/icono-buscar.svg')} alt="" width="19" height="19" />
      </button>
      <a class="icono solo-escritorio" href={rutas.cuenta} aria-label="Mi cuenta">
        <img src={url('/img/icono-cuenta.svg')} alt="" width="19" height="19" />
      </a>
      <a class="icono solo-escritorio" href={rutas.favoritos} aria-label="Favoritos">
        <img src={url('/img/icono-favoritos.svg')} alt="" width="19" height="19" />
      </a>
      <a class="icono carrito" href={rutas.carrito} aria-label="Carrito">
        <img src={url('/img/icono-carrito.svg')} alt="" width="19" height="19" />
        <span class="contador" data-contador-carrito aria-live="polite">0</span>
      </a>
    </div>
  </div>

  <nav class="navegacion" aria-label="Principal">
    <ul>
      {menu.map((m) => (
        <li class:list={['item', { 'con-panel': 'panel' in m }]} data-item={m.id}>
          <a
            href={m.href}
            class:list={{ activo: m.id === activo }}
            aria-current={m.id === activo ? 'page' : undefined}
            aria-haspopup={'panel' in m ? 'true' : undefined}
            aria-expanded={'panel' in m ? 'false' : undefined}
            data-enlace-menu={m.id}
          >
            {m.texto}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="separador" aria-hidden="true"></div>

  {/* Desplegables editoriales (uno por sección con panel) */}
  {menu.map((m) =>
    'panel' in m ? (
      <div class="panel" data-panel={m.id} hidden>
        <div class="panel-cuerpo">
          <button class="cerrar" type="button" data-cerrar-panel>Cerrar ×</button>
          <div class="panel-titulo">
            <p class="indice">{m.panel.indice}</p>
            <p class="titulo serif">{m.panel.titulo}</p>
            <p class="descripcion">{m.panel.descripcion}</p>
          </div>
          <ul class="panel-enlaces">
            {m.panel.enlaces.map((e) => (
              <li>
                <a class="serif" href={e.href}>{e.texto}</a>
              </li>
            ))}
          </ul>
          <figure class="panel-imagen">
            <Image src={m.panel.imagen} alt={m.panel.imagenAlt} width={572} height={700} format="webp" loading="lazy" />
            <figcaption>{m.panel.firma}</figcaption>
          </figure>
        </div>
      </div>
    ) : null,
  )}
  <div class="velo" data-velo hidden></div>

  {/* Búsqueda: lleva a la tienda filtrada (?q=) */}
  <div class="busqueda" id="busqueda" data-busqueda hidden>
    <form class="busqueda-form" action={rutas.productos} method="get" role="search">
      <label class="sr-only" for="busqueda-q">Buscar piezas</label>
      <input id="busqueda-q" name="q" type="search" placeholder="Buscar piezas" autocomplete="off" />
      <button type="submit" class="busqueda-ir">Buscar ↗</button>
      <button type="button" class="cerrar" data-cerrar-busqueda>Cerrar ×</button>
    </form>
  </div>

  {/* Menú del celular */}
  <div class="menu-movil" id="menu-movil" data-menu-movil hidden>
    <div class="menu-movil-cabecera">
      <img src={url('/img/logo-sira.png')} alt="SIRA" width="80" height="44" />
      <button class="cerrar" type="button" data-cerrar-menu>Cerrar ×</button>
    </div>
    <ul class="menu-movil-lista">
      {menu.map((m) => (
        <li>
          <a class:list={['serif', { activo: m.id === activo }]} href={m.href}>{m.texto}</a>
          {'panel' in m && (
            <ul>
              {m.panel.enlaces.map((e) => (
                <li><a href={e.href}>{e.texto}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <ul class="menu-movil-cuenta">
      <li><a href={rutas.cuenta}>Mi cuenta</a></li>
      <li><a href={rutas.favoritos}>Favoritos</a></li>
      <li><a href={rutas.carrito}>Carrito</a></li>
    </ul>
  </div>
</header>

<script>
  import { crearCliente } from '../../scripts/tienda-api';

  const enc = document.querySelector<HTMLElement>('[data-encabezado]');
  if (enc) {
    const velo = enc.querySelector<HTMLElement>('[data-velo]')!;
    const paneles = [...enc.querySelectorAll<HTMLElement>('[data-panel]')];
    const enlaces = [...enc.querySelectorAll<HTMLAnchorElement>('[data-enlace-menu]')];
    let abierto: string | null = null;
    let espera = 0;
    const escritorio = matchMedia('(min-width: 1024px)');

    const mostrar = (id: string | null) => {
      abierto = id;
      paneles.forEach((p) => (p.hidden = p.dataset.panel !== id));
      enlaces.forEach((a) => {
        if (a.hasAttribute('aria-expanded')) a.setAttribute('aria-expanded', String(a.dataset.enlaceMenu === id));
        a.classList.toggle('abierto', a.dataset.enlaceMenu === id);
      });
      velo.hidden = !id;
      enc.classList.toggle('con-panel-abierto', !!id);
    };

    enlaces.forEach((a) => {
      const id = a.dataset.enlaceMenu!;
      const tienePanel = paneles.some((p) => p.dataset.panel === id);
      if (!tienePanel) {
        a.addEventListener('mouseenter', () => escritorio.matches && mostrar(null));
        return;
      }
      a.addEventListener('mouseenter', () => {
        if (!escritorio.matches) return;
        clearTimeout(espera);
        espera = window.setTimeout(() => mostrar(id), 120);
      });
      // Teclado o toque: el primer clic abre el panel; el segundo sigue el enlace.
      a.addEventListener('click', (e) => {
        if (!escritorio.matches) return;
        if (abierto !== id) {
          e.preventDefault();
          mostrar(id);
        }
      });
    });
    enc.addEventListener('mouseleave', () => {
      clearTimeout(espera);
      espera = window.setTimeout(() => mostrar(null), 200);
    });
    enc.addEventListener('mouseenter', () => clearTimeout(espera));
    velo.addEventListener('click', () => mostrar(null));
    enc.querySelectorAll('[data-cerrar-panel]').forEach((b) => b.addEventListener('click', () => mostrar(null)));

    // Búsqueda
    const busqueda = enc.querySelector<HTMLElement>('[data-busqueda]')!;
    const btnBusqueda = enc.querySelector<HTMLButtonElement>('[data-abrir-busqueda]')!;
    const abrirBusqueda = (si: boolean) => {
      busqueda.hidden = !si;
      btnBusqueda.setAttribute('aria-expanded', String(si));
      if (si) {
        mostrar(null);
        busqueda.querySelector('input')!.focus();
      }
    };
    // En la tienda, el buscador ya trae lo que se buscó (?q=).
    const q = new URLSearchParams(location.search).get('q');
    if (q) busqueda.querySelector('input')!.value = q;
    btnBusqueda.addEventListener('click', () => abrirBusqueda(busqueda.hidden));
    enc.querySelector('[data-cerrar-busqueda]')!.addEventListener('click', () => abrirBusqueda(false));

    // Menú del celular
    const menuMovil = enc.querySelector<HTMLElement>('[data-menu-movil]')!;
    const btnMenu = enc.querySelector<HTMLButtonElement>('[data-abrir-menu]')!;
    const abrirMenu = (si: boolean) => {
      menuMovil.hidden = !si;
      btnMenu.setAttribute('aria-expanded', String(si));
      document.documentElement.classList.toggle('sin-scroll', si);
      if (si) menuMovil.querySelector<HTMLElement>('a, button')?.focus();
    };
    btnMenu.addEventListener('click', () => abrirMenu(true));
    enc.querySelector('[data-cerrar-menu]')!.addEventListener('click', () => abrirMenu(false));

    addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      mostrar(null);
      abrirBusqueda(false);
      if (!menuMovil.hidden) abrirMenu(false);
    });

    // Contador del carrito (solo si ya hay un carrito; no crea uno nuevo).
    const contador = enc.querySelector<HTMLElement>('[data-contador-carrito]')!;
    const pintar = (n: number) => (contador.textContent = String(n));
    addEventListener('sira:carrito', (e) => pintar((e as CustomEvent<number>).detail));
    const API = enc.dataset.api;
    if (API) {
      const cliente = crearCliente(API);
      if (cliente.tieneCarrito()) cliente.carrito().then((c) => pintar(c.items_count)).catch(() => {});
    }
  }
</script>

<style>
  .encabezado {
    position: relative;
    z-index: 50;
    background: var(--crema);
  }
  .fila-superior {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    height: 88px;
    padding-inline: 64px;
  }
  .idioma {
    grid-column: 1;
    display: flex;
    gap: 0;
    margin: 32px 0 0;
    font-size: 11px;
    line-height: 1.6;
    color: var(--tinta);
  }
  .idioma .activo {
    font-weight: 500;
    width: 34px;
  }
  .idioma .sep {
    width: 17px;
  }
  .idioma .otro {
    color: var(--gris-claro);
  }
  .logo {
    grid-column: 2;
    display: block;
    margin-top: 14px;
  }
  .logo img {
    width: 109px;
    height: 60px;
    object-fit: contain;
  }
  .iconos {
    grid-column: 3;
    justify-self: end;
    display: flex;
    gap: 16px;
    margin-top: 29px;
    margin-right: 20px;
  }
  .icono {
    display: flex;
    align-items: center;
    gap: 4.48px;
    padding: 4.48px;
    border: 0;
    background: none;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .icono img {
    width: 19.04px;
    height: 19.04px;
  }
  .contador {
    min-width: 8px;
    font-size: 11.2px;
    font-weight: 500;
    line-height: 16.8px;
    letter-spacing: 0.56px;
    text-align: center;
    color: var(--tinta-fuerte);
  }
  .btn-menu-movil {
    display: none;
  }

  .navegacion ul {
    display: flex;
    justify-content: center;
    gap: 40px;
    height: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .navegacion a {
    display: block;
    padding: 14px 4px;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 1.1px;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--tinta);
    transition: color 0.2s;
  }
  .navegacion a:hover,
  .navegacion a.abierto,
  .navegacion a.activo {
    color: var(--oro-claro);
    font-weight: 600;
  }
  .separador {
    height: 1px;
    margin: 7px 64px 0;
    background: var(--linea-tinta);
  }

  /* ---------- desplegable editorial ---------- */
  .panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 2;
    background: var(--crema);
  }
  .panel[hidden],
  .velo[hidden],
  .busqueda[hidden],
  .menu-movil[hidden] {
    display: none;
  }
  .panel-cuerpo {
    position: relative;
    display: grid;
    grid-template-columns: 430px 1fr 286px;
    gap: 0 0;
    min-height: 467px;
    padding: 22px 87px 44px 73px;
  }
  .panel .cerrar {
    position: absolute;
    top: -27px;
    right: 47px;
  }
  .cerrar {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 11px;
    line-height: 1.6;
    color: var(--tinta);
    cursor: pointer;
  }
  .indice {
    margin: 0;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.6;
  }
  .titulo {
    margin: 23px 0 0 -3px;
    font-size: 60px;
    line-height: 69px;
    color: var(--tinta);
  }
  .descripcion {
    margin: 20px 0 0;
    max-width: 330px;
    font-size: 14px;
    line-height: 22.4px;
  }
  .panel-enlaces {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: 5px 0 0;
    padding: 0;
    list-style: none;
  }
  .panel-enlaces a {
    font-size: 25px;
    line-height: 28.8px;
    color: var(--tinta);
    text-decoration: none;
  }
  .panel-enlaces a:hover {
    color: var(--oro);
  }
  .panel-imagen {
    margin: 9px 0 0;
  }
  .panel-imagen img {
    width: 286px;
    height: 350px;
    object-fit: cover;
  }
  .panel-imagen figcaption {
    margin-top: 23px;
    font-size: 9px;
    line-height: 14.4px;
    text-transform: uppercase;
  }
  /* Fondo oscurecido debajo del encabezado mientras el desplegable está abierto */
  .velo {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 1;
    height: 100vh;
    background: rgba(28, 26, 24, 0.82);
  }

  /* ---------- búsqueda ---------- */
  .busqueda {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 3;
    padding: 28px 64px;
    background: var(--crema);
    border-bottom: 1px solid var(--linea-tinta);
  }
  .busqueda-form {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: 1312px;
    margin: 0 auto;
  }
  .busqueda input {
    flex: 1;
    min-width: 0;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid var(--linea-tinta);
    background: none;
    font-family: var(--font-alt);
    font-size: 30px;
    color: var(--tinta);
  }
  .busqueda input:focus {
    outline: none;
    border-color: var(--tinta);
  }
  .busqueda-ir {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    color: var(--tinta);
    cursor: pointer;
  }

  /* ---------- menú del celular ---------- */
  .menu-movil {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow-y: auto;
    padding: 18px 20px 40px;
    background: var(--crema);
  }
  .menu-movil-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu-movil-cabecera img {
    width: 80px;
    height: 44px;
    object-fit: contain;
  }
  .menu-movil-lista {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .menu-movil-lista > li {
    padding: 14px 0;
    border-bottom: 1px solid var(--linea-tinta);
  }
  .menu-movil-lista > li > a {
    font-size: 32px;
    line-height: 1.15;
    text-decoration: none;
    color: var(--tinta);
  }
  .menu-movil-lista > li > a.activo {
    color: var(--oro);
  }
  .menu-movil-lista ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .menu-movil-lista ul a,
  .menu-movil-cuenta a {
    font-size: 12px;
    line-height: 1.7;
    color: var(--gris);
  }
  .menu-movil-cuenta {
    display: flex;
    gap: 20px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1180px) and (min-width: 1024px) {
    .panel-cuerpo {
      grid-template-columns: 340px 1fr 240px;
      padding-inline: 48px;
    }
    .panel-imagen img {
      width: 240px;
      height: 294px;
    }
  }

  @media (max-width: 1023px) {
    .fila-superior {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      height: 64px;
      padding-inline: 12px;
    }
    .btn-menu-movil {
      grid-column: 1;
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .btn-menu-movil svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: var(--tinta-fuerte);
      stroke-width: 1.3;
    }
    .idioma,
    .navegacion,
    .solo-escritorio,
    .panel,
    .velo {
      display: none !important;
    }
    .logo {
      justify-self: center;
      margin: 0;
    }
    .logo img {
      width: 80px;
      height: 44px;
    }
    .iconos {
      gap: 4px;
      margin: 0;
    }
    .separador {
      margin-inline: 0;
    }
    .busqueda {
      padding: 20px;
    }
    .busqueda-form {
      flex-wrap: wrap;
      gap: 12px 20px;
    }
    .busqueda input {
      flex-basis: 100%;
      font-size: 24px;
    }
  }
</style>

<style is:global>
  html.sin-scroll {
    overflow: hidden;
  }
</style>
